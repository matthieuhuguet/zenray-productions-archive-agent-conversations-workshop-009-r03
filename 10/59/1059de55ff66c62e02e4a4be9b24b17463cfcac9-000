stence du repo PUBLIC zenray-media-public (private:false, auto_init), prêt à recevoir des\n    55\t// commits Git Data API (sa branche main doit porter au moins un commit). Idempotent : 422 = déjà créé.\n    56\tasync function ensurePublicRepo(token, name, log = noop) {\n    57\t  const probeRepo = await gh(token, `repos/${OWNER}/${name}`)\n    58\t  if (probeRepo.ok) return true\n    59\t  log(`  repo public ${OWNER}/${name} absent -> création...`)\n    60\t  const cr = await gh(token, 'user/repos', {\n    61\t    method: 'POST',\n    62\t    body: JSON.stringify({ name, private: false, auto_init: true, description: 'ZenRay media — segments HLS CHIFFRÉS (AES-128), servis via jsDelivr. Clés AES jamais ici (repo privé).' }),\n    63\t  })\n    64\t  if (!cr.ok && cr.status !== 422) throw new Error(`create public repo -> ${cr.status} ${(await cr.text()).slice(0, 200)}`)\n    65\t  // auto_init crée la branche main de façon asynchrone : on attend qu'elle porte un commit.\n    66\t  for (let i = 0; i < 12; i++) {\n    67\t    const rr = await gh(token, `repos/${OWNER}/${name}/git/ref/heads/main`)\n    68\t    if (rr.ok) return true\n    69\t    await sleep(1500)\n    70\t  }\n    71\t  throw new Error(`public repo ${name} pas prêt (branche main absente après attente)`)\n    72\t}\n    73\tconst HLS_TIME = 4 // secondes par segment (≈1-2 Mo à CRF 21 1080p, sous la limite confortable d'un blob GitHub)\n    74\t// Placeholder d'URI de clé écrit par ffmpeg dans les EXT-X-KEY au moment de l'encodage. On le réécrit\n    75\t// ensuite (dans pushHls) vers l'URL réelle /api/hls-key?v=<base> une fois le base name connu/encodé.\n    76\tconst KEY_URI_PLACEHOLDER = 'ZR_HLS_KEY_URI'\n    77\t// Nom du fichier clé dans le repo PRIVÉ (doit matcher server/hls-key.js KEY_FILE).\n    78\tconst KEY_FILE = '.hlskey.bin'\n    79\t\n    80\t// --- chemin shard profond ab/cd/<hash>.<ext> (jumeau de shardPathFor de universalCapture.js) -----\n    81\tfunction shardPathFor(hash, ext) {\n    82\t  return `${hash.slice(0, 2)}/${hash.slice(2, 4)}/${hash}.${ext}`\n    83\t}\n    84\t\n    85\t// --- TRANSCODE COMPLET D'UNE VIDÉO EN HLS -----------------------------------\n    86\t// Produit en local master.m3u8 + stream_*.m3u8 + init_*.mp4 + seg_*.m4s + sub_*.vtt, SANS rien pousser.\n    87\t// Renvoie l'objet `result` que pushHls() consomme. Options :\n    88\t//   { workDir, crf='21', sampleSec=null, log, onProgress(stage, pct) }\n    89\texport async function transcodeHls(file, opts = {}) {\n    90\t  const log = opts.log || noop\n    91\t  const onProgress = opts.onProgress || noop\n    92\t  const crf = String(opts.crf || '21')\n    93\t  const sampleSec = opts.sampleSec != null ? Number(opts.sampleSec) : null\n    94\t  const work = opts.workDir || '/tmp/zr_hls'\n    95\t\n    96\t  const base = path.basename(file).replace(/\\.[^.]+$/, '')\n    97\t  const id = newId()\n    98\t  const outDir = path.join(work, 'out', id)\n    99\t  await mkdir(outDir, { recursive: true })\n   100\t\n   101\t  const p = probe(file)\n   102\t  log(`${base} — ${p.duration.toFixed(0)}s, ${p.audio.length} audio, ${p.subs.length} sous-titres${sampleSec ? ` [échantillon ${sampleSec}s]` : ''}`)\n   103\t  if (!p.video.length) throw new Error('aucune piste vidéo')\n   104\t\n   105\t  const tlim = sampleSec ? ['-t', String(sampleSec)] : []\n   106\t  const outDuration = sampleSec ? Math.min(p.duration || sampleSec, sampleSec) : p.duration\n   107\t  const nAudio = p.audio.length\n   108\t\n   109\t  // 0) CHIFFREMENT AES-128 : on génère une clé aléatoire 16 octets + un IV 16 octets PROPRES à cette vidéo.\n   110\t  //    ffmpeg chiffre TOUS les segments avec cette clé (HLS EXT-X-KEY METHOD=AES-128). Le « key info file »\n   111\t  //    est un fichier texte 3 lignes que ffmpeg lit :\n   112\t  //      ligne 1 = l'URI écrite TELLE QUELLE dans la playlist (on met un placeholder, réécrit ensuite) ;\n   113\t  //      ligne 2 = le CHEMIN LOCAL du fichier de clé (ffmpeg le lit pour 