  if (!all.includes('master.m3u8')) throw new Error('ffmpeg HLS: master.m3u8 absent')\n   175\t  log(`  produit: master.m3u8 + ${mediaPlaylists.length} media playlists, ${segments.length} segments chiffrés`)\n   176\t\n   177\t  // métadonnées audio (info UI ; la vérité opérationnelle reste hls.audioTracks côté lecteur)\n   178\t  const audioMeta = p.audio.map((a, i) => {\n   179\t    const lang = a.tags?.language || 'und'\n   180\t    return { lang, label: (a.tags?.title) || LANG_LABEL[lang] || lang, default: i === 0 }\n   181\t  })\n   182\t  const subMeta = subsRaw.map((s) => ({ lang: s.lang, label: s.label }))\n   183\t\n   184\t  return {\n   185\t    id, base, outDir, outDuration, nAudio,\n   186\t    segments, inits, mediaPlaylists, subsRaw,\n   187\t    audioMeta, subMeta,\n   188\t    aesKey, aesIv, // clé AES-128 (16 octets) + IV : poussés dans le repo PRIVÉ par pushHls\n   189\t    dest: opts.dest || 'pages/Videos',\n   190\t  }\n   191\t}\n   192\t\n   193\t// --- RÉÉCRITURE des playlists -------------------------------------------------\n   194\t// Une media playlist (stream_N.m3u8) liste des segments par nom local + un EXT-X-MAP:URI=\"init_N.mp4\".\n   195\t// On remplace chaque référence locale par l'URL ABSOLUE de son hash sur le shard. `map` = { nomLocal -> url }.\n   196\tfunction rewriteMediaPlaylist(text, map, keyUri) {\n   197\t  return text.split('\\n').map((line) => {\n   198\t    // EXT-X-KEY:METHOD=AES-128,URI=\"ZR_HLS_KEY_URI\",IV=0x...  -> pointer l'URI vers /api/hls-key gated\n   199\t    if (line.startsWith('#EXT-X-KEY') && keyUri) {\n   200\t      return line.replace(/URI=\"([^\"]*)\"/, `URI=\"${keyUri}\"`)\n   201\t    }\n   202\t    // EXT-X-MAP:URI=\"init_0.mp4\" -> remplacer l'URI par l'URL CDN\n   203\t    const mm = /^#EXT-X-MAP:URI=\"([^\"]+)\"(.*)$/.exec(line)\n   204\t    if (mm) {\n   205\t      const url = map[mm[1].trim()]\n   206\t      return url ? `#EXT-X-MAP:URI=\"${url}\"${mm[2]}` : line\n   207\t    }\n   208\t    // l