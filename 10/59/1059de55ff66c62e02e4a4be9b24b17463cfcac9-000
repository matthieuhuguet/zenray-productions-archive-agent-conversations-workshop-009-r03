            </>\n   106\t          )\n   107\t          const style = { textAlign: 'left', textDecoration: 'none', color: 'inherit', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, overflow: 'hidden', boxShadow: SHADOWS.sm, display: 'block', cursor: 'pointer', padding: 0, transition: TRANSITIONS.base, width: '100%' }\n   108\t          return p.href\n   109\t            ? <a key={p.id} href={p.href} target=\"_blank\" rel=\"noreferrer\" style={style}>{inner}</a>\n   110\t            : <button key={p.id} onClick={() => open(p)} style={style}>{inner}</button>\n   111\t        })}\n   112\t      </div>\n   113\t    )\n   114\t  }\n   115\t  return (\n   116\t    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(240px,1fr))', gap: 14, marginTop: 14 }}>\n   117\t      {items.map((p) => {\n   118\t        const inner = (\n   119\t          <>\n   120\t            <div style={{ aspectRatio: '16/10', background: p.color || t.bg, overflow: 'hidden' }}>\n   121\t              <MediaThumb url={p.image} imgPath={p.imgPath} alt={p.title} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />\n   122\t            </div>\n   123\t            <div style={{ padding: '12px 14px' }}>\n   124\t              {p.subtitle && <div style={{ fontFamily: FONTS.mono, fontSize: 10, color: PALETTE.primary, textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 4 }}>{p.subtitle}</div>}\n   125\t              <div style={{ fontFamily: FONTS.serif, fontWeight: 600, fontSize: 14.5, lineHeight: 1.3, display: 'inline-flex', alignItems: 'center', gap: 5 }}>{p.title}{p.external && <Icon name=\"arrow.up.right\" size={12.5} weight={1.7} color={t.textSecondary} />}</div>\n   126\t            </div>\n   127\t          </>\n   128\t        )\n   129\t        const style = { textAlign: 'left', textDecoration: 'none', color: 'inherit', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, overflow: 'hidden', boxShadow: SHADOWS.sm, display: 'block', cursor: 'pointer', padding: 0, transition: TRANSITIONS.base }\n   130\t        return p.href\n   131\t          ? <a key={p.id} href={p.href} target=\"_blank\" rel=\"noreferrer\" style={style}>{inner}</a>\n   132\t          : <button key={p.id} onClick={() => open(p)} style={style}>{inner}</button>\n   133\t      })}\n   134\t    </div>\n   135\t  )\n   136\t}\n"}}
