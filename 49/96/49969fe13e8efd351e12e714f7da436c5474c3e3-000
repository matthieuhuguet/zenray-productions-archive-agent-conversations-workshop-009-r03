tion\": \"unknown\" | \"low\" | \"medium\" | \"high\",\n  \"outcome\": \"allow\" | \"deny\",\n  \"rationale\": string\n}\n"},"history_mode":"paginated","subagent_history_start_ordinal":785,"multi_agent_version":"disabled","context_window":{"window_id":"019f7718-df54-7273-b23e-7c7c9cb54785"},"git":{"commit_hash":"ce2402b4f6a619e541e7888342ab77752e05e79f","branch":"main","repository_url":"https://github.com/matthieuhuguet/Memory.git"}}}
