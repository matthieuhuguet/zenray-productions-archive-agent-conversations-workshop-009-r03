 sans conflit (on part du sha/données connus).\n\nexport async function readJson(path) {\n  const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n  if (!r || r.missing || r.markdown == null) return { sha: null, data: null, missing: !!(r && r.missing) }\n  let data = null; try { data = JSON.parse(r.markdown) } catch {}\n  return { sha: r.sha || null, data }\n}\n\n// Sauvegarde `mutate` appliqué à l'état courant. opts.sha/opts.data = état déjà connu de l'appelant (évite une\n// lecture). Renvoie { ok, sha, data } ou { ok:false, error }. JAMAIS d'écrasement aveugle : sur conflit, on\n// ré-applique mutate sur le contenu frais renvoyé par le serveur, puis on retente (jusqu'à `tries`).\nexport async function saveJsonWithRetry(path, mutate, opts = {}) {\n  let sha = opts.sha ?? null\n  let cur = opts.data ?? null\n  const tries = opts.tries || 5\n  for (let i = 0; i < tries; i++) {\n    if (cur === null && sha === null && i === 0) { const r0 = await readJson(path); sha = r0.sha; cur = r0.data }\n    const next = mutate(cur || {})\n    // keepalive : best-effort pour que le commit survive a un refresh/navigation en plein vol (limite ~64 Ko de\n    // body ; au-dela le navigateur l'ignore, mais le write-through localStorage cote Shelf garantit deja le filet).\n    const body = JSON.stringify({ action: 'save', path, markdown: JSON.stringify(next), sha })\n    const j = await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body, keepalive: body.length < 60000 }).then((r) => r.json()).catch(() => null)\n    if (j && j.ok) return { ok: true, sha: j.sha, data: next }\n    if (j && j.conflict) { sha = j.sha || null; if (j.markdown != null) { try { cur = JSON.parse(j.markdown) } catch {} } else { const r0 = await readJson(path); sha = r0.sha; cur = r0.data } continue }\n    return { ok: false, error: (j && (j.error || j.detail)) || 'save-failed' }\n  }\n  return { ok: false, error: 'conflict-max-retries' }\n}\nimport React, { createContext, useContext, useRef, useState, useEffect, useCallback } from 'react'\n\n// C52 — bus de presse-papiers universel. Un seul listener paste/copy au niveau window, délégué à la cible ACTIVE.\n// La cible active = l'écran courant (onglet) ou un overlay (CardPanel). Chaque écran register({onPasteImage, onCopy}).\nconst Ctx = createContext(null)\nexport function useClipboard() { return useContext(Ctx) }\n\n// Hook pratique : enregistre une cible tant que le composant est monté + l'active au montage.\nexport function useClipboardTarget(id, handlers, active = true) {\n  const cb = useContext(Ctx)\n  const ref = useRef(handlers)\n  ref.current = handlers\n  useEffect(() => {\n    if (!cb) return\n    const unreg = cb.register(id, {\n      onPasteImage: (...a) => ref.current.onPasteImage && ref.current.onPasteImage(...a),\n      onPasteInternal: (...a) => ref.current.onPasteInternal && ref.current.onPasteInternal(...a),\n      onCopy: (...a) => ref.current.onCopy && ref.current.onCopy(...a),\n    })\n    if (active) cb.setActive(id)\n    return unreg\n  }, [id, active])\n  useEffect(() => { if (cb && active) cb.setActive(id) }, [active, id])\n}\n\nfunction inEditable(el) {\n  if (!el) return false\n  if (el.isContentEditable) return true\n  const tag = el.tagName\n  if (tag === 'INPUT' || tag === 'TEXTAREA') return true\n  if (el.closest && el.closest('.bn-editor, [contenteditable=\"true\"]')) return true\n  return false\n}\n\n// Certains navigateurs donnent à une image copiée un File sans nom. Le binaire est inchangé : on lui\n// ajoute seulement un nom/une extension pour que la pipeline image crée le bon manifeste dans le dossier courant.\nfunction namedClipboardFile(file, index) {\n  if (!file || file.name) return file\n  const type = String(file.type || '').toLowerCase()\n  const ext = ({ 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif', 'image/avif': 'avif', 'image/svg+xml': 'svg' })[type]\n    || type.split('/')[1]?.replace(/[^a-z0-9]/gi, '') || 'png'\n  try { return new File([file], `clipboard-${Date.now().toString(36)}-${index + 1}.${ext}`, { type: file.type || `image/${ext}`, lastModified: Date.now() }) } catch { return file }\n}\n\nexport function ClipboardProvider({ children }) {\n  const targets = useRef(new Map())\n  const activeId = useRef(null)\n  const [toast, setToast] = useState(null)\n  const toastTimer = useRef(null)\n  const showToast = useCallback((msg) => {\n    setToast(msg)\n    if (toastTimer.current) clearTimeout(toastTimer.current)\n    toastTimer.current = setTimeout(() => setToast(null), 2400)\n  }, [])\n  const register = useCallback((id, h) => { targets.current.set(id, h); return () => { targets.current.delete(id) } }, [])\n  const setActive = useCallback((id) => { activeId.current = id }, [])\n\n  useEffect(() => {\n    const onPaste = async (e) => {\n      // Laisser l'éditeur BlockNote / les champs gérer leur propre collage (sauf si rien d'éditable n'est focalisé).\n      if (inEditable(e.target) || inEditable(document.activeElement)) return\n      const items = e.clipboardData && e.clipboardData.items\n      if (!items) return\n      const h = targets.current.get(activeId.current)\n      if (!h) return\nserver/upload-vid.js:30:// SÉCURITÉ : vid-content ne doit ÉCRIRE QUE les artefacts vidéo (playlists HLS, clé AES, manifeste) sous pages/.\n2. **Aucun sondage périodique ne tourne quand l'onglet est caché.** `document.visibilityState` et\n   l'événement `visibilitychange` suffisent. Un onglet oublié en arrière-plan est le cas le plus\n   long, donc le plus coûteux, et c'est celui où personne ne regarde le résultat.\n3. **Avant d'accuser l'hébergeur, lire quel compteur a sauté.** Ici, un seul l'était : les autres\n   (transfert CDN, invocations, CPU) étaient tous largement dans les clous. Un compteur unique en\n   rouge désigne une ligne de code, pas un plan tarifaire.\n\n## LE SITE TOURNE SUR CLOUDFLARE, ET UN PUSH NE PUBLIE RIEN (2026-07-31)\n\nRemplace la section « la bascule est prête, elle n'est pas faite » du 2026-07-30, devenue fausse le\nlendemain : la migration a été exécutée. Production sur **https://zenray-progress.pages.dev**,\nancien build Vercel conservé et servi sur **https://zenray-progress.vercel.app**, aucun DNS touché.\nPlan **gratuit**. Le récit de la migration et sa procédure vivent dans\n`docs/HEBERGEMENT-audit-cloudflare.md` ; ici ne restent que les lois d'exploitation.\n\n### Publier : `git push` n'est PAS un déploiement\n\nLe projet Pages a été créé en **upload direct** (`Git Provider: No`), donc GitHub n'est qu'une\narchive du code et **aucun push ne met quoi que ce soit en ligne**. Publier demande une commande\nexplicite, depuis la racine du dépôt :\n\n```\nnpx wrangler pages deploy\n```\n\nC'est un choix, pas un oubli, et il faut le défendre avant de le changer : connecter le dépôt à\nCloudflare publierait à chaque commit, or Matthieu en fait parfois vingt dans une soirée et le plan\ngratuit n'accorde que **500 constructions par mois**. Séparer « enregistrer » de « publier » coûte\nune commande et protège le quota. `.github/workflows/deploiement.yml` offre la même chose par\nbouton, avec choix de cible.\n\n#### Déployer soi-même, sans redemander (consigne de Matthieu, 2026-08-07)\n\n**Dès que Matthieu mentionne le déploiement, la commande se lance, elle ne se propose pas.** « Tu as\ndéployé sur le Wrangler ? » n'est pas une question à laquelle on répond par oui ou par non : c'est\nl'ordre de déployer. Lui rendre la main pour qu'il retape « go » lui coûte un aller-retour entier\npour rien, et c'est exactement ce qui a été payé ce soir-là.\n\nLa séquence complète, à dérouler seul, dans cet ordre :\n\n```\nnpx vite build && npx wrangler pages deploy && git push\n```\n\nTrois précisions apprises le même soir, qui évitent de croire à un échec :\n\n","stderr":"","aggregated_output":"// ÉCRITURE JSON SÛRE SOUS CONCURRENCE (anti