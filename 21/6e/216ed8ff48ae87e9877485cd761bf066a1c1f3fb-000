iles].some((path) => path.startsWith(candidate + '/'))) candidate = `${requested} ${++n}`\n  occupiedBases.add(candidate)\n  files.add(`${candidate}/${marker}`)\n  return candidate\n}\n// ═══ LES ESPACES DE TRI `tmp-img-selectionN` ════════════════════════════════════════════════════\n//\n// LE BESOIN, dans les mots de Matthieu (2026-08-30) : « trier rapidement plusieurs espaces d'images\n// sans perdre l'image originale et son espace initial — il n'y a que des références qui sont\n// déplacées ». Un espace de tri n'est donc pas une copie : c'est un dossier qui ne contient que des\n// LIENS vers des images qui restent chez elles.\n//\n// POURQUOI CE MODULE EXISTE SÉPARÉMENT. La numérotation paraît triviale et ne l'est pas : elle doit\n// tenir devant un dossier vide, devant des numéros à trous (1, 3, 7), devant un nom qui ressemble\n// sans en être un (`tmp-img-selection` nu, `tmp-img-selection01`, `tmp-img-selectionX`), et devant\n// deux clics rapprochés qui viseraient le même numéro. Une fonction pure se teste sur ces cas en\n// une seconde ; la même logique noyée dans un composant ne se teste jamais.\n//\n// LA RÈGLE D'AFFICHAGE, telle qu'il l'a demandée : on montre les espaces qui EXISTENT DÉJÀ, plus le\n// PROCHAIN LIBRE. Un dossier vierge n'offre donc que `tmp-img-selection1` ; dès que celui-ci existe,\n// `tmp-img-selection2` apparaît à côté. C'est ce qui permet de trier en plusieurs tas sans jamais\n// avoir à créer un dossier à la main.\n\n// Le préfixe est un PARAMÈTRE, pas un littéral répété : le changer une fois le change partout, et\n// un autre type de tri (vidéos, documents) réutilisera cette définition au lieu de la recopier.\nexport const PREFIXE_TRI = 'tmp-img-selection'\n\n// Reconnaît un espace de tri et rend son numéro, ou `null`. Strict par construction : seul un\n// entier positif SANS zéro de tête compte, sinon `tmp-img-selection01` et `tmp-img-selection1`\n// désigneraient le même tas en portant deux noms, et le tri se disperserait sans qu'on le voie.\nexport function numeroDeTri(nom, prefixe = PREFIXE_TRI) {\n  const s = String(nom || '')\n  if (!s.startsWith(prefixe)) return null\n  const reste = s.slice(prefixe.length)\n  if (!/^[1-9]\\d*$/.test(reste)) return null\n  return Number(reste)\n}\n\n// Rend les espaces à PROPOSER pour un dossier donné : ceux qui existent, triés, puis le prochain\n// libre marqué `neuf`. `entrees` est la liste des enfants du dossier courant, telle que la vue la\n// possède déjà — aucune requête réseau n'est faite ici, c'est une fonction pure.\n//\n// `prochain` est le plus petit entier strictement supérieur au plus grand numéro existant, et non\n// le premier trou. Réutiliser un trou ferait réapparaître un tas supprimé sous son ancien nom, ce\n// qui trompe : on avance toujours, comme un compteur.\nexport function espacesDeTri(entrees, dossierCourant, prefixe = PREFIXE_TRI) {\n  const dossiers = (entrees || []).filter((e) => e && (e.hasKids || e.type === 'dir' || e.isDir))\n  const numeros = []\n  for (const e of dossiers) {\n    const n = numeroDeTri(e.name || (e.dir || '').split('/').pop(), prefixe)\n    if (n != null) numeros.push(n)\n  }\n  numeros.sort((a, b) => a - b)\n\n  const base = String(dossierCourant || '').replace(/\\/$/, '')\n  const existants = numeros.map((n) => ({\n    n,\n    nom: `${prefixe}${n}`,\n    chemin: `${base}/${prefixe}${n}`,\n    neuf: false,\n  }))\n  const suivant = numeros.length ? numeros[numeros.length - 1] + 1 : 1\n  existants.push({\n    n: suivant,\n    nom: `${prefixe}${suivant}`,\n    chemin: `${base}/${prefixe}${suivant}`,\n    neuf: true,\n  })\n  return existants\n}\n\n// L'espace visé par le geste PAR DÉFAUT, celui du clic direct sans ouvrir le menu : le dernier\n// espace EXISTANT s'il y en a un, sinon le neuf. C'est le comportement attendu quand on trie en\n// rafale — on continue de remplir le tas courant plutôt que d'en ouvrir un à chaque clic.\nexport function espaceParDefaut(espaces) {\n  if (!espaces || !espaces.length) return null\n  const existants = espaces.filter((e) => !e.neuf)\n  return existants.length ? existants[existants.length - 1] : espaces[espaces.length - 1]\n}\n\n\n// ═══ CE QUI PEUT ÊTRE TRIÉ, EN UN SEUL ENDROIT ══════════════════════════════════════════════════\n//\n// « Tout type confondu », demande de Matthieu le 2026-08-30 : une photo, une vidéo, un son, une\n// archive, un board, une vidéo intégrée, une table, et un DOSSIER entier. Le lien Eagle ne\n// distingue pas : il porte un `resourceId`, et un identifiant ne connaît pas le type de ce qu'il\n// désigne.\n//\n// CE MOTIF EST LA MÊME VÉRITÉ QUE CELLE DE `createEagleLinks`, et c'est tout l'intérêt de l'écrire\n// ici : deux filtres qui doivent s'accorder et vivent à deux endroits finissent toujours par\n// diverger, et la divergence se voit le jour où un type accepté par l'un est refusé par l'autre,\n// sans qu'aucune erreur ne le dise. Le menu contextuel et le Quick Look interrogent donc cette\n// fonction, jamais leur propre expression régulière.\nexport const TYPES_TRIABLES = /\\.(img|media|file|canvas|embed|db)\\.json$/\n\n// Vrai si cette entrée de Create peut recevoir une référence dans un espace de tri. Les dossiers\n// comptent : `createEagleLinks` sait poser un lien de dossier entier (`.zreagle-folder.json`).\nexport function estTriable(entree) {\n  if (!entree) return false\n  if (entree.hasKids) return true\n  return !!(entree.contentPath && TYPES_TRIABLES.test(entree.contentPath))\n}\n\n// Filtre une sélection. Rendue séparément parce que l'appelant a besoin du COMPTE pour son\n// étiquette (« Trier vers… (12) ») avant de savoir s'il affiche quoi que ce soit.\nexport function triables(entrees) {\n  return (entrees || []).filter(estTriable)\n}\n// ═══ LES EXTENSIONS DE NŒUD, ÉCRITES UNE SEULE FOIS ═════════════════════════════════════════════\n//\n// CE QUE LA DISPERSION A COÛTÉ, mesuré le 2026-08-31. La même liste d'extensions existait en\n// QUATORZE copies dans huit fichiers, et elles avaient déjà divergé :\n//\n//   server/nodeTreeFilter.js ....... md, db, media, img, canvas, ref, embed, file, plan\n//   scripts/build-search-index.mjs . md, db, media, img, canvas, ——, embed, file, ————\n//\n// Le constructeur d'index avait oublié `ref.json` et `plan.json`. Conséquence vérifiée sur le drive :\n// trois boards Ref et un plan existent réellement, et une reconstruction complète de l'index les\n// efface de la recherche. Ils ne sont pas perdus — ils deviennent introuvables, ce qui est pire,\n// puisque rien ne le signale.\n//\n// LA RÈGLE DU PROJET le disait déjà, dans `page.js` : « même piège que server/nodeTreeFilter.js : un\n// nœud absent de cette regex reste invisible à l'indexation, même s'il existe bel et bien sur\n// GitHub ». Le commentaire était juste ; il était simplement écrit à côté de la treizième copie.\n//\n// AJOUTER UN TYPE DE NŒUD SE FAIT DONC ICI, ET NULLE PART AILLEURS. Un test compare toutes les\n// listes du dépôt à celle-ci et rougit dès qu'une copie s'en écarte.\n\n// L'ordre n'a aucune importance ; l'exhaustivité, si.\nexport const EXTENSIONS_NOEUDS = [\n  'md',            // page Markdown\n  'db.json',       // table\n  'media.json',    // vidéo, audio, PDF, binaire découpé\n  'img.json',      // image\n  'canvas.json',   // board Ref, ancien nom\n  'ref.json',      // board Ref, nom courant\n  'embed.json',    // vidéo intégrée\n  'file.json',     // archive\n  'plan.json',     // calendrier ZenRay Plan\n  'zmedia.json',   // document ZenRayMedia\n]\n\n// Les marqueurs de dossier : ils font exister un dossier pour git, et ne doivent JAMAIS apparaître\n// comme des nœuds. Une copie qui en oublie un le montre comme un faux fichier dans l'arborescence.\nexport const MARQUEURS_DOSSIER = [\n  '.zrfolder.json',\n  '.zrmusic.json',\n  '.zreagle-folder.json',\n]\n\nconst echappe = (s) => s.replace(/\\./g, '\\\\.')\n\n// `x.img.json` mais pas `x.props.json` : l'expression exige la fin de chaîne.\nexport const RE_NOEUD = new RegExp(`\\\\.(${