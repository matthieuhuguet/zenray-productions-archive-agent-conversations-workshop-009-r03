(' ')\n    return `${j.name || ''} ${heads} ${cells}`\n  } catch { return '' }\n}\nasync function buildContent(absRoot, textPaths) {\n  const content = {}\n  let i = 0\n  async function worker() {\n    while (i < textPaths.length) {\n      const rel = textPaths[i++]\n      try {\n        const raw = await readFile(path.join(absRoot, rel), 'utf8')\n        const txt = normTxt(rel.endsWith('.db.json') ? dbToText(raw) : mdToText(raw))\n        if (txt) content[rel] = txt\n      } catch { /* illisible -> omis */ }\n    }\n  }\n  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, worker))\n  return content\n}\n\n// ═══ LES LIENS EAGLE ONT AUSSI UNE VIGNETTE, ET IL FAUT ALLER LA CHERCHER (2026-08-31) ══════════\n//\n// LE SYMPTÔME, signalé par Matthieu : « aucune miniature des médias isolés en mode liens », et une\n// pastille de provenance orange au lieu de verte.\n//\n// LA CAUSE. Un lien Eagle est un `.img.json` qui ne contient QUE `{ v, type, resourceId, title,\n// createdAt }` — c'est tout son intérêt, cent cinquante octets au lieu d'une photo. Il n'a donc ni\n// `thumb`, ni `cdnRepo`, ni `size`, ni `mime`. `thumbEntry` rendait `null`, l'index n'avait aucune\n// vignette à servir, et la tuile affichait une case vide. La pastille, qui lit la provenance dans\n// les mêmes champs, tombait sur « aucune source connue » et virait à l'orange.\n//\n// LA RÉSOLUTION SE FAIT ICI ET NON DANS L'INTERFACE, et c'est le point important. Faire résoudre\n// chaque lien par la grille coûterait un appel réseau PAR TUILE — trois pour trois liens, mais sept\n// cent quarante-huit pour un dossier de photos, sur un quota de cinq mille par heure déjà épuisé\n// deux fois sur ce dépôt. L'index, lui, est construit une fois et lu par tout le monde : c'est\n// exactement ce pour quoi la carte `thumbs` existe.\n//\n// TOUT SE LIT SUR DISQUE. Le clone contient `pages/`, donc aussi `pages/.zr-resources/` où vivent\n// les registres. Zéro octet de réseau ajouté.\n\n// Carte `resourceId -> chemin du manifeste canonique`, construite en une passe.\nasync function lireRegistres(absRoot) {\n  const carte = new Map()\n  const dir = path.join(absRoot, 'pages/.zr-resources')\n  let noms = []\n  try { noms = await readdir(dir) } catch { return carte }   // aucun lien encore créé : rien à faire\n  for (const nom of noms) {\n    if (!nom.endsWith('.json')) continue\n    try {\n      const r = JSON.parse(await readFile(path.join(dir, nom), 'utf8'))\n      if (r && typeof r.resourceId === 'string' && typeof r.sourcePath === 'string') carte.set(r.resourceId, r.sourcePath)\n    } catch { /* registre illisible -> le lien restera sans vignette, pas de fausse vignette */ }\n  }\n  return carte\n}\n\nconst estLienEagle = (m) => !!(m && m.type === 'zenray-eagle-link/v1' && typeof m.resourceId === 'string')\n\n// Lecture + parse parallélisée (CPU cœurs) des .img.json -> remplit la carte thumbs.\nasync function buildThumbs(absRoot, imgPaths, registres) {\n  const thumbs = {}\n  // Un manifeste canonique sert souvent plusieurs liens : on ne le relit qu'une fois.\n  const cacheCanonique = new Map()\n  let i = 0\n  async function worker() {\n    while (i < imgPaths.length) {\n      const idx = i++\n      const rel = imgPaths[idx]\n      try {\n        const txt = await readFile(path.join(absRoot, rel), 'utf8')\n        const m = JSON.parse(txt)\n        if (estLienEagle(m)) {\n          const source = registres.get(m.resourceId)\n          if (!source) continue                      // registre absent : pas de fausse vignette\n          if (!cacheCanonique.has(source)) {\n            try { cacheCanonique.set(source, JSON.parse(await readFile(path.join(absRoot, source), 'utf8'))) }\n            catch { cacheCanonique.set(source, null) }\n          }\n          const canon = cacheCanonique.get(source)\n          const v = canon ? thumbEntry(canon) : null\n          if (v) thumbs[rel] = v\n          continue\n        }\n        const v = thumbEntry(m)\n        if (v) thumbs[rel]