QUE LA DISPERSION A COÛTÉ, mesuré le 2026-08-31. La même liste d'extensions existait en\n// QUATORZE copies dans huit fichiers, et elles avaient déjà divergé :\n//\n//   server/nodeTreeFilter.js ....... md, db, media, img, canvas, ref, embed, file, plan\n//   scripts/build-search-index.mjs . md, db, media, img, canvas, ——, embed, file, ————\n//\n// Le constructeur d'index avait oublié `ref.json` et `plan.json`. Conséquence vérifiée sur le drive :\n// trois boards Ref et un plan existent réellement, et une reconstruction complète de l'index les\n// efface de la recherche. Ils ne sont pas perdus — ils deviennent introuvables, ce qui est pire,\n// puisque rien ne le signale.\n//\n// LA RÈGLE DU PROJET le disait déjà, dans `page.js` : « même piège que server/nodeTreeFilter.js : un\n// nœud absent de cette regex reste invisible à l'indexation, même s'il existe bel et bien sur\n// GitHub ». Le commentaire était juste ; il était simplement écrit à côté de la treizième copie.\n//\n// AJOUTER UN TYPE DE NŒUD SE FAIT DONC ICI, ET NULLE PART AILLEURS. Un test compare toutes les\n// listes du dépôt à celle-ci et rougit dès qu'une copie s'en écarte.\n\n// L'ordre n'a aucune importance ; l'exhaustivité, si.\nexport const EXTENSIONS_NOEUDS = [\n  'md',            // page Markdown\n  'db.json',       // table\n  'media.json',    // vidéo, audio, PDF, binaire découpé\n  'img.json',      // image\n  'canvas.json',   // board Ref, ancien nom\n  'ref.json',      // board Ref, nom courant\n  'embed.json',    // vidéo intégrée\n  'file.json',     // archive\n  'plan.json',     // calendrier ZenRay Plan\n  'zmedia.json',   // document ZenRayMedia\n]\n\n// Les marqueurs de dossier : ils font exister un dossier pour git, et ne doivent JAMAIS apparaître\n// comme des nœuds. Une copie qui en oublie un le montre comme un faux fichier dans l'arborescence.\nexport const MARQUEURS_DOSSIER = [\n  '.zrfolder.json',\n  '.zrmusic.json',\n  '.zreagle-folder.json',\n]\n\nconst echappe = (s) => s.replace(/\\./g, '\\\\.')\n\n// `x.img.json` mais pas `x.props.json` : l'expression exige la fin de chaîne.\nexport const RE_NOEUD = new RegExp(`\\\\.(${EXTENSIONS_NOEUDS.filter((e) => e !== 'md').map(echappe).join('|')})$|\\\\.md$`)\n\n// Variante « suffixe feuille » : rend l'extension complète d'un chemin de nœud, ou null.\nexport function extensionFeuille(chemin) {\n  const m = String(chemin || '').match(RE_NOEUD)\n  return m ? m[0] : null\n}\n\n// Retire l'extension technique pour l'affichage. Sans source unique, chaque vue réécrivait la sienne\n// avec une liste différente — d'où des noms montrés « Agenda.plan.json » au lieu d'« Agenda ».\nexport function sansExtensionNoeud(nom) {\n  return String(nom || '').replace(RE_NOEUD, '')\n}\n\nexport function estMarqueurDossier(chemin) {\n  const nom = String(chemin || '').split('/').pop()\n  return MARQUEURS_DOSSIER.includes(nom)\n}\nimport { MARQUEURS_DOSSIER } from '../../server/extensionsNoeuds.js'\n// C210b — buildTree + entriesOf type-aware (Phase 1 OS). SUR-ENSEMBLE des versions locales d'App.jsx :\n// mêmes structures + champ `type` (+ flags legacy isDb/isMedia/isImage). Gère .md / .db.json / .media.json /\n// .img.json / .canvas.json / .embed.json. Zéro régression : tout champ ancien est conservé.\nimport { typeOfPath, stripLeafExt, legacyFlags } from './node.js'\n\n// Marqueur d'un DOSSIER VIDE persistant : `<dir>/.zrfolder.json`. Un dossier sans aucun nœud (ni sous-nœud)\n// n'existe pas en Git tout seul (Git ne suit pas les dossiers vides) ; ce fichier sentinelle le matérialise.\n// Il ne doit JAMAIS apparaître comme une entrée fichier : il prouve seulement l'existence de SON dossier parent.\n// SOURCE UNIQUE (2026-08-31). Cette liste oubliait `.zrmusic.json` : un dossier « bibliotheque\n// musicale » marque par lui seul n etait donc pas reconnu comme un dossier, et son marqueur\n// s affichait comme un faux fichier. `MARQUEURS_DOSSIER` vit dans server/extensionsNoeuds.js, qui\n// est du JS pur sans dependance serveur ; un test compare les deux listes et rougit si elles\n// divergent. Le slash de tete est ajoute ici, parce que ce fichier compare des SUFFIXES de chemin.\nconst FOLDER_MARKERS = MARQUEURS_DOSSIER.map((m) => '/' + m)\nconst folderMarkerOf = (p) => FOLDER_MARKERS.find((marker) => p.endsWith(marker)) || ''\nconst isFolderMarker = (p) => !!folderMarkerOf(p)\n// Sidecars de STREAMING (DASH/HLS) : playlists .m3u8/.mpd + clé .hlskey.bin. Ils vivent À PLAT à côté du\n// manifeste .media.json (la vidéo) mais ne doivent JAMAIS apparaître comme des nœuds : seul le .media.json\n// est la vidéo affichée. Les ignorer évite à la fois le dossier parasite et les fichiers parasites.\nconst isStreamSidecar = (p) => /\\.(m3u8|mpd)$/i.test(p) || p.endsWith('.hlskey.bin')\nconst folderOfMarker = (p) => p.slice(0, -folderMarkerOf(p).length) // '<...>/Foo/.zrfolder.json' -> '<...>/Foo'\n\n// Arbre Notion : X (contenu) et le dossier X/ fusionnés sous le même nom. node.type = type du contentPath.\nexport function buildTree(paths) {\n  const root = { name: '', children: {}, contentPath: null, type: 'folder' }\n  for (const p of paths) {\n    if (isStreamSidecar(p)) continue // playlists/clé de streaming : jamais des nœuds\n    // Marqueur de dossier vide : on crée seulement la chaîne de dossiers, sans nœud-feuille.\n    const marker = isFolderMarker(p)\n    const base = marker ? folderOfMarker(p) : p\n    const stripped = (marker ? base : stripLeafExt(base)).replace(/^pages\\//, '')\n    if (!stripped) continue\n    const segs = stripped.split('/')\n    let node = root\n    segs.forEach((seg, i) => {\n      node.children[seg] = node.children[seg] || { name: seg, children: {}, contentPath: null, type: 'folder' }\n      node = node.children[seg]\n      if (!marker && i === segs.length - 1) { node.contentPath = p; node.type = typeOfPath(p) }\n    })\n  }\n  return root\n}\n\n// Entrées directement sous `dir`, fusionnant page (X.md) + dossier (X/) + bases/médias (X.db.json…) sous le même nom.\nexport function entriesOf(paths, dir) {\n  const prefix = dir.endsWith('/') ? dir : dir + '/'\n  const map = {}\n  for (const p of (paths || [])) {\n    if (!p.startsWith(prefix)) continue\n    if (isStreamSidecar(p)) continue // playlists/clé de streaming : jamais des nœuds\n    // Marqueur de dossier vide : établit l'EXISTENCE d'un dossier, jamais une entrée fichier.\n    if (isFolderMarker(p)) {\n      const rel = folderOfMarker(p).slice(prefix.length) // '' = marqueur du dossier courant lui-même\n      if (!rel) continue\n      const seg = rel.split('/')[0]\n      map[seg] = map[seg] || { name: seg, contentPath: null, hasKids: false, dir: prefix + seg, type: 'folder', isDb: false, isMedia: false, isImage: false }\n      if (rel.indexOf('/') !== -1) map[seg].hasKids = true\n      continue\n    }\n    const rest = stripLeafExt(p.slice(prefix.length))\n    if (!rest) continue\n    const seg = rest.split('/')[0]\n    const isLeaf = rest.indexOf('/') === -1\n    map[seg] = map[seg] || { name: seg, contentPath: null, hasKids: false, dir: prefix + seg, type: 'folder', isDb: false, isMedia: false, isImage: false }\n    if (isLeaf) {\n      const type = typeOfPath(p)\n      map[seg].contentPath = p\n      map[seg].type = type\n      Object.assign(map[seg], legacyFlags(type))\n    } else {\n      map[seg].hasKids = true\n    }\n  }\n  return Object.values(map).sort((a, b) => a.name.localeCompare(b.name))\n}\n","exit_code":0,"duration":{"secs":0,"nanos":2125},"formatted_output":"// Pure collision allocator shared by the batch endpoint and its 1/20/99/100+\n// regression tests. `occupiedBases` models Create's merged node identity:\n// `dragon.file.json` and a directory named `dragon` collide visually.\nexport function reserveEagleLeafTarget(requested, ext, files, occupiedBases) {\n  const base = ext ? requested.slice(0, -ext.length) : requested\n  let n = 1\n  let candidateBase = base\n  while (files.has(candidateBase + ext) || occupiedBases.has(candidateBase)) candidateBase = `${base} ${++n}`\n  files.add(candidateBase + ext)\n  occupiedBases.add(candidateBase)\n  return candidateBase + ext\n}\n\nexport function reserveEagleFolderTarget(requested, files, occupiedBases, marker = '.zreagle-folder.json') {\n  let n = 1\n  let candidate = requested\n  while (occupiedBases.has(candidate) || [...files].some((path) => path.startsWith(candidate + '/'))) candidate = `${requested} ${++n}`\n  occupiedBases.add(candidate)\n  files.add(`${candidate}/${marker}`)\n  return candidate\n}\n// ═══ LES ESPACES DE TRI `tmp-img-selectionN` ════════════════════════════════════════════════════\n//\n// LE BESOIN, dans les mots de Matthieu (2026-08-30) : « trier rapidement plusieurs espaces d'images\n// sans perdre l'image originale et son espace initial — il n'y a que des références qui sont\n// déplacées ». Un espace de tri n'est donc pas une copie : c'est un dossier qui ne contient que des\n// LIENS vers des images qui restent chez elles.\n//\n// POURQUOI CE MODULE EXISTE SÉPARÉMENT. La numérotation paraît triviale et ne l'est pas : elle doit\n// tenir devant un dossier vide, devant des numéros à trous (1, 3, 7), devant un nom qui ressemble\n// sans en être un (`tmp-img-selection` nu, `tmp-img-selection01`, `tmp-img-selectionX`), et devant\n// deux clics rapprochés qui viseraient le même numéro. Une fonction pure se teste sur ces cas en\n// une seconde ; la même logique noyée dans un composant ne se teste jamais.\n//\n// LA RÈGLE D'AFFICHAGE, telle qu'il l'a demandée : on montre les espaces qui EXISTENT DÉJÀ, plus le\n// PROCHAIN LIBRE. Un dossier vierge n'offre donc que `tmp-img-selection1` ; dès que celui-ci existe,\n// `tmp-img-selection2` apparaît à côté. C'est ce qui permet de trier en plusieurs tas sans jamais\n// avoir à créer un dossier à la main.\n\n// Le préfixe est un PARAMÈTRE, pas un littéral répété : le changer une fois le change partout, et\n// un autre type de tri (vidéos, documents) réutilisera cette définition au lieu de la recopier.\n