result.path, linked: !!result.linked, abouti: true, resourceId: result.resourceId || null, sourcePath: path }\n    })\n    .catch(() => ({ path, linked: false, abouti: false, error: 'network' }))\n\n  // ═══ UN ÉCHEC PASSAGER NE SE MET PAS EN CACHE (2026-08-31) ═══════════════════════════════════\n  //\n  // LE SYMPTÔME, décrit par Matthieu : « Lien média indisponible » sur des images qui existent bel\n  // et bien, puis l'image qui apparaît quelques secondes plus tard, et des pastilles orange.\n  //\n  // LA CAUSE. Le cache gardait la promesse AVANT de savoir ce qu'elle contenait. Une résolution\n  // tombée pendant que le quota GitHub était épuisé était donc mémorisée telle quelle, pour toute la\n  // durée de la session : l'image restait indisponible même une fois le quota rétabli, et seul un\n  // rechargement complet de la page la faisait revenir. L'échec durait infiniment plus longtemps que\n  // sa cause.\n  //\n  // CE QU'ON CACHE DÉSORMAIS : une résolution qui a ABOUTI, y compris « ce n'est pas un lien », qui\n  // est une réponse légitime et stable. Un échec réseau, un quota épuisé ou une erreur serveur sont\n  // des états passagers : on les oublie, si bien que le prochain regard réessaie.\n  //\n  // CE QUI L'EMPÊCHE DE BOUCLER : `readPageCached` mémoïse déjà la requête en vol, donc plusieurs\n  // vignettes affichées ensemble ne produisent qu'un seul appel, même en cas d'échec.\n  cache.set(path, pending)\n  // `abouti` et non `error` : un quota epuise fait rendre une reponse NULLE au serveur, donc `error`\n  // valait `null` et l'echec passait pour une resolution legitime. C'est le piege exact qui gardait\n  // l'image indisponible toute la session.\n  pending.then((v) => { if (!v || !v.abouti) cache.delete(path) }).catch(() => { cache.delete(path) })\n  // On mémorise la valeur RÉSOLUE à part, pour que `eaglePathConnu` puisse répondre sans attendre.\n  pending.then((v) => { resolus.set(path, v) }).catch(() => {})\n  return pending\n}\n\n// ═══ LA RÉPONSE DÉJÀ CONNUE, SANS ATTENDRE ══════════════════════════════════════════════════════\n//\n// `resolveEaglePath` rend une PROMESSE, même quand la réponse est déjà en cache : tout appelant paie\n// donc au moins un tour de boucle d'événements, et surtout un rendu vide en attendant.\n//\n// Mesuré le 2026-08-31 : un aller-retour vers l'API coûte 150 à 250 ms. Le Quick Look en payait un\n// AVANT d'afficher le moindre pixel, alors que la grille venait d'afficher la même image — donc que\n// la réponse était déjà là. Sur un parcours à la flèche, c'est un quart de seconde par image, pour\n// rien.\n//\n// Rend le résultat s'il est connu ET déjà résolu, `undefined` sinon. Jamais de promesse, jamais\n// d'attente : l'appelant décide quoi faire du « je ne sais pas encore ».\nconst resolus = new Map()\nexport function eaglePathConnu(path) {\n  return path ? resolus.get(path) : undefined\n}\n\nexport function invalidateEaglePath(path) {\n  if (path) { cache.delete(path); resolus.delete(path) }\n}\n\n\n// Remise a zero des deux caches. Sert aux tests : sans elle, un cas contamine le suivant et l on\n// mesure alors la memoire d'un autre test plutot que le comportement qu'on croit verifier.\nexport function __resetEagleLinkCache() { cache.clear(); resolus.clear() }\n// ═══ LE REGISTRE D'UNE RESSOURCE SUIT SES DÉPLACEMENTS ══════════════════════════════════════════\n//\n// Un lien Eagle ne porte qu'un `resourceId`. C'est le REGISTRE (`pages/.zr-resources/<id>.json`) qui\n// sait où vit le média réel (`sourcePath`) et où sont tous ses emplacements (`placements`). Déplacer\n// un fichier sans mettre ce registre à jour casserait donc toutes ses références, en silence.\n//\n// POURQUOI CE MODULE EXISTE, et c'est une leçon plutôt qu'une architecture. Cette logique était\n// écrite DEUX FOIS dans `page.js`, dans `move` et dans `move-tree`, avec des variantes. Le\n// 2026-08-31 j'ai cherché « le registre est-il mis à jour au déplacement ? » par un grep borné,\n// je suis tombé sur la moitié qui ne la contenait pas, et j'ai annoncé à Matthieu un trou qui\n// n'existait pas. Une règle écrite à deux endroits ne se vérifie pas : on en lit un et on croit\n// savoir. Elle vit désormais ici, en une définition testée.\n//\n// LA DISTINCTION QUI COMPTE, et qu'on ne devine pas : `sourcePath` désigne le média CANONIQUE, celui\n// qui porte réellement les octets ; `placements` liste TOUS les emplacements, canonique et liens.\n// Déplacer un LIEN ne doit donc jamais toucher `sourcePath` — sinon le registre déclarerait qu'un\n// fichier de cent cinquante octets est la source du média, et toutes les autres références se\n// mettraient à pointer vers un lien qui pointe vers rien.\n\n// Applique un déplacement à un registre. Fonction PURE : rend un nouvel objet, ne modifie pas\n// l'entrée. `canonical` dit si le fichier déplacé est le média réel (true) ou un lien (false).\n// Rend `null` si le registre ne concerne pas cette ressource — l'appelant n'écrit alors rien.\nexport function deplacerDansRegistre(registre, { resourceId, from, to, canonical, kind, maintenant }) {\n  if (!registre || registre.resourceId !== resourceId) return null\n  if (!from || !to || from === to) return null\n\n  const suivant = { ...registre }\n  // Seul le canonique déplace sa source, et seulement s'il en était bien la source.\n  //\n  // DEUX CHAMPS SELON LA NATURE, et c'est le cas qu'on oublie : une ressource FEUILLE porte\n  // `sourcePath` (le manifeste du média), une ressource DOSSIER porte `sourceDir` (le dossier réel\n  // dont les autres emplacements sont des vues). Brancher ce module sans couvrir le second casserait\n  // le déplacement d'un dossier lié, en silence.\n  if (canonical && kind !== 'folder' && registre.sourcePath === from) suivant.sourcePath = to\n  if (canonical && kind === 'folder' && registre.sourceDir === from) suivant.sourceDir = to\n\n  const emplacements = new Set(Array.isArray(registre.placements) ? registre.placements : [registre.sourcePath || registre.sourceDir || from].filter(Boolean))\n  emplacements.delete(from)\n  emplacements.add(to)\n  suivant.placements = [...emplacements]\n  suivant.updatedAt = maintenant || new Date().toISOString()\n  return suivant\n}\n\n// Applique PLUSIEURS déplacements au même registre, en une passe.\n//\n// C'est le cas du déplacement de dossier : plusieurs emplacements d'une même ressource peuvent\n// bouger dans le même arbre. Les appliquer un par un en écrivant à chaque fois ferait perdre toutes\n// les mutations sauf la dernière — le dernier écrivain gagne, les autres disparaissent sans bruit.\nexport function deplacerPlusieurs(registre, mouvements, maintenant) {\n  let courant = registre\n  let touche = false\n  for (const m of mouvements || []) {\n    const suivant = deplacerDansRegistre(courant, { ...m, maintenant })\n    if (suivant) { courant = suivant; touche = true }\n  }\n  return touche ? courant : null\n}\nimport React, { useEffect, useState } from 'react'\nimport UnifiedViewer from './UnifiedViewer.jsx'\nimport { resolveEaglePath } from '../lib/eagleLink.js'\n\n// Do not let individual viewers discover links themselves. Resolving here keeps\n// every media engine (raw, HLS, MSE, YouTube, archive, image) on its canonical path.\nexport default function ResolvedUnifiedViewer({ path, ...props }) {\n  const [resolved, setResolved] = useState(null)\n  useEffect(() => {\n    let live = true\n    setResolved(null)\n    resolveEaglePath(path).then((value) => { if (live) setResolved(value) })\n    return () => { live = false }\n  }, [path])\n  if (!resolved) return <div style={{ padding: 24, color: props.t?.textSecondary || '#888' }}>résolution du lien…</div>\n  if (resolved.error) return <div style={{ padding: 24, color: '#ff453a' }}>Lien média indisponible.</div>\n  return <UnifiedViewer {...props} path={resolved.path} />\n}\n","stderr":"","aggregated_output":"// ZenRay Eagle Links: a placement keeps its normal `.img.json` / `.media.json`\n// / `.file.json` suffix, but its JSON 