{"timestamp":"2026-08-31T09:09:14.122Z","ordinal":146,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0570d-ccf5-7122-9366-8726a3602cd2","turn_id":"01a05712-ae3b-7b32-a66d-559df511a7b7","item":{"type":"CommandExecution","id":"exec-f1174c04-7f57-4578-907c-7450a788432d","process_id":"51336","command":["/bin/zsh","-lc","sed -n '1,260p' server/deplacerDossierDeLiens.test.js && sed -n '130,285p' server/budgetSousRequetes.test.js"],"cwd":"file:///Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress","parsed_cmd":[{"type":"read","cmd":"sed -n '1,260p' server/deplacerDossierDeLiens.test.js","name":"deplacerDossierDeLiens.test.js","path":"server/deplacerDossierDeLiens.test.js"},{"type":"read","cmd":"sed -n '130,285p' server/budgetSousRequetes.test.js","name":"budgetSousRequetes.test.js","path":"server/budgetSousRequetes.test.js"}],"source":"unified_exec_startup","status":"completed","stdout":"import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'\n\n// ═══ UN DOSSIER DE RACCOURCIS EAGLE DOIT POUVOIR SE DÉPLACER ════════════════════════════════════\n//\n// BUG CRITIQUE du 2026-08-31 : un dossier ne contenant QUE des raccourcis Eagle refusait de se\n// déplacer (« 0 déplacé, 1 échec », retour en arrière). Cause : `move-tree` lisait le blob de CHAQUE\n// raccourci pour mettre à jour son registre, plus le registre lui-même, plus un blob créé, soit trois\n// sous-requêtes par raccourci. Vingt-et-un raccourcis faisaient ~69 sous-requêtes, au-delà de la\n// limite de cinquante du Worker Cloudflare, qui mourait alors sans réponse.\n//\n// Le correctif : les raccourcis se déplacent par leur sha (git tree, zéro lecture), et leur registre\n// se met à jour EN FOND, par lots séparés (action `sync-placements`). Le déplacement lui-même est\n// donc cheap et ne dépend plus du nombre de raccourcis.\n\nlet appels, fetchOriginal\n\nfunction installerFauxReseau(fichiersDuDossier) {\n  appels = { total: 0, parUrl: [] }\n  fetchOriginal = globalThis.fetch\n  globalThis.fetch = async (url, opts) => {\n    const u = String(url); appels.total++; appels.parUrl.push(u.replace(/https:\\/\\/[^/]+/, ''))\n    const post = opts && opts.method && opts.method !== 'GET'\n    // création git (POST/PATCH) : blob, tree, commit, ref\n    if (u.includes('git/blobs') && post) return new Response(JSON.stringify({ sha: 'b' }), { status: 201 })\n    if (u.includes('git/trees') && post) return new Response(JSON.stringify({ sha: 't' }), { status: 201 })\n    if (u.includes('git/commits') && post) return new Response(JSON.stringify({ sha: 'c' }), { status: 201 })\n    if (u.includes('git/refs/heads') && post) return new Response(JSON.stringify({}), { status: 200 })\n    // lectures git (GET)\n    if (u.includes('git/ref/heads')) return new Response(JSON.stringify({ object: { sha: 'p' } }), { status: 200 })\n    if (u.includes('git/commits/')) return new Response(JSON.stringify({ tree: { sha: 'bt' } }), { status: 200 })\n    if (u.includes('git/blobs/')) return new Response(JSON.stringify({ content: Buffer.from('{}').toString('base64') }), { status: 200 })\n    // raw : marqueurs et registres (resolveEagleFolderDir, rawJsonAt) — un objet neutre\n    if (u.includes('raw.githubusercontent')) return new Response(JSON.stringify({ resourceId: 'zr_x', placements: [] }), { status: 200 })\n    // contents : soit un fichier précis (.json dedans), soit le listing du dossier\n    if (u.includes('/contents/')) {\n      if (u.includes('.json')) return new Response(JSON.stringify({ content: Buffer.from(JSON.stringify({ resourceId: 'zr_x', placements: [] })).toString('base64') }), { status: 200 })\n      return new Response(JSON.stringify(fichiersDuDossier), { status: 200 })\n    }\n    return new Response('Not Found', { status: 404 })\n  }\n}\n\nfunction fausseReponse() {\n  const r = { code: 0, corps: null }\n  r.status = (c) => { r.code = c; return r }\n  r.json = (j) => { r.corps = j; return r }\n  r.setHeader = () => r; r.end = (v) => { r.corps = v; return r }\n  return r\n}\n\n// Un dossier de 21 raccourcis Eagle (.img.json), plus son marqueur de dossier.\nconst DOSSIER = [\n  { type: 'file', path: 'pages/A/tri/streets5/.zrfolder.json', sha: 's0' },\n  ...Array.from({ length: 21 }, (_, i) => ({ type: 'file', path: `pages/A/tri/streets5/IMG_${5800 + i}.jpeg.img.json`, sha: 's' + i })),\n]\n\nbeforeEach(() => { process.env.GITHUB_TOKEN = 'faux' })\nafterEach(() => { if (fetchOriginal) globalThis.fetch = fetchOriginal })\n\ndescribe('déplacer un dossier de 21 raccourcis', () => {\n  it('LE BUG : le déplacement tient LARGEMENT sous la limite de 50 sous-requêtes', async () => {\n    installerFauxReseau(DOSSIER)\n    const { default: handler } = await import('./page.js')\n    const res = fausseReponse()\n    await handler({ method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n      body: { action: 'move-tree', from: 'pages/A/tri/streets5', to: 'pages/B/streets5' } }, res)\n\n    expect(res.corps?.ok, `le déplacement doit réussir, réponse: ${JSON.stringify(res.corps)}`).toBe(true)\n    // Le coeur du fix : PAS de lecture de blob par raccourci. Bien moins de 50.\n    expect(appels.total, `${appels.total} sous-requêtes pour 21 raccourcis — le Worker meurt au-delà de 50`).toBeLessThan(45)\n  })\n\n  it('les 21 raccourcis sont bien renvoyés pour la synchro de fond', async () => {\n    installerFauxReseau(DOSSIER)\n    const { default: handler } = await import('./page.js')\n    const res = fausseReponse()\n    await handler({ method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n      body: { action: 'move-tree', from: 'pages/A/tri/streets5', to: 'pages/B/streets5' } }, res)\n    expect(Array.isArray(res.corps?.placementSync)).toBe(true)\n    expect(res.corps.placementSync.length, 'les 21 raccourcis doivent être listés pour la synchro').toBe(21)\n  })\n\n  it('sync-placements traite un lot borné à 15', async () => {\n    installerFauxReseau(DOSSIER)\n    const { default: handler } = await import('./page.js')\n    const res = fausseReponse()\n    const links = Array.from({ length: 21 }, (_, i) => ({ from: `pages/A/tri/streets5/IMG_${5800 + i}.jpeg.img.json`, to: `pages/B/streets5/IMG_${5800 + i}.jpeg.img.json` }))\n    await handler({ method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n      body: { action: 'sync-placements', links } }, res)\n    expect(res.corps?.ok).toBe(true)\n    expect(res.corps.done, 'le lot est borné à 15').toBe(15)\n    expect(appels.total, 'un lot de sync reste sous la limite').toBeLessThan(50)\n  })\n})\n          targetPath: `${dossier}/tri/f${i}.img.json`,\n          title: `f${i}`,\n        })),\n      },\n    }, fausseReponse())\n\n    // La même sonde ne doit apparaître qu'une fois dans le journal des appels.\n    const sondes = appels.parUrl.filter((u) => u.includes('zreagle-folder'))\n    const uniques = new Set(sondes)\n    if (sondes.length !== uniques.size) {\n      const compte = {}\n      for (const u of sondes) compte[u] = (compte[u] || 0) + 1\n      console.log('  SONDES REPETEES :', Object.entries(compte).filter(([, n]) => n > 1))\n    }\n    expect(sondes.length, `${sondes.length} sondes pour ${uniques.size} chemins distincts : la mémoïsation ne fonctionne plus`)\n      .toBe(uniques.size)\n  })\n})\n\ndescribe('les lectures chaudes passent par raw, jamais par l’API à quota', () => {\n  it('resolve-link ne touche PAS au quota REST', async () => {\n    // Cette route est appelée pour CHAQUE raccourci affiché dans une grille. Elle brûlait deux\n    // requêtes de quota par lien : un dossier de treize en coûtait vingt-six, et Matthieu s'est\n    // retrouvé à 3000 sur 5000 en une soirée de tri.\n    installerFauxReseau({\n      manifestes: {\n        'lien.img.json': { v: 1, type: 'zenray-eagle-link/v1', resourceId: 'zr_abc', title: 'x' },\n        'zr_abc.json': { resourceId: 'zr_abc', sourcePath: 'pages/A/vrai.img.json' },\n        'vrai.img.json': MANIFESTE_IMAGE,\n      },\n    })\n    const { default: handler } = await import('./page.js')\n    await handler({\n      method: 'GET',\n      query: { action: 'resolve-link', path: 'pages/A/tri/lien.img.json' },\n      headers: { 'x-zr-auth': 'x' },\n    }, fausseReponse())\n\n    expect(appels.api, `resolve-link a fait ${appels.api} appel(s) à api.github.com — ils doivent tous passer par raw`)\n      .toBe(0)\n    expect(appels.raw).toBeGreaterThan(0)\n  })\n})\n\ndescribe('le chemin de SUCCÈS reste sous le budget, et c’est celui qui compte', () => {\n  it('un lot de 13 fichiers commité coûte moins de 50 sous-requêtes', async () => {\n    // Le constat #17 de l'audit : « le lot de 13 liens coûte 61 sous-requêtes quand le commit\n    // RÉUSSIT, et le test qui le garde ne mesure que le chemin d'échec ». Il avait raison, et ce\n    // cas ferme le trou.\n    const dossier = 'pages/A/B/C'\n    installerFauxReseau({ manifestes: { '.img.json': MANIFESTE_IMAGE } })\n    const { default: handler, oublierMemoireDossiers } = await import('./page.js')\n    oublierMemoireDossiers()\n    await handler({\n      method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n      body: {\n        action: 'create-eagle-links-batch',\n        items: Array.from({ length: 13 }, (_, i) => ({\n          kind: 'leaf', sourcePath: `${dossier}/f${i}.img.json`,\n          targetPath: `${dossier}/tri/f${i}.img.json`, title: `f${i}`,\n        })),\n      },\n    }, fausseReponse())\n    expect(appels.total, `${appels.total} sous-requêtes pour 13 fichiers — la Function meurt au-delà d'une cinquantaine`).toBeLessThan(50)\n  })\n\n  it('le coût croît LENTEMENT avec la taille du lot : les ancêtres sont partagés', async () => {\n    const mesurer = async (combien) => {\n      installerFauxReseau({ manifestes: { '.img.json': MANIFESTE_IMAGE } })\n      const { default: handler, oublierMemoireDossiers } = await import('./page.js')\n      oublierMemoireDossiers()\n      await handler({\n        method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n        body: {\n          action: 'create-eagle-links-batch',\n          items: Array.from({ length: combien }, (_, i) => ({\n            kind: 'leaf', sourcePath: `pages/A/B/C/f${i}.img.json`,\n            targetPath: `pages/A/B/C/tri/f${i}.img.json`, title: `f${i}`,\n          })),\n        },\n      }, fausseReponse())\n      return appels.total\n    }\n    const petit = await mesurer(3)\n    const grand = await mesurer(13)\n    // Si les sondes d'ancêtres n'étaient pas partagées, dix fichiers de plus coûteraient dix fois\n    // cinq sondes. Le surcoût doit rester proche d'une requête par fichier.\n    expect(grand - petit, `+10 fichiers ont coûté ${grand - petit} sous-requêtes de plus`).toBeLessThan(22)\n  })\n})\n\ndescribe('la mémoire de résolution ne survit PAS à la requête', () => {\n  // Régression du 2026-08-31, introduite la nuit précédente en posant la mémoïsation. Elle vivait\n  // dans `globalThis`, et une isolate Cloudflare est réutilisée entre requêtes : une résolution\n  // mémorisée AVANT la création d'un dossier survivait APRÈS, et le serveur répondait « ce dossier\n  // n'existe pas » à propos d'un dossier qui venait d'être créé.\n  //\n  // Symptôme rapporté : « créer des dossiers, le temps de la notif parfois ils disparaissent ».\n  // L'intermittence venait du recyclage de l'isolate : le même geste marchait une fois sur deux.\n\n  const unLot = (handler) => handler({\n    method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n    body: {\n      action: 'create-eagle-links-batch',\n      items: [{ kind: 'leaf', sourcePath: 'pages/A/B/C/f0.img.json', targetPath: 'pages/A/B/C/tri/f0.img.json', title: 'f0' }],\n    },\n  }, fausseReponse())\n\n  it('LE BUG : une seconde requête resonde, elle ne rejoue pas une mémoire périmée', async () => {\n    const { default: handler } = await import('./page.js')\n    installerFauxReseau({ manifestes: { '.img.json': MANIFESTE_IMAGE } })\n    await unLot(handler)\n    const premiere = appels.parUrl.filter((u) => u.includes('zreagle-folder')).length\n    expect(premiere, 'la première requête doit sonder').toBeGreaterThan(0)\n\n    // Seconde requête, SANS vider quoi que ce soit à la main : c'est le handler qui doit le faire.\n    installerFauxReseau({ manifestes: { '.img.json': MANIFESTE_IMAGE } })\n    await unLot(handler)\n    const seconde = appels.parUrl.filter((u) => u.includes('zreagle-folder')).length\n    expect(seconde, 'la seconde requête a rejoué une mémoire périmée : un dossier créé entre-temps resterait invisible').toBeGreaterThan(0)\n  })\n\n  it('mais DANS une même requête, la mémoire déduplique toujours', async () => {\n    // Les deux moitiés comptent : sans la mémoire, un lot de treize sondait cinq ancêtres treize\n    // fois, soit 169 sous-requêtes. Le gain doit rester intact.\n    installerFauxReseau({ manifestes: { '.img.json': MANIFESTE_IMAGE } })\n    const { default: handler } = await import('./page.js')\n    await handler({\n      method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },\n      body: {\n        action: 'create-eagle-links-batch',\n        items: Array.from({ length: 13 }, (_, i) => ({\n          kind: 'leaf', sourcePath: `pages/A/B/C/f${i}.img.json`,\n          targetPath: `pages/A/B/C/tri/f${i}.img.json`, title: `f${i}`,\n        })),\n      },\n    }, fausseReponse())\n    const sondes = appels.parUrl.filter((u) => u.includes('zreagle-folder'))\n    expect(sondes.length, `${sondes.length} sondes pour 13 fichiers : la mémoïsation intra-requête est perdue`).toBe(new Set(sondes).size)\n  })\n})\n","stderr":"","aggregated_output":"import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'\n\n// ═══ UN DOSSIER DE RACCOURCIS EAGLE DOIT POUVOIR SE DÉPLACER ════════════════════════════════════\n//\n// BUG CRITIQUE du 2026-08-31 : un dossier ne contenant QUE des raccourcis Eagle refusait de se\n// déplacer (« 0 déplacé, 1 échec », retour en arrière). Cause : `move-tree` lisait le blob de CHAQUE\n// raccourci pour mettre à j