u'une fois.\n  const cacheCanonique = new Map()\n  let i = 0\n  async function worker() {\n    while (i < imgPaths.length) {\n      const idx = i++\n      const rel = imgPaths[idx]\n      try {\n        const txt = await readFile(path.join(absRoot, rel), 'utf8')\n        const m = JSON.parse(txt)\n        if (estLienEagle(m)) {\n          const source = registres.get(m.resourceId)\n          if (!source) continue                      // registre absent : pas de fausse vignette\n          if (!cacheCanonique.has(source)) {\n            try { cacheCanonique.set(source, JSON.parse(await readFile(path.join(absRoot, source), 'utf8'))) }\n            catch { cacheCanonique.set(source, null) }\n          }\n          const canon = cacheCanonique.get(source)\n          const v = canon ? thumbEntry(canon) : null\n          if (v) thumbs[rel] = v\n          continue\n        }\n        const v = thumbEntry(m)\n        if (v) thumbs[rel] = v\n      } catch { /* manifeste illisible -> omis (placeholder propre) */ }\n    }\n  }\n  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, worker))\n  return thumbs\n}\n\nconst t0 = Date.now()\nconsole.log(`clone sparse ${REPO} (pages/, blob:none) -> ${WORK} ...`)\nawait rm(WORK, { recursive: true, force: true }).catch(() => {})\nconst url = `https://x-access-token:${TOKEN}@github.com/${REPO}.git`\nexecFileSync('git', ['clone', '--quiet', '--filter=blob:none', '--no-checkout', '--depth=1', url, WORK], { stdio: 'inherit' })\nexecFileSync('git', ['-C', WORK, 'sparse-checkout', 'init', '--cone'], { stdio: 'inherit' })\nexecFileSync('git', ['-C', WORK, 'sparse-checkout', 'set', 'pages'], { stdio: 'inherit' })\nexecFileSync('git', ['-C', WORK, 'checkout', BRANCH, '--quiet'], { stdio: 'inherit' })\n\nconsole.log('marche de l arbre disque (pages/) ...')\nconst all = []\nawait walk(WORK, 'pages', all)\nconst paths = [...new Set(all)].filter((p) => !p.endsWith('.zr-search-index.json')).sort()\nconst imgPaths = paths.filter((p) => p.endsWith('.img.json'))\nconsole.log(`noeuds: ${paths.length} | images: ${imgPaths.length} | ${((Date.now() - t0) / 1000).toFixed(0)}s`)\n\nconsole.log(`lecture + parse des ${imgPaths.length} manifestes (.img.json) sur disque, ${Math.min(CPU, 16)} workers ...`)\nconst registres = await lireRegistres(WORK)\nif (registres.size) console.log(`registres de liens Eagle : ${registres.size}`)\nconst thumbs = await buildThumbs(WORK, imgPaths, registres)\nconst nThumb = Object.keys(thumbs).length\nconst nPublic = Object.values(thumbs).filter((v) => v.u).length\nconst nPrivate = nThumb - nPublic\n\n// Contenu plein-texte des markdowns + tables (recherche par mot-clé).\nconst textPaths = paths.filter((p) => p.endsWith('.md') || p.endsWith('.db.json'))\nconsole.log(`extraction contenu plein-texte de ${textPaths.length} fichiers (.md/.db.json) ...`)\nconst content = await buildContent(WORK, textPaths)\nconst nContent = Object.keys(content).length\n\n// TAILLES par nœud (octets) -> l'app affiche la taille de N'IMPORTE quel fichier SANS appel API.\n// Manifestes (img/media/file) : champ `size` du JSON. Autres (.md/.db/.canvas/.embed) : taille sur disque.\n// Lecture locale parallèle, hors quota. Couvre archive (.file.json) ET drag-drop/bulk (.media/.img.json).\n// Récupère AUSSI le mime des nœuds média/fichier (mimes) -> l'app choisit la bonne icône (ex: PDF) depuis\n// l'index, sans fetch runtime fragile. mimes ne contient QUE les .media/.file (pas les images : icône déjà connue).\nasync function buildSizes(absRoot, all, registres) {\n  const sizes = {}, mimes = {}; let i = 0\n  async function w() {\n    while (i < all.length) {\n      const rel = all[i++]\n      try {\n        if (/\\.(img|media|file)\\.json$/.test(rel)) {\n          let m = JSON.parse(await readFile(path.join(absRoot, rel), 'utf8'))\n          // Un lien porte 172 octets ; sa TAILLE affichée doit être celle du média, pas celle du\n          // lien, sinon l'app annonce « 172 o » pour une photo de dix-huit mégaoctets.\n