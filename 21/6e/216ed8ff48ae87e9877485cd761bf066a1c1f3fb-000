pas : `createFolderAt` commite, et le lot repart\n  // AUSSITÔT vers un serveur qui, lui, relit GitHub. Entre le commit et le moment où l'API rend le\n  // nouveau dossier, il y a un instant pendant lequel il n'existe pour personne d'autre que nous.\n  // Le lot tombe dans cet instant, la résolution du dossier cible échoue, et tout est refusé.\n  //\n  // ON N'ATTEND PAS UN CHRONO, ON ATTEND UNE PREUVE. Un délai fixe est un pari : trop court il rate,\n  // trop long il fait patienter pour rien, et dans les deux cas il ne dit jamais s'il a suffi. On\n  // interroge donc le dossier jusqu'à ce qu'il RÉPONDE, avec un plafond d'essais et une attente qui\n  // s'allonge. Si le plafond est atteint, on le dit et on ne lance rien : mieux vaut un refus clair\n  // qu'un lot qu'on sait condamné.\n  // La mécanique d'attente vit dans `lib/attendreLisible.js`, testée seule : ici on ne fournit que\n  // la SONDE, c'est-à-dire ce que « lisible » veut dire pour un dossier de ce drive.\n  const attendreDossierLisible = async (chemin) => {\n    // ═══ SONDER LE MARQUEUR, PAS LE DOSSIER : `children` COÛTE UNE REQUÊTE DE QUOTA ══════════════\n    //\n    // `action=children` liste un dossier par `git/trees`, donc par l'API REST, donc sur le quota de\n    // cinq mille requêtes horaires. Cette attente en faisait jusqu'à SIX par création d'espace, pour\n    // une question à laquelle un seul octet répond.\n    //\n    // Or ce qu'on veut savoir — « ce dossier existe-t-il pour le serveur ? » — se lit sur son\n    // MARQUEUR : un dossier vide n'existe pour git qu'à travers son `.zrfolder.json`, et un fichier\n    // se lit par `raw`, gratuitement. Même réponse, coût nul.\n    const marqueur = `${chemin}/.zrfolder.json`\n    const r = await attendreLaPreuve(async () => {\n      const j = await fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(marqueur)}`, { cache: 'no-store' })\n        .then((x) => x.json()).catch(() => null)\n      return !!(j && !j.missing && j.markdown != null)\n    })\n    return r.ok\n  }\n\n  const trierVersEspace = async (entries, espace) => {\n    debutOccupe()\n    try { return await trierVersEspaceInterne(entries, espace) }\n    finally { finOccupe() }\n  }\n\n  const trierVersEspaceInterne = async (entries, espace) => {\n    if (espace.neuf) {\n      setStatus(`création de ${espace.nom}…`)\n      const ok = await createFolderAt(espace.chemin)\n      if (!ok) {\n        setStatus('')\n        notify({ icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Tri', title: 'Espace non créé', body: `Impossible de créer ${espace.nom}. Rien n'a été trié.` })\n        return\n      }\n      setStatus(`${espace.nom} créé, attente de sa propagation…`)\n      const lisible = await attendreDossierLisible(espace.chemin)\n      if (!lisible) {\n        setStatus('')\n        notify({ icon: 'clock', tint: '#FF9F0A', label: 'Tri', title: `${espace.nom} pas encore lisible`, body: 'Le dossier est créé mais GitHub ne le rend pas encore. Réessaie dans quelques secondes : rien n’a été trié.' })\n        return\n      }\n    }\n    return createEagleLinks(entries, espace.chemin)\n  }\n\n  const createEagleLinks = async (entries, dest) => {\n    debutOccupe()\n    try { return await createEagleLinksInterne(entries, dest) }\n    finally { finOccupe() }\n  }\n\n  const createEagleLinksInterne = async (entries, dest) => {\n    const leaves = entries.filter((entry) => entry.contentPath && /\\.(img|media|file|canvas|embed|db)\\.json$/.test(entry.contentPath))\n    const folders = entries.filter((entry) => !entry.contentPath || entry.hasKids)\n    if (!leaves.length && !folders.length) { notify({ kind: 'info', label: 'Afficher aussi dans…', title: 'Aucun média compatible', body: 'Les liens Eagle couvrent tous les médias archivés et les dossiers d’assets.' }); return }\n    const taken = new Set((dest === folder ? (dirEntries || []) : []).map((entry) => entry.name.toLowerCase()))\n    const targetFor = (entry) => {\n      const leaf = leafExtension(entry.contentPath)\n      const root = entry.name || 'média'\n      let name = root; let n = 2\n      while (taken.has(name.toLowerCase())) { name = `${root} ${n++}` }\n      taken.add(name.toLowerCase())\n      return `${dest}/${name}${leaf}`\n    }\n    const leafPlan = leaves.map((entry) => ({ kind: 'leaf', entry, targetPath: targetFor(entry) }))\n    const folderPlan = folders.map((entry) => {\n      const root = entry.name || entry.dir.split('/').pop() || 'dossier'\n      let name = root; let n = 2\n      while (taken.has(name.toLowerCase())) name = `${root} ${n++}`\n      taken.add(name.toLowerCase())\n      return { kind: 'folder', entry, targetDir: `${dest}/${name}` }\n    })\n    const plan = [...leafPlan, ...folderPlan]\n    const optimisticPaths = plan.map((item) => item.kind === 'folder' ? `${item.targetDir}/.zreagle-folder.json` : item.targetPath)\n    const optimisticIndexPaths = leafPlan.map((item) => item.targetPath)\n    // t=0: the destination tile and local search index update before the network\n    // round-trip. A failed atomic batch rolls both back with one resync.\n    if (dest === folder) {\n      optimisticDir((current) => {\n        const additions = entriesOfNodes(optimisticPaths, dest)\n        const seen = new Set(current.map((entry) => entry.dir))\n        return current.concat(additions.filter((entry) => !seen.has(entry.dir)))\n      })\n    }\n    injectSearchIndexPaths(optimisticIndexPaths)\n    setSelected(new Set())\n    setStatus(`création atomique de ${plan.length} lien(s)…`)\n    const response = await apiPost('create-eagle-links-batch', {\n      items: plan.map((item) => item.kind === 'folder'\n        ? { kind: 'folder', sourceDir: item.entry.dir, targetDir: item.targetDir, title: item.entry.name }\n        : { kind: 'leaf', sourcePath: item.entry.contentPath, targetPath: item.targetPath, title: item.entry.name }),\n    }).catch(() => null)\n    if (!response?.ok) {\n      rollbackSearchIndexPaths(optimisticIndexPaths)\n      // Le tick voit les chemins RÉELLEMENT écrits, donc il rafraîchit aussi quand la destination\n    // est un sous-dossier de la vue — cas que l'ancien garde `dest === folder` laissait passer.\n    tick([...optimisticPaths, dest])\n      setStatus(`0/${plan.length} lien(s) créé(s)`)\n      // ═══ DIRE LAQUELLE DES SEPT CAUSES, ET SUR QUEL FICHIER (2026-08-30) ═══════════════════════\n      //\n      // LE DÉFAUT QUE CE CODE AVAIT. Le serveur SAIT exactement pourquoi il refuse : il rend un\n      // `error` de famille et un `results[].error` par élément, avec sept valeurs distinctes qui\n      // appellent sept correctifs différents — `bad-path`, `invalid-source`, `missing-source`,\n      // `orphan-link`, `virtual-target-readonly`, `target-tree`, `commit`. Cette notification les\n      // écrasait toutes sous une phrase unique, « une source ou une collision a échoué », qui ne\n      // permet ni de savoir laquelle, ni sur quel fichier.\n      //\n      // C'est le même défaut que le board gris de ce soir, et il coûte la même chose : trois\n      // allers-retours pour deviner ce que la réponse contenait déjà. La règle du dépôt le dit,\n      // un échec muet sur sa CAUSE est un échec muet.\n      const cause = (() => {\n        // PAS DE RÉPONSE DU TOUT n'est pas une cause « inconnue » : c'est une cause précise, et\n        // c'est même la plus instructive. `apiPost(...).catch(causeApi)` rend `null` quand la\n        // requête n'aboutit pas — réseau coupé, ou Worker tué avant d'avoir répondu.\n        //\n        // Le 2026-08-31 à 03h39, « inconnu » voulait dire exactement cela : ma retente dans\n        // `rawJsonAt` doublait les sous-requêtes, un Worker en a cinquante, et il mourait avant de\n        // rendre le moindre octet. Un message qui dit « je ne sais pas » quand la réponse est\n        // ABSENTE fait chercher au mauvais endroit.\n        if (!response) return { code: 'aucune-reponse', nom: null }\n        const rs = Array.isArray(response.results) ? response.results : []\n        const premier = rs.find((x) => x && x.error && x.error !== 'batch-aborted')\n        const code = (premier && premier.error) || response.detail || response.error || 'reponse-sans-code'\n        const quoi = premier && plan[premier.index]\n        const nom = quoi ? (quoi.kind === 'folder' ? quoi.targetDir : quoi.targetPath).split('/').pop() : null\n        return { code, nom }\n      })()\n      const EXPLICATIONS = {\n        'bad-path': 'un chemin refusé (extension ou dossier hors périmètre)',\n        'bad-dir': 'un dossier source ou cible refusé',\n        'bad-kind': 'un type d’élément non reconnu',\n        'invalid-source': 'un manifeste source illisible ou absent',\n        'missing-source': 'la source d’un lien n’existe plus',\n        'orphan-link': 'un lien dont la ressource d’origine a disparu',\n        'virtual-target-readonly': 'le dossier de destination est lui-même un lien : on n’y écrit pas',\n        'orphan-folder-link': 'un dossier-lien dont la ressource d’origine a disparu',\n        'target-tree': 'le dossier de destination n’a pas pu être lu',\n        'commit': 'le commit a été refusé par GitHub',\n        'aucune-reponse': 'le serveur n’a rien renvoyé — requête coupée, ou trop d’éléments dans le lot',\n        'reponse-sans-code': 'le serveur a répondu sans dire pourquoi (voir la console)',\n        // Ajouté le 2026-08-31 : le serveur refuse désormais AVANT d'avoir rien touché quand un\n        // dossier dépasse ce qu'une seule opération peut réécrire. Le message précis vient du\n        // serveur (champ `message`) ; celui-ci n'est que le repli.\n        'trop-de-fichiers': 'ce dossier contient trop de fichiers pour une seule opération — rien n’a été déplacé, procède par sous-dossiers',\n        'unauthorized': 'le code du drive n’est pas reconnu',\n      }\n      console.error('[eagle-links] refus', { erreur: response?.error, detail: response?.detail, results: response?.results })\n      notify({\n        icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Liens Eagle annulés',\n        title: `Aucun élément créé · ${cause.code}`,\n        body: `${cause.message || EXPLICATIONS[cause.code] || 'cause non répertoriée'}${cause.nom ? ` — sur « ${cause.nom} »` : ''}. Le lot est atomique : rien n’a été laissé à moitié.`,\n      })\n      return\n    }\n    const durableIndexPaths = Array.isArray(response.indexedPaths) ? response.indexedPaths : optimisticIndexPaths\n    injectSearchIndexPaths(durableIndexPaths)\n    let indexed = !!response.indexed\n    if (!indexed && durableIndexPaths.length) indexed = !!(await apiPost('index-add', { paths: durableIndexPaths }).catch(causeApi))?.delta\n    // A server-side collision may have allocated \"Name 2\". The authoritative\n    // reload replaces the temporary optimistic name without flicker or ghosts.\n    // Le tick voit les chemins RÉELLEMENT écrits, donc il rafraîchit aussi quand la destination\n    // est un sous-dossier de la vue — cas que l'ancien garde `dest === folder` laissait passer.\n    tick([...optimisticPaths, dest])\n    setStatus(indexed ? `${response.created} lien(s) créé(s) et indexé(s) ✓` : `${response.created} lien(s) créé(s), index à resynchroniser`)\n    notify(indexed\n      ? { kind: 'success', label: 'Liens Eagle créés', title: `${response.created} emplacement(s)`, body: `Un commit, index immédiat, aucun upload vers ${dest}.` }\n      : { icon: 'exclamationmark.triangle', tint: '#FF9F0A', label: 'Liens créés', title: `${response.created} emplacement(s)`, body: 'Les liens sont intacts et ouvrables ; la confirmation distante de l’index sera retentée au prochain rafraîchissement.' })\n    loadPathsDebounced()\n  }\n\n  // ── Playlist par drag & drop (2026-07-19, feature miniplayer) ─────────────────────────────────────\n  // Un morceau (mini-player en lecture OU tuile média existante) déposé sur une tuile PLAYLIST doit\n  // l'y ajouter -- jamais déclencher le comportement \"grouper en dossier\" déjà en place pour deux\n  // feuilles quelconques (dropLeaf/createFolderFromDrop, inchangé pour tout le reste).\n      // `await import()` qui tirait un module de plus sur la route la plus chaude de l'app.\n      return m\n    }\n    await new Promise((res) => setTimeout(res, Math.min(4000, 300 * (i + 1))))\n  }\n  throw new Error('manifest-unavailable')\n}\n\n// In-memory manifest cache (avoids re-fetching the same .img.json). Only DEFINITIVE answers are\n// stored (valid manifest OR confirmed absence); never a transient failure.\nconst _cache = createLruCache({ maxEntries: IMAGE_NODE_CACHE_LIMITS.manifests })\n// Clear the manifest cache (after a migration: a manifest changed URL/visibility).\nexport function clearManifestCache() { _cache.clear() }\n// T(1) — TARGETED invalidation of a single manifest (after copy-paste: the NEW path's manifest may\n// have been cached as `null` (missing) BEFORE copyNode wrote it -> permanently grey tile). Remove\n// the offending entry to allow a clean re-fetch. Preferred over a global clear (which would throw\n// away hundreds of valid manifests and trigger a fetch burst -> rate-limit risk).\nexport function invalidateManifest(path) { if (path) _cache.delete(path) }\n\n// Manifest read that REUSES the in-memory cache populated by grid thumbnails.\n// QuickLook (Space) must be instant: if the grid already displayed this node, its .img.json is\n// already in _cache -> zero network round-trip. Otherwise read + cache for next time.\nexport async function readImgManifestCached(path) {\n  if (_cache.has(path)) return _cache.get(path)\n  try {\n    let m = await readImgManifest(path)\n    // Grid thumbnails also resolve placements. Keep the cache under the placement\n    // path so an Eagle image appears instantly without a second manifest route.\n    if (m && m.type === 'zenray-eagle-link/v1') {\n      // ═══ UN ÉCHEC PASSAGER N'EST PAS UNE IMAGE INTROUVABLE (2026-08-31) ═══════════════════════\n      //\n      // SYMPTÔME signal