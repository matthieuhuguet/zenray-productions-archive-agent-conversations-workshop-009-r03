n\n// TAILLES par nœud (octets) -> l'app affiche la taille de N'IMPORTE quel fichier SANS appel API.\n// Manifestes (img/media/file) : champ `size` du JSON. Autres (.md/.db/.canvas/.embed) : taille sur disque.\n// Lecture locale parallèle, hors quota. Couvre archive (.file.json) ET drag-drop/bulk (.media/.img.json).\n// Récupère AUSSI le mime des nœuds média/fichier (mimes) -> l'app choisit la bonne icône (ex: PDF) depuis\n// l'index, sans fetch runtime fragile. mimes ne contient QUE les .media/.file (pas les images : icône déjà connue).\nasync function buildSizes(absRoot, all, registres) {\n  const sizes = {}, mimes = {}; let i = 0\n  async function w() {\n    while (i < all.length) {\n      const rel = all[i++]\n      try {\n        if (/\\.(img|media|file)\\.json$/.test(rel)) {\n          let m = JSON.parse(await readFile(path.join(absRoot, rel), 'utf8'))\n          // Un lien porte 172 octets ; sa TAILLE affichée doit être celle du média, pas celle du\n          // lien, sinon l'app annonce « 172 o » pour une photo de dix-huit mégaoctets.\n          if (estLienEagle(m)) {\n            const source = registres.get(m.resourceId)\n            if (!source) continue\n            try { m = JSON.parse(await readFile(path.join(absRoot, source), 'utf8')) } catch { continue }\n          }\n          if (Number.isFinite(m.size)) sizes[rel] = m.size\n          if (m.mime && /\\.(media|file)\\.json$/.test(rel)) mimes[rel] = m.mime\n        } else sizes[rel] = (await stat(path.join(absRoot, rel))).size\n      } catch { /* illisible -> omis */ }\n    }\n  }\n  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, w))\n  return { sizes, mimes }\n}\nconsole.log(`tailles + mimes par nœud (manifestes + disque) ...`)\nconst { sizes, mimes } = await buildSizes(WORK, paths, registres)\nconst index = { v: 3, count: paths.length, builtAt: new Date().toISOString(), paths, thumbs, content, sizes, mimes }\nconsole.log(`contenu indexé: ${nContent} fichiers | +${(JSON.stringify(content).length / 1048576).toFixed(1)} Mo`)\nconst json = JSON.stringify(index)\nconsole.log(`index v2 : ${(json.length / 1048576).toFixed(1)} Mo | thumbs: ${nThumb} (public ${nPublic} / privé ${nPrivate}) | images sans thumb: ${imgPaths.length - nThumb}`)\n\n// Échantillon lisible (5 thumbs) pour vérification humaine, sans nom de média sensible (chemins déjà hachés).\nconst sample = Object.entries(thumbs).slice(0, 5)\nfor (const [p, v] of sample) console.log('  thumb', p, '=>', JSON.stringify(v))\n\nif (!APPLY) {\n  console.log(`\\nDRY-RUN (aucun push). Pour appliquer après revue : node scripts/build-search-index.mjs --apply`)\n  await rm(WORK, { recursive: true, force: true }).catch(() => {})\nimport { describe, expect, it } from 'vitest'\nimport { isEagleLink } from './eagleLink.js'\n\ndescribe('Eagle link descriptor', () => {\n  it('accepts only the versioned placement schema', () => {\n    expect(isEagleLink({ type: 'zenray-eagle-link/v1', resourceId: 'zr_123' })).toBe(true)\n    expect(isEagleLink({ type: 'zenray-eagle-link/v1' })).toBe(false)\n    expect(isEagleLink({ type: 'youtube', resourceId: 'zr_123' })).toBe(false)\n  })\n})\nimport { describe, it, expect, vi, beforeEach } from 'vitest'\n\n// ═══ UN ÉCHEC PASSAGER NE DOIT PAS DURER TOUTE LA SESSION ═══════════════════════════════════════\n//\n// Symptôme réel (2026-08-31) : « Lien média indisponible » sur des images existantes, pendant que le\n// quota GitHub était épuisé — et l'image restait indisponible APRÈS le rétablissement du quota,\n// jusqu'au rechargement de la page. L'échec survivait très largement à sa cause.\n\nvi.mock('./manifestReadCache.js', () => ({ readPageCached: vi.fn() }))\nconst { readPageCached } = await import('./manifestReadCache.js')\nconst { resolveEaglePath, __resetEagleLinkCache } = await import('./eagleLink.js')\n\nbeforeEach(() => { vi.clearAllMocks(); __resetEagleLinkCache?.() })\n\ndescribe('le cache de résolution garde les succès, oublie les échecs', () => {\n  it('LE BUG : ap