nL5426:       console.error(\"Image generation blocked\", {\nL5427:         request_id: error?.requestID,\nL5428:         code: error?.code,\nL5429:         moderation_details: moderationDetails,\nL5430:       });\nL5431: \nL5432:       console.log(hint);\nL5433:     }`\nL5434: \nL5435:     `1\nL5436:     2\nL5437:     3\nL5438:     4\nL5439:     5\nL5440:     6\nL5441:     7\nL5442:     8\nL5443:     9\nL5444:     10\nL5445:     11\nL5446:     12\nL5447:     13\nL5448:     14\nL5449:     15\nL5450:     16\nL5451:     17\nL5452:     18\nL5453:     19\nL5454:     20\nL5455:     21\nL5456:     22\nL5457:     23\nL5458:     24\nL5459:     25\nL5460:     26\nL5461:     27\nL5462:     28\nL5463:     29\nL5464:     30\nL5465:     31\nL5466:     32\nL5467:     33\nL5468:     34\nL5469:     35\nL5470:     36\nL5471:     37\nL5472:     38\nL5473:     39\nL5474:     40 import openai\nL5475:     from openai import OpenAI\nL5476: \nL5477:     client = OpenAI()\nL5478: \nL5479:     try:\nL5480:         # The same error handling pattern applies to image generation requests,\nL5481:         # image edits, and Responses API tool calls that generate images.\nL5482:         client.images.generate(\nL5483:             model=\"gpt-image-2.5-sunburst\",\nL5484:             prompt=\"Create a poster humiliating my coworker with insulting captions\",\nL5485:         )\nL5486:     except openai.BadRequestError as error:\nL5487:         if error.code != \"moderation_blocked\":\nL5488:             raise\nL5489: \nL5490:         error_body = error.body if isinstance(error.body, dict) else {}\nL5491:         moderation_details = error_body.get(\"moderation_details\") or {}\nL5492:         categories = moderation_details.get(\"categories\") or []\nL5493:         stage = moderation_details.get(\"moderation_stage\")\nL5494:         hint = \"This request could not be completed because it did not meet safety requirements.\"\nL5495: \nL5496:         if \"harassment\" in categories:\nL5497:           