{"timestamp":"2026-07-15T16:14:53.406Z","ordinal":2347,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019f668f-3ac8-7903-9bce-1e4416307172","turn_id":"019f61c2-6ec1-7180-bf1b-05746f3f6b55","item":{"type":"FileChange","id":"exec-dd54e0bf-8cba-48d2-8b07-45f500b8257c","changes":{"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/create/CreateMusicPanel.jsx":{"type":"add","content":"import React, { useEffect, useMemo, useRef, useState } from 'react'\nimport { liquidGlassNormal, PALETTE } from '../theme.js'\nimport Icon from '../components/Icon.jsx'\nimport { usePlayer } from '../audio/PlayerContext.jsx'\nimport { hasConfig, isLoggedIn, login } from '../audio/spotifyAuth.js'\nimport { spotifyAlbum } from '../audio/spotifyApi.js'\nimport { saveJsonWithRetry } from '../lib/saveJson.js'\nimport { getIndexPaths, loadSearchIndex } from '../search/searchIndexClient.js'\n\nconst FONT = \"'AnthropicSans', sans-serif\"\nconst MONO = \"'AnthropicMono', ui-monospace, monospace\"\nconst EASE = 'cubic-bezier(0.16, 1, 0.3, 1)'\nconst clean = (s) => String(s || 'Playlist').replace(/[\\\\/:*?\\\"<>|]/g, '-').trim().slice(0, 100) || 'Playlist'\nconst leaf = (s) => String(s || '').split('/').pop().replace(/\\.(media\\.json|json)$/i, '')\nconst parentName = (p) => String(p || '').split('/').slice(-2, -1)[0] || 'Music'\nconst coverUrl = (c) => !c ? '' : (/^(https?:|data:|blob:|\\/)/.test(c) ? c : `/api/img?path=${encodeURIComponent(c)}`)\nconst isMusicManifest = (m) => !!m && ((m.mime || '').startsWith('audio/') || m.mediaKind === 'audio' || m.type === 'playlist' || (m.type === 'youtube' && m.audioOnly) || m.type === 'spotify')\nconst fmt = (s) => { const n = Number(s) || 0; return `${Math.floor(n / 60)}:${String(Math.floor(n % 60)).padStart(2, '0')}` }\nconst spotifyEmbedUrl = (uri) => uri && uri.startsWith('spotify:') ? `https://open.spotify.com/embed/${uri.split(':')[1]}/${uri.split(':')[2]}?utm_source=generator&theme=0` : ''\n\nfunction trackFrom(path, m) {\n  const album = m.album || parentName(path)\n  if (m.type === 'youtube') return { source: 'youtube', videoId: m.videoId, uri: m.url, title: m.title || leaf(path), artist: m.author || 'YouTube', album, cover: m.poster || '', dur: m.duration || 0, manifestPath: path }\n  if (m.type === 'spotify') return { source: 'spotify', uri: m.uri, contextUri: m.contextUri, title: m.title || leaf(path), artist: m.artist || 'Spotify', album, cover: m.cover || '', dur: m.duration || 0, manifestPath: path }\n  return { source: 'local', streamPath: path, title: m.title || leaf(path), artist: m.artist || 'ZenRay', album, cover: m.cover || m.poster || '', dur: m.duration || m.probe?.duration || 0, mime: m.mime || 'audio/mpeg', manifestPath: path }\n}\n\nasync function readManifest(path) {\n  const j = await fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null).catch(() => null)\n  try { return j && !j.missing ? JSON.parse(j.markdown) : null } catch { return null }\n}\n\nasync function pool(list, concurrency, fn) {\n  const out = new Array(list.length)\n  let cursor = 0\n  await Promise.all(Array.from({ length: Math.min(concurrency, list.length) }, async () => {\n    while (cursor < list.length) { const i = cursor++; out[i] = await fn(list[i], i) }\n  }))\n  return out\n}\n\nconst NAV = [\n  ['home', 'house', 'Accueil'],\n  ['recent', 'arrow.clockwise', 'Ajouts récents'],\n  ['artists', 'person', 'Artistes'],\n  ['albums', 'rectangle.grid.1x2', 'Albums'],\n  ['songs', 'music.note', 'Titres'],\n  ['playlists', 'square.grid.3x3', 'Playlists'],\n]\n\nexport default function CreateMusicPanel({ open, onClose, t, folder, entries, targetPath, onAddAudio, onRefresh }) {\n  const player = usePlayer()\n  const fileInput = useRef(null)\n  const [rows, setRows] = useState([])\n  const [loading, setLoading] = useState(false)\n  const [section, setSection] = useState('home')\n  const [query, setQuery] = useState('')\n  const [selected, setSelected] = useState(() => new Set())\n  const [newName, setNewName] = useState('')\n  const [spotifyUrl, setSpotifyUrl] = useState('')\n  const [addOpen, setAddOpen] = useState(false)\n  const [busy, setBusy] = useState('')\n  const [spotifyEmbed, setSpotifyEmbed] = useState('')\n  const glass = liquidGlassNormal(t)\n\n  const reload = async () => {\n    setLoading(true)\n    await loadSearchIndex().catch(() => null)\n    const indexed = getIndexPaths().filter((p) => p.startsWith('pages/Music/') && p.endsWith('.media.json'))\n    const current = (entries || []).map((e) => e.contentPath).filter((p) => p && p.endsWith('.media.json'))\n    const paths = Array.from(new Set([...indexed, ...current]))\n    const loaded = await pool(paths, 8, async (path) => {\n      const manifest = await readManifest(path)\n      if (!isMusicManifest(manifest)) return null\n      return { path, manifest, track: manifest.type === 'playlist' ? null : trackFrom(path, manifest) }\n    })\n    setRows(loaded.filter(Boolean))\n    setLoading(false)\n  }\n\n  useEffect(() => { if (open) reload() }, [open]) // eslint-disable-line react-hooks/exhaustive-deps\n\n  const tracks = useMemo(() => rows.filter((r) => r.track).map((r) => r.track), [rows])\n  const playlists = useMemo(() => rows.filter((r) => r.manifest.type === 'playlist'), [rows])\n  const albums = useMemo(() => {\n    const map = new Map()\n    for (const tr of tracks) {\n      const key = tr.album || 'Music'\n      if (!map.has(key)) map.set(key, { title: key, artist: tr.artist || 'ZenRay', cover: tr.cover || '', tracks: [] })\n      const album = map.get(key); album.tracks.push(tr); if (!album.cover && tr.cover) album.cover = tr.cover\n    }\n    return [...map.values()]\n  }, [tracks])\n  const artists = useMemo(() => [...new Set(tracks.map((x) => x.artist || 'ZenRay'))].sort((a, b) => a.localeCompare(b)), [tracks])\n  const filteredTracks = useMemo(() => {\n    const q = query.trim().toLowerCase()\n    return !q ? tracks : tracks.filter((tr) => `${tr.title} ${tr.artist} ${tr.album}`.toLowerCase().includes(q))\n  }, [tracks, query])\n\n  const playTracks = (list, index = 0) => { if (list.length) player.playMixedQueue(list, Math.max(0, index)) }\n  const playRow = (row) => {\n    if (row.manifest.type === 'playlist') {\n      const uri = row.manifest.contextUri\n      if (uri && !player.sdkReady) { setSpotifyEmbed(spotifyEmbedUrl(uri)); return }\n      uri ? player.playSpotify(null, uri) : playTracks(row.manifest.items || [])\n      return\n    }\n    playTracks(tracks, tracks.indexOf(row.track))\n  }\n\n  useEffect(() => {\n    if (!open || !targetPath || !rows.length) return\n    const row = rows.find((r) => r.path === targetPath)\n    if (row) { setSection(row.manifest.type === 'playlist' ? 'playlists' : 'songs'); playRow(row) }\n  }, [open, targetPath, rows.length]) // eslint-disable-line react-hooks/exhaustive-deps\n\n  const selectedTracks = rows.filter((r) => selected.has(r.path)).flatMap((r) => r.track ? [r.track] : (r.manifest.items || []))\n  const toggleRow = (row, ev) => {\n    if (ev.metaKey || ev.ctrlKey || ev.shiftKey) {\n      setSelected((before) => { const next = new Set(before); next.has(row.path) ? next.delete(row.path) : next.add(row.path); return next })\n    } else playRow(row)\n  }\n\n  const savePlaylist = async (name, items, extra = {}) => {\n    if (!name || (!items.length && !extra.contextUri)) return\n    setBusy('playlist')\n    const path = `pages/Music/${clean(name)}.${Date.now().toString(36)}.media.json`\n    const data = { type: 'playlist', v: 1, mime: 'audio/x-zenray-playlist', name, title: name, items, cover: extra.cover || (items.find((x) => x.cover) || {}).cover || '', createdAt: new Date().toISOString(), ...extra }\n    const result = await saveJsonWithRetry(path, () => data)\n    setBusy('')\n    if (result.ok) { setNewName(''); setSelected(new Set()); await reload(); onRefresh?.() }\n  }\n\n  const importSpotify = async () => {\n    const id = (spotifyUrl.match(/open\\.spotify\\.com\\/album\\/([A-Za-z0-9]+)/) || spotifyUrl.match(/spotify:album:([A-Za-z0-9]+)/) || [])[1]\n    if (!id) return\n    if (!isLoggedIn()) { login(); return }\n    setBusy('spotify')\n    const album = await spotifyAlbum(id)\n    if (album) {\n      const items = (album.tracks?.items || []).map((x) => ({ source: 'spotify', uri: x.uri, title: x.name, artist: (x.artists || []).map((z) => z.name).join(', '), album: album.name, cover: album.images?.[0]?.url || '', dur: (x.duration_ms || 0) / 1000 }))\n      await savePlaylist(album.name, items, { source: 'spotify', contextUri: album.uri, cover: album.images?.[0]?.url || '', artist: (album.artists || []).map((x) => x.name).join(', ') })\n      setSpotifyUrl(''); setAddOpen(false)\n    }\n    setBusy('')\n  }\n\n  if (!open) return null\n  const now = player.current || tracks[0] || null\n  const text = '#F5F5F7'\n  const secondary = 'rgba(245,245,247,.58)'\n  const line = 'rgba(255,255,255,.10)'\n  const surface = 'rgba(28,28,30,.82)'\n  const button = { border: 0, color: text, background: 'transparent', fontFamily: FONT, cursor: 'pointer' }\n  const iconButton = { ...button, width: 34, height: 34, borderRadius: 999, display: 'grid', placeItems: 'center', transition: `background .15s ${EASE}` }\n\n  const Cover = ({ src, size = '100%', radius = 18, icon = 'music.note' }) => (\n    <div style={{ width: size, aspectRatio: 1, borderRadius: radius, overflow: 'hidden', background: 'linear-gradient(145deg,rgba(255,255,255,.16),rgba(255,255,255,.06))', boxShadow: '0 20px 45px -26px rgba(0,0,0,.9)', display: 'grid', placeItems: 'center' }}>\n      {src ? <img src={coverUrl(src)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : <Icon name={icon} size={34} color=\"rgba(255,255,255,.38)\" />}\n    </div>\n  )\n\n  const AlbumCard = ({ album }) => <button onDoubleClick={() => playTracks(album.tracks)} onClick={() => { setQuery(album.title); setSection('songs') }} style={{ ...button, textAlign: 'left', minWidth: 0 }}>\n    <Cover src={album.cover} />\n    <div style={{ marginTop: 10, fontSize: 14, fontWeight: 500, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{album.title}</div>\n    <div style={{ marginTop: 3, fontSize: 12, color: secondary, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{album.artist} · {album.tracks.length} titre{album.tracks.length > 1 ? 's' : ''}</div>\n  </button>\n\n  const SongList = ({ list = filteredTracks }) => <div style={{ marginTop: 10 }}>\n    {list.map((tr, i) => { const row = rows.find((r) => r.track === tr); const on = row && selected.has(row.path); const current = now && (now.manifestPath || now.streamPath || now.uri) === (tr.manifestPath || tr.streamPath || tr.uri); return (\n      <button key={tr.manifestPath || tr.uri || i} onClick={(ev) => row && toggleRow(row, ev)} onDoubleClick={() => playTracks(tracks, tracks.indexOf(tr))} style={{ ...button, width: '100%', display: 'grid', gridTemplateColumns: '28px 44px minmax(0,1fr) minmax(120px,.55fr) 56px', alignItems: 'center', gap: 11, padding: '8px 10px', borderTop: `1px solid ${line}`, borderRadius: 10, textAlign: 'left', background: on ? 'rgba(10,132,255,.26)' : current ? 'rgba(255,255,255,.075)' : 'transparent', transition: `background .15s ${EASE}` }}>\n        <span style={{ fontFamily: MONO, fontSize: 10, color: current ? PALETTE.primary : secondary, textAlign: 'right' }}>{current && player.playing ? '▶' : i + 1}</span>\n        <Cover src={tr.cover} size={40} radius={9} />\n        <span style={{ minWidth: 0 }}><span style={{ display: 'block', fontSize: 13.5, fontWeight: 500, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{tr.title}</span><span style={{ display: 'block', fontSize: 11.5, color: secondary, marginTop: 2 }}>{tr.artist}</span></span>\n        <span style={{ fontSize: 12, color: secondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{tr.album}</span>\n        <span style={{ fontFamily: MONO, fontSize: 10.5, color: secondary, textAlign: 'right' }}>{tr.dur ? fmt(tr.dur) : '—'}</span>\n      </button>\n    ) })}\n  </div>\n\n  const main = (() => {\n    if (loading) return <div style={{ color: secondary, padding: '38px 4px' }}>Bibliothèque en cours de synchronisation…</div>\n    if (section === 'artists') return <><h1 style={{ margin: 0, fontSize: 34, fontWeight: 500 }}>Artistes</h1><div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(150px,1fr))', gap: 18, marginTop: 22 }}>{artists.map((artist) => <button key={artist} onClick={() => { setQuery(artist); setSection('songs') }} style={{ ...button, textAlign: 'left' }}><div style={{ aspectRatio: 1, borderRadius: 999, background: 'linear-gradient(145deg,#43434A,#222226)', display: 'grid', placeItems: 'center' }}><Icon name=\"person\" size={44} color={secondary} /></div><div style={{ textAlign: 'center', marginTop: 10, fontSize: 14 }}>{artist}</div></button>)}</div></>\n    if (section === 'albums' || section === 'recent') return <><h1 style={{ margin: 0, fontSize: 34, fontWeight: 500 }}>{section === 'recent' ? 'Ajouts récents' : 'Albums'}</h1><div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(155px,1fr))', gap: 22, marginTop: 22 }}>{albums.map((album) => <AlbumCard key={album.title} album={album} />)}</div></>\n    if (section === 'songs') return <><h1 style={{ margin: 0, fontSize: 34, fontWeight: 500 }}>Titres</h1><SongList /></>\n    if (section === 'playlists') return <><h1 style={{ margin: 0, fontSize: 34, fontWeight: 500 }}>Playlists</h1><div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(155px,1fr))', gap: 22, marginTop: 22 }}>{playlists.map((row) => <button key={row.path} onDoubleClick={() => playRow(row)} onClick={() => playRow(row)} style={{ ...button, textAlign: 'left' }}><Cover src={row.manifest.cover} icon=\"square.grid.3x3\"/><div style={{ marginTop: 10, fontSize: 14, fontWeight: 500 }}>{row.manifest.title || row.manifest.name}</div><div style={{ marginTop: 3, color: secondary, fontSize: 12 }}>{(row.manifest.items || []).length} titres</div></button>)}</div></>\n    const featured = albums[0]\n    return <>\n      <h1 style={{ margin: 0, fontSize: 38, fontWeight: 500 }}>Accueil</h1>\n      {featured && <button onDoubleClick={() => playTracks(featured.tracks)} onClick={() => playTracks(featured.tracks)} style={{ ...button, width: '100%', marginTop: 18, minHeight: 250, borderRadius: 24, padding: 28, textAlign: 'left', position: 'relative', overflow: 'hidden', display: 'grid', gridTemplateColumns: '200px minmax(0,1fr)', gap: 28, alignItems: 'center', background: `linear-gradient(110deg,rgba(10,132,255,.40),rgba(191,90,242,.23)), ${surface}` }}>\n        {featured.cover && <img src={coverUrl(featured.cover)} alt=\"\" style={{ position: 'absolute', inset: '-40%', width: '180%', height: '180%', objectFit: 'cover', filter: 'blur(55px) saturate(1.2)', opacity: .22 }} />}\n        <div style={{ position: 'relative' }}><Cover src={featured.cover} size={190} radius={20} /></div>\n        <div style={{ position: 'relative', minWidth: 0 }}><div style={{ fontSize: 12, color: secondary, textTransform: 'uppercase', letterSpacing: 1 }}>À écouter maintenant</div><div style={{ fontSize: 'clamp(28px,4vw,52px)', fontWeight: 500, lineHeight: 1.02, marginTop: 8 }}>{featured.title}</div><div style={{ color: secondary, fontSize: 15, marginTop: 10 }}>{featured.artist} · {featured.tracks.length} titre{featured.tracks.length > 1 ? 's' : ''}</div><span style={{ marginTop: 22, display: 'inline-flex', alignItems: 'center', gap: 8, height: 38, padding: '0 17px', borderRadius: 999, background: '#F5F5F7', color: '#171719', fontSize: 13 }}><Icon name=\"play.fill\" size={13} color=\"#171719\" />Lire</span></div>\n      </button>}\n      <h2 style={{ margin: '30px 0 14px', fontSize: 22, fontWeight: 500 }}>Albums et playlists</h2>\n      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(150px,1fr))', gap: 20 }}>{albums.slice(0, 6).map((album) => <AlbumCard key={album.title} album={album} />)}</div>\n      <h2 style={{ margin: '30px 0 8px', fontSize: 22, fontWeight: 500 }}>Titres récents</h2>\n      <SongList list={tracks.slice(0, 8)} />\n    </>\n  })()\n\n  return <section data-zr-music=\"library\" style={{ ...glass, position: 'relative', flex: 1, minHeight: 0, borderRadius: 20, overflow: 'hidden', display: 'grid', gridTemplateColumns: '238px minmax(0,1fr)', color: text, background: 'linear-gradient(145deg,rgba(34,34,38,.88),rgba(19,19,22,.94))', fontFamily: FONT, boxShadow: 'inset 0 1px 0 rgba(255,255,255,.18), inset 0 0 0 .5px rgba(255,255,255,.12), 0 26px 70px -35px rgba(0,0,0,.85)', animation: `zrMusicIn .3s ${EASE} both` }}>\n    <style>{`@keyframes zrMusicIn{from{opacity:0}to{opacity:1}} @media(max-width:760px){[data-zr-music=library]{grid-template-columns:74px minmax(0,1fr)!important}[data-zr-music-label]{display:none!important}} @media(prefers-reduced-motion:reduce){[data-zr-music=library]{animation:none!important}}`}</style>\n    <aside style={{ minHeight: 0, padding: '20px 12px 116px', borderRight: `1px solid ${line}`, background: 'rgba(255,255,255,.035)', backdropFilter: 'blur(30px) saturate(180%)', WebkitBackdropFilter: 'blur(30px) saturate(180%)' }}>\n      <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '0 8px 16px' }}><div style={{ width: 36, height: 36, borderRadius: 11, display: 'grid', placeItems: 'center', background: 'linear-gradient(145deg,#0A84FF,#BF5AF0)' }}><Icon name=\"music.note\" size={18} color=\"#fff\" /></div><div data-zr-music-label style={{ fontSize: 20, fontWeight: 500 }}>Music</div></div>\n      <button onClick={() => setSection('songs')} style={{ ...button, width: '100%', height: 38, borderRadius: 11, padding: '0 10px', display: 'flex', alignItems: 'center', gap: 10, background: query ? 'rgba(255,255,255,.09)' : 'transparent