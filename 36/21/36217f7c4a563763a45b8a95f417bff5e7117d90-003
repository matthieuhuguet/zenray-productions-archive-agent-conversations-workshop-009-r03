Tube', cover: m.poster || '', dur: m.duration || 0, manifestPath: entry.contentPath }\n  if (m.type === 'spotify') return { source: 'spotify', uri: m.uri, contextUri: m.contextUri, title: m.title || leaf(entry.name), artist: m.artist || 'Spotify', cover: m.cover || '', dur: m.duration || 0, manifestPath: entry.contentPath }\n  return { source: 'local', streamPath: entry.contentPath, title: m.title || leaf(entry.name), artist: m.artist || '', album: m.album || '', cover: m.cover || m.poster || '', dur: m.duration || m.probe?.duration || 0, mime: m.mime || 'audio/mpeg' }\n}\n\nexport default function CreateMusicPanel({ open, onClose, t, folder, entries, selected, setSelected, onRefresh }) {\n  const player = usePlayer()\n  const [rows, setRows] = useState([])\n  const [loading, setLoading] = useState(false)\n  const [newName, setNewName] = useState('')\n  const [spotifyUrl, setSpotifyUrl] = useState('')\n  const [busy, setBusy] = useState('')\n  const dark = t.textPrimary === '#F3F0EA'\n  const glass = liquidGlassNormal(t)\n\n  useEffect(() => {\n    if (!open) return\n    let live = true; setLoading(true)\n    Promise.all((entries || []).filter((e) => e.contentPath && e.contentPath.endsWith('.media.json')).map(async (entry) => {\n      const j = await fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(entry.contentPath)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n      let m = null; try { m = JSON.parse(j && j.markdown) } catch {}\n      return isMusicManifest(m) ? { entry, manifest: m, track: m.type === 'playlist' ? null : trackFrom(entry, m) } : null\n    })).then((x) => { if (live) { setRows(x.filter(Boolean)); setLoading(false) } })\n    return () => { live = false }\n  }, [open, entries])\n\n  const tracks = useMemo(() => rows.filter((r) => r.track).map((r) => r.track), [rows])\n  const selectedRows = rows.filter((r) => selected && selected.has(r.entry.dir))\n  const selectedTracks = selectedRows.flatMap((r) => r.track ? [r.track] : (r.manifest.items || []))\n  const play = (list, i = 0) => {\n    if (!list.length) return\n    const tr = list[i]\n    if (tr.source === 'spotify') player.playSpotify(tr.uri ? [tr.uri] : null, tr.contextUri)\n    else player.playQueue(list.filter((x) => x.source !== 'spotify' && x.source !== 'youtube'), Math.max(0, i))\n  }\n  const playRow = (r) => r.manifest.type === 'playlist'\n    ? (r.manifest.contextUri ? player.playSpotify(null, r.manifest.contextUri) : play(r.manifest.items || []))\n    : play(tracks, Math.max(0, tracks.indexOf(r.track)))\n\n  const savePlaylist = async (name, items, extra = {}) => {\n    if (!name || (!items.length && !extra.contextUri)) return\n    setBusy('save')\n    const path = `${folder}/${clean(name)}.${Date.now().toString(36)}.media.json`\n    const data = { type: 'playlist', v: 1, mime: 'audio/x-zenray-playlist', name, title: name, items, createdAt: new Date().toISOString(), ...extra }\n    const r = await saveJsonWithRetry(path, () => data)\n    setBusy(''); if (r.ok) { setNewName(''); onRefresh && onRefresh() }\n  }\n  const importSpotify = async () => {\n    const id = (spotifyUrl.match(/open\\.spotify\\.com\\/album\\/([A-Za-z0-9]+)/) || spotifyUrl.match(/spotify:album:([A-Za-z0-9]+)/) || [])[1]\n    if (!id) return\n    if (!isLoggedIn()) { login(); return }\n    setBusy('spotify')\n    const a = await spotifyAlbum(id)\n    if (a) {\n      const items = (a.tracks?.items || []).map((x) => ({ source: 'spotify', uri: x.uri, title: x.name, artist: (x.artists || []).map((z) => z.name).join(', '), album: a.name, cover: a.images?.[0]?.url || '', dur: (x.duration_ms || 0) / 1000 }))\n      await savePlaylist(a.name, items, { source: 'spotify', contextUri: a.uri, cover: a.images?.[0]?.url || '', artist: (a.artists || []).map((x) => x.name).join(', ') })\n      setSpotifyUrl('')\n    }\n    setBusy('')\n  }\n\n  if (!open) return null\n  const field = { height: 36, borderRadius: 999, border: `1px solid ${t.border}`, background: dark ? 'rgba(255,255,255,.08)' : 'rgba(255,255,255,.58)', color: t.textPrimary, padding: '0 14px', font: `400 13px ${FONT}`, outline: 'none' }\n  const pill = { height: 36, borderRadius: 999, border: 'none', background: PALETTE.primary, color: '#fff', padding: '0 16px', font: `400 13px ${FONT}`, cursor: 'pointer', display: 'inline-flex', alignItems: 'center', gap: 7 }\n  return createPortal(\n    <div style={{ position: 'fixed', inset: 0, zIndex: 10020, background: dark ? 'rgba(4,6,12,.34)' : 'rgba(225,232,242,.32)', backdropFilter: 'blur(14px)', WebkitBackdropFilter: 'blur(14px)', padding: 'clamp(14px,3vw,42px)' }} onMouseDown={onClose}>\n      <section onMouseDown={(e) => e.stopPropagation()} style={{ ...glass, height: '100%', borderRadius: 28, overflow: 'hidden', display: 'flex', flexDirection: 'column', color: t.textPrimary, fontFamily: FONT }}>\n        <header style={{ padding: '18px 22px 14px', display: 'flex', alignItems: 'center', gap: 12, borderBottom: `1px solid ${t.border}` }}>\n          <div style={{ width: 42, height: 42, borderRadius: 13, display: 'grid', placeItems: 'center', background: `linear-gradient(145deg,${PALETTE.primary},#BF5AF0)`, boxShadow: '0 10px 24px -12px rgba(10,132,255,.9)' }}><Icon name=\"music.note\" size={20} color=\"#fff\" /></div>\n          <div><div style={{ fontSize: 23, fontWeight: 500 }}>Music</div><div style={{ fontSize: 12, color: t.textSecondary }}>{folder.replace(/^pages\\/?/, '') || 'Create'} · bibliothèque du dossier</div></div>\n          <div style={{ marginLeft: 'auto', display: 'flex', gap: 8 }}>\n            {!!selectedTracks.length && <button style={pill} onClick={() => play(selectedTracks)}><Icon name=\"play.fill\" size={13} color=\"#fff\" />Lire la sélection ({selectedTracks.length})</button>}\n            <button aria-label=\"Fermer\" onClick={onClose} style={{ ...pill, width: 36, padding: 0, justifyContent: 'center', background: dark ? 'rgba(255,255,255,.1)' : 'rgba(0,0,0,.06)', color: t.textPrimary }}><Icon name=\"xmark\" size={13} /></button>\n          </div>\n        </header>\n\n        <div className=\"zr-scroll-noblur\" style={{ overflowY: 'auto', padding: '22px clamp(18px,3vw,38px) 42px' }}>\n          <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 24 }}>\n            <input value={newName} onChange={(e) => setNewName(e.target.value)} placeholder=\"Nom de la playlist\" style={{ ...field, minWidth: 210 }} />\n            <button disabled={!newName.trim() || !selectedTracks.length || !!busy} style={{ ...pill, opacity: !newName.trim() || !selectedTracks.length ? .45 : 1 }} onClick={() => savePlaylist(newName.trim(), selectedTracks)}><Icon name=\"plus\" size={13} color=\"#fff\" />Playlist depuis la sélection</button>\n            {hasConfig() && <><input value={spotifyUrl} onChange={(e) => setSpotifyUrl(e.target.value)} placeholder=\"Coller un album Spotify\" style={{ ...field, marginLeft: 'auto', minWidth: 230 }} /><button style={pill} disabled={!spotifyUrl || !!busy} onClick={importSpotify}>Ajouter l’album</button></>}\n          </div>\n\n          <h2 style={{ margin: '0 0 12px', fontSize: 19, fontWeight: 500 }}>Albums et playlists</h2>\n          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(150px,1fr))', gap: 18, marginBottom: 30 }}>\n            {rows.filter((r) => r.manifest.type === 'playlist').map((r) => <button key={r.entry.dir} onClick={() => playRow(r)} style={{ border: 0, background: 'transparent', padding: 0, textAlign: 'left', color: t.textPrimary, cursor: 'pointer', fontFamily: FONT }}>\n              <div style={{ aspectRatio: 1, borderRadius: 18, overflow: 'hidden', background: `linear-gradient(145deg,${PALETTE.primary}bb,#BF5AF0aa)`, boxShadow: '0 14px 30px -18px rgba(0,0,0,.65)', display: 'grid', placeItems: 'center' }}>{r.manifest.cover ? <img src={coverUrl(r.manifest.cover)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : <Icon name=\"music.note.list\" size={34} color=\"#fff\" />}</div>\n              <div style={{ marginTop: 9, fontSize: 13.5, fontWeight: 500, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{r.manifest.title || r.manifest.name}</div><div style={{ color: t.textSecondary, fontSize: 11.5 }}>{r.manifest.artist || `${(r.manifest.items || []).length} titres`}</div>\n            </button>)}\n            {!rows.some((r) => r.manifest.type === 'playlist') && <div style={{ color: t.textSecondary, fontSize: 13 }}>Sélectionne des morceaux, puis crée ta première playlist.</div>}\n          </div>\n\n          <h2 style={{ margin: '0 0 8px', fontSize: 19, fontWeight: 500 }}>Titres</h2>\n          {loading && <div style={{ color: t.textSecondary, padding: 14 }}>Chargement…</div>}\n          {rows.filter((r) => r.track).map((r, i) => { const on = selected?.has(r.entry.dir); return <button key={r.entry.dir} onClick={(e) => { if (e.metaKey || e.ctrlKey || e.shiftKey) { const n = new Set(selected || []); n.has(r.entry.dir) ? n.delete(r.entry.dir) : n.add(r.entry.dir); setSelected(n) } else playRow(r) }} style={{ width: '100%', display: 'grid', gridTemplateColumns: '42px minmax(0,1fr) minmax(110px,.6fr) 62px', alignItems: 'center', gap: 11, border: 0, borderTop: `1px solid ${t.border}`, background: on ? PALETTE.primarySoft : 'transparent', color: t.textPrimary, padding: '8px 10px', borderRadius: 10, textAlign: 'left', cursor: 'pointer', fontFamily: FONT }}>\n            <div style={{ width: 38, height: 38, borderRadius: 9, background: 'rgba(128,128,128,.12)', overflow: 'hidden', display: 'grid', placeItems: 'center' }}>{r.track.cover ? <img src={coverUrl(r.track.cover)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : <Icon name=\"music.note\" size={15} color={t.textSecondary} />}</div>\n            <div style={{ minWidth: 0 }}><div style={{ fontSize: 13.5, fontWeight: 500, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{r.track.title}</div><div style={{ fontSize: 11.5, color: t.textSecondary }}>{r.track.artist || 'ZenRay'}</div></div>\n            <div style={{ fontSize: 12, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{r.track.album || r.track.source}</div>\n            <div style={{ fontSize: 11, color: t.textSecondary, textAlign: 'right' }}>{r.track.dur ? `${Math.floor(r.track.dur / 60)}:${String(Math.floor(r.track.dur % 60)).padStart(2, '0')}` : `#${i + 1}`}</div>\n          </button> })}\n          {!loading && !rows.length && <div style={{ color: t.textSecondary, padding: '24px 0' }}>Dépose un fichier audio ou ajoute un album Spotify dans ce dossier.</div>}\n        </div>\n      </section>\n    </div>, document.body)\n}\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/create/CreateMusicPanel.jsx\nM /Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/audio/spotifyApi.js\n"},"completed_at_ms":1784132093331}}
