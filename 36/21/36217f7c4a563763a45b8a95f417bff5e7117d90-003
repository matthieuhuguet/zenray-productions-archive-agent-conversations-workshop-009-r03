l = safeMarkedParse('<img src=x onerror=alert(1)>')\n    expect(html).toContain('&lt;img src=x onerror=alert(1)&gt;')\n    expect(html).not.toContain('<img src=x')\n  })\n\n  it.each([\n    '[x](javascript:alert(1))',\n    '[x](JaVaScRiPt:alert(1))',\n    '[x](java&#x73;cript:alert(1))',\n    '[x](javascript&#58;alert(1))',\n    '[x](java%73cript%3Aalert(1))',\n    '[x](data:text/html,x)',\n    '[x](vbscript:msgbox(1))',\n    '![x](javascript:alert(1))',\n    '![x](data:image/svg+xml,x)',\n  ])('removes dangerous URL attributes from %s', (markdown) => {\n    const html = safeMarkedParse(markdown)\n    expect(html).not.toMatch(/(?:href|src)=\"(?:javascript|data|vbscript):/i)\n  })\n\n  it.each([\n    ['[web](https://example.com/a%20b?x=1&y=2)', 'href=\"https://example.com/a%20b?x=1&amp;y=2\"'],\n    ['[mail](mailto:a@example.com)', 'href=\"mailto:a@example.com\"'],\n    ['[relative](../notes/page)', 'href=\"../notes/page\"'],\n    ['[root](/notes/page)', 'href=\"/notes/page\"'],\n    ['[anchor](#section)', 'href=\"#section\"'],\n    ['![image](/images/a%20b.png)', 'src=\"/images/a%20b.png\"'],\n  ])('keeps approved URL %s', (markdown, expected) => {\n    expect(safeMarkedParse(markdown)).toContain(expected)\n  })\n\n  it('does not allow mailto as an image source', () => {\n    expect(safeMarkedParse('![x](mailto:a@example.com)')).not.toContain('<img')\n  })\n})\ntests/security/doc-access-policy.test.js\n--- tests/security/doc-access-policy.test.js\nimport { afterEach, describe, expect, it, vi } from 'vitest'\nimport docHandler from '../../server/doc.js'\nimport treeHandler from '../../server/tree.js'\nimport {\n  documentRepo,\n  isAllowedDocumentPath,\n  normalizeDocumentPath,\n  visibleDocumentPaths,\n} from '../../server/doc-access-policy.js'\n\nfunction mockResponse() {\n  return {\n    statusCode: 0,\n    body: null,\n    headers: {},\n    status(code) { this.statusCode = code; return this },\n    json(body) { this.body = body; return this },\n    setHeader(name, value) { this.headers[name] = value },\n  }\n}\n\nafterEach(() => {\n  vi.unstubAllEnvs()\n  vi.unstubAllGlobals()\n})\n\ndescribe('document access policy', () => {\n  it('accepts only the declared repositories', () => {\n    expect(documentRepo('memory')?.key).toBe('memory')\n    expect(documentRepo('CLAUDE')?.key).toBe('claude')\n    expect(documentRepo('unknown')).toBeNull()\n  })\n\n  it.each([\n    'Identity/Matthieu1.md',\n    'identity%2FMatthieu1.md',\n    'IDENTITY%252FMatthieu1.md',\n    'Notes/Secrets/API.md',\n    'Credentials.md',\n    'Notes/private.md',\n    '../Identity/Matthieu1.md',\n    '/Identity/Matthieu1.md',\n    'Design/Design1.txt',\n  ])('rejects sensitive or invalid path %s', (path) => {\n    expect(isAllowedDocumentPath(path)).toBe(false)\n  })\n\n  it('canonicalizes safe paths without weakening traversal checks', () => {\n    expect(normalizeDocumentPath('Design\\\\Liquid Glass\\\\Design1.md')).toBe('Design/Liquid Glass/Design1.md')\n    expect(normalizeDocumentPath('Design//Design1.md')).toBeNull()\n    expect(isAllowedDocumentPath('Design/Liquid Glass/Design1.md')).toBe(true)\n  })\n\n  it('filters sensitive entries from the returned tree', () => {\n    expect(visibleDocumentPaths([\n      { type: 'blob', path: 'Notes/Public.md' },\n      { type: 'blob', path: 'Identity/Matthieu1.md' },\n      { type: 'blob', path: 'Notes/Secrets/API.md' },\n      { type: 'tree', path: 'Folder.md' },\n      { type: 'blob', path: 'Notes/file.txt' },\n    ])).toEqual(['Notes/Public.md'])\n  })\n})\n\ndescribe('document endpoints enforce the policy before GitHub', () => {\n  it.each(['Identity/Matthieu1.md', 'Identity%252FMatthieu1.md', 'Notes/Secrets/key.md'])('blocks %s without fetching it', async (path) => {\n    vi.stubEnv('GITHUB_TOKEN', 'test-only')\n    const fetch = vi.fn()\n    vi.stubGlobal('fetch', fetch)\n    const res = mockResponse()\n\n    await docHandler({ query: { repo: 'memory', path } }, res)\n\n    expect(res.statusCode).toBe(403)\n    expect(res.body).toEqual({ markdown: null, error: 'forbidden-path' })\n    expect(fetch).not.toHaveBeenCalled()\n  })\n\n  it('rejects an undeclared repository without falling back to Memory', async () => {\n    vi.stubEnv('GITHUB_TOKEN', 'test-only')\n    const fetch = vi.fn()\n    vi.stubGlobal('fetch', fetch)\n    const res = mockResponse()\n\n    await docHandler({ query: { repo: 'attacker', path: 'README.md' } }, res)\n\n    expect(res.statusCode).toBe(400)\n    expect(fetch).not.toHaveBeenCalled()\n  })\n\n  it('filters a GitHub tree response before returning it', async () => {\n    vi.stubEnv('GITHUB_TOKEN', 'test-only')\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue({\n      ok: true,\n      json: async () => ({ tree: [\n        { type: 'blob', path: 'Design/Design1.md' },\n        { type: 'blob', path: 'Identity/Matthieu1.md' },\n        { type: 'blob', path: 'Secrets/token.md' },\n      ] }),\n    }))\n    const res = mockResponse()\n\n    await treeHandler({ query: { repo: 'memory' } }, res)\n\n    expect(res.statusCode).toBe(200)\n    expect(res.body.files).toEqual(['Design/Design1.md'])\n    expect(res.headers['Cache-Control']).toBe('no-store')\n  })\n})\ntests/setup.js\n--- tests/setup.js\nimport '@testing-library/jest-dom/vitest'\n\nclass ResizeObserverStub {\n  observe() {}\n  unobserve() {}\n  disconnect() {}\n}\n\nif (!globalThis.ResizeObserver) globalThis.ResizeObserver = ResizeObserverStub\n{\n  \"name\": \"zenray-progress\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"description\": \"ZenRayProgress — LifeOS de Matthieu Huguet : tableau de bord d'objectifs + agenda hebdomadaire, persistant.\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"test:music\": \"vitest run src/audio src/create --passWithNoTests\",\n    \"test:e2e\": \"playwright test\",\n    \"predev\": \"nod