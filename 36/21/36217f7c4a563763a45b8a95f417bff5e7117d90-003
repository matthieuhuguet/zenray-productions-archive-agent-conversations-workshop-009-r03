{"timestamp":"2026-07-15T16:14:53.332Z","ordinal":2150,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019f668f-3ac8-7903-9bce-1e4416307172","turn_id":"7c759b9c-8418-4193-9b33-1570726e6686","item":{"type":"FileChange","id":"exec-d1b222a3-3f01-48a7-9086-c25adccb9342","changes":{"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/scripts/upload-audio-list-git.mjs":{"type":"add","content":"#!/usr/bin/env node\n// Public encrypted audio ingestion for Create.\n// Data plane is 100% Git transport; GitHub REST is used once per fresh shard (control plane).\n// Plain chunks are capped at 19 MiB - 16 bytes so AES-GCM ciphertext NEVER exceeds 19 MiB.\n\nimport { createReadStream, existsSync, readFileSync } from 'node:fs'\nimport { mkdir, open, readFile, rm, writeFile } from 'node:fs/promises'\nimport { createHash, randomBytes } from 'node:crypto'\nimport { execFileSync, spawnSync } from 'node:child_process'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport { encryptDeterministic, loadMasterKey, sha256Hex, GIT_ENV } from './lib/img-pipeline.mjs'\nimport { mimeForName } from '../src/lib/fileKinds.js'\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')\nconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\nconst TOKEN = process.env.GITHUB_TOKEN\nconst ZDATA = process.env.ZR_ZDATA_CLONE || path.join(process.env.HOME, '.zr-thumb-bulk', 'zdata-clone')\nconst CAP = Math.floor(4.3 * 1073741824)\nexport const AUDIO_CLEAR_CHUNK_BYTES = 19 * 1024 * 1024 - 16\nconst PUSH_EVERY = 900 * 1024 * 1024\nconst WORK = path.join(process.env.HOME, '.zr-audio-work', `run-${process.pid}-${Date.now().toString(36)}`)\nconst GENV = { ...process.env, ...GIT_ENV }\n\nconst argv = process.argv.slice(2)\nconst dest = argv.shift()\nlet coverFile = ''\nconst files = []\nfor (let i = 0; i < argv.length; i++) {\n  if (argv[i] === '--cover') coverFile = argv[++i] || ''\n  else files.push(argv[i])\n}\nif (!TOKEN || !dest || !dest.startsWith('pages/') || !files.length) {\n  console.error('usage: GITHUB_TOKEN=… node scripts/upload-audio-list-git.mjs \"pages/Music/...\" <audio...> [--cover cover.jpg]')\n  process.exit(2)\n}\nif (!existsSync(path.join(ZDATA, '.git'))) throw new Error(`clone zenray-data absent: ${ZDATA}`)\nfor (const f of files) if (!existsSync(f)) throw new Error(`fichier absent: ${f}`)\nif (coverFile && !existsSync(coverFile)) throw new Error(`pochette absente: ${coverFile}`)\n\nconst git = (dir, args, timeout = 600000) => execFileSync('git', ['-C', dir, ...args], { env: GENV, encoding: 'utf8', timeout, stdio: ['ignore', 'pipe', 'pipe'] })\nconst remote = (repo) => `https://x-access-token:${TOKEN}@github.com/${OWNER}/${repo}.git`\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\nconst hashFile = (f) => new Promise((resolve, reject) => { const h = createHash('sha256'); createReadStream(f).on('data', (b) => h.update(b)).on('error', reject).on('end', () => resolve(h.digest('hex'))) })\nconst safe = (s) => String(s).replace(/[\\\\/:*?\\\"<>|]/g, '-').trim()\nconst guess = (name) => { const b = path.basename(name, path.extname(name)); const m = b.match(/^\\s*(\\d+\\s*[-.]\\s*)?(.+?)\\s*[-–—:]\\s*(.+?)\\s*$/); return m ? { artist: m[2], title: m[3] } : { artist: '', title: b.replace(/^\\d+\\s*[-.]\\s*/, '') } }\nconst probe = (f) => { try { return JSON.parse(execFileSync(process.env.ZR_FFPROBE || '/opt/homebrew/bin/ffprobe', ['-v','error','-show_entries','format=duration:format_tags=title,artist,album,track','-of','json',f], { encoding: 'utf8', timeout: 30000 })) } catch { return {} } }\n\nconst ctx = { repo: '', dir: '', bytes: 0, pending: 0, commits: {}, dirs: [] }\nasync function openShard() {\n  ctx.repo = `zenrayshards-audio-${randomBytes(6).toString('hex')}`\n  ctx.dir = path.join(WORK, ctx.repo); ctx.dirs.push(ctx.dir)\n  await mkdir(ctx.dir, { recursive: true })\n  git(ctx.dir, ['init', '-q']); git(ctx.dir, ['branch', '-M', 'main']); git(ctx.dir, ['config','user.email','bot@zenray']); git(ctx.dir, ['config','user.name','zenray-bot']); git(ctx.dir, ['config','http.version','HTTP/1.1']); git(ctx.dir, ['config','http.postBuffer','524288000'])\n  await writeFile(path.join(ctx.dir, 'README.md'), '# ZenRayShards Audio\\n\\nAES-256-GCM encrypted, content-addressed audio chunks. No human filenames.\\n')\n  const cr = spawnSync('curl', ['-s','-o','/dev/null','-w','%{http_code}','-X','POST','-H',`Authorization: Bearer ${TOKEN}`,'https://api.github.com/user/repos','-d',JSON.stringify({ name: ctx.repo, private: false })], { encoding: 'utf8' })\n  if ((cr.stdout || '').trim() !== '201') throw new Error(`création ${ctx.repo}: HTTP ${cr.stdout || '?'}`)\n  git(ctx.dir, ['add','README.md']); git(ctx.dir, ['commit','-q','-m','init']); git(ctx.dir, ['remote','add','origin',remote(ctx.repo)]); git(ctx.dir, ['push','-q','origin','HEAD:main'], 180000)\n  ctx.bytes = 0; ctx.pending = 0\n  console.log(`  repo public chiffré ${ctx.repo}`)\n}\nasync function pushShard() {\n  if (!git(ctx.dir, ['status','--porcelain']).trim()) { ctx.commits[ctx.repo] = git(ctx.dir, ['rev-parse','HEAD']).trim(); return }\n  git(ctx.dir, ['add','-A']); git(ctx.dir, ['commit','-q','-m','+audio'])\n  for (let a = 0; a < 8; a++) {\n    try { git(ctx.dir, ['push','-q','origin','HEAD:main'], 1200000); ctx.commits[ctx.repo] = git(ctx.dir, ['rev-parse','HEAD']).trim(); ctx.pending = 0; return }\n    catch (e) { if (a === 7) throw e; await sleep(2500 * (a + 1)) }\n  }\n}\nasync function writeCipher(hashedPath, cipher) {\n  if (!ctx.repo) await openShard()\n  if (ctx.bytes && ctx.bytes + cipher.length > CAP) { await pushShard(); await openShard() }\n  const out = path.join(ctx.dir, hashedPath); await mkdir(path.dirname(out), { recursive: true }); await writeFile(out, cipher)\n  const repo = ctx.repo; ctx.bytes += cipher.length; ctx.pending += cipher.length\n  if (ctx.pending >= PUSH_EVERY) await pushShard()\n  return repo\n}\n\nconst key = loadMasterKey(RO