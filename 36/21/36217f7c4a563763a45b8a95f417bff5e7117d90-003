o', ui-monospace, monospace\" }\nconst fmt = (s) => { if (!s && s !== 0) return '0:00'; const m = Math.floor(s / 60); const ss = Math.floor(s % 60); return `${m}:${ss < 10 ? '0' : ''}${ss}` }\nconst trackKey = (tr) => (tr ? (tr.streamPath || tr.path || tr.uri || '') : '')\nconst localUrl = (tr) => {\n  if (!tr) return null\n  if (tr.streamPath) return `/api/stream?path=${encodeURIComponent(tr.streamPath)}`\n  if (tr.path && tr.path.endsWith('.media.json')) return `/api/stream?path=${encodeURIComponent(tr.path)}`\n  if (tr.path) return `/api/img?path=${encodeURIComponent(tr.path)}`\n  return null\n}\nconst RATES = [0.5, 0.75, 1, 1.25, 1.5, 2]\n\n// Cache module des waveforms calculées (clé = identité de piste). Évite de recalculer/retélécharger\n// quand on revient sur une piste déjà analysée.\nconst _wfCache = new Map()\nconst WF_CAP_BYTES = 48 * 1024 * 1024 // plafond sécurité du décodage (pistes très longues)\n\n// Récupère le fichier audio COMPLET en mémoire. /api/stream borne chaque réponse à 4 Mo (MAX_WINDOW),\n// donc un fetch nu reçoit un buffer tronqué que decodeAudioData rejette -> la waveform n'apparaît\n// JAMAIS sur les vrais fichiers (>4 Mo). On enchaîne des Range bytes=offset- jusqu'à couvrir la taille\n// totale (lue dans le Content-Range du 1er 206), puis on concatène. /api/img renvoie tout d'un coup.\nasync function fetchFullBuffer(url) {\n  const isStream = url.indexOf('/api/stream') !== -1\n  if (!isStream) return await fetch(url).then((r) => r.arrayBuffer())\n  const parts = []\n  let offset = 0, total = Infinity\n  while (offset < total) {\n    const r = await fetch(url, { headers: { Range: `bytes=${offset}-` } })\n    if (!r.ok && r.status !== 206 && r.status !== 200) break\n    const cr = r.headers.get('Content-Range')\n    if (cr) { const mt = /\\/(\\d+)\\s*$/.exec(cr); if (mt) total = parseInt(mt[1], 10) }\n    const buf = await r.arrayBuffer()\n    if (!buf.byteLength) break\n    parts.push(buf)\n    offset += buf.byteLength\n    if (r.status === 200 || !cr) break // serveur a tout renvoyé d'un coup\n    if (offset > WF_CAP_BYTES) break    // sécurité : on ne télécharge pas indéfiniment\n  }\n  if (parts.length === 1) return parts[0]\n  const totalLen = parts.reduce((n, p) => n + p.byteLength, 0)\n  const out = new Uint8Array(totalLen)\n  let pos = 0\n  for (const p of parts) { out.set(new Uint8Array(p), pos); pos += p.byteLength }\n  return out.buffer\n}\n\n// Décode le fichier et réduit l'onde en `bars` valeurs 0..1 (RMS par tranche). Best-effort.\nasync function computeWaveform(url, bars = 160) {\n  try {\n    const buf = await fetchFullBuffer(url)\n    const AC = window.AudioContext || window.webkitAudioContext\n    if (!AC) return null\n    const ctx = new AC()\n    const audioBuf = await ctx.decodeAudioData(buf)\n    const data = audioBuf.getChannelData(0)\n    const block = Math.floor(data.length / bars) || 1\n    const peaks = new Array(bars).fill(0)\n    let max = 0\n    for (let i = 0; i < bars; i++) {\n      let sum = 0\n      const startI = i * block\n      for (let j = 0; j < block; j++) { const v = data[startI + j] || 0; sum += v * v }\n      const rms = Math.sqrt(sum / block)\n      peaks[i] = rms\n      if (rms > max) max = rms\n    }\n    ctx.close && ctx.close()\n    return max > 0 ? peaks.map((p) => p / max) : peaks\n  } catch { return null }\n}\n\n// Waveform cliquable. Reçoit le tableau de pics (ou null), le ratio de progression et un onSeek(frac).\nfunction Waveform({ peaks, progress, onSeek, accent, dark }) {\n  const ref = useRef(null)\n  const idle = dark ? 'rgba(236,236,234,0.28)' : 'rgba(31,31,30,0.22)'\n  const handleClick = (e) => {\n    const el = ref.current\n    if (!el) return\n    const rect = el.getBoundingClientRect()\n    const frac = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width))\n    onSeek(frac)\n  }\n  // Repli barre simple si l'analyse a échoué.\n  if (!peaks) {\n    return (\n      <div ref={ref} onClick={handleClick} style={{ height: 40, borderRadius: 8, background: idle, cursor: 'pointer', position: 'relative', overflow: 'hidden' }}>\n        <div style={{ position: 'absolute', inset: 0, width: `${progress * 100}%`, background: accent, transition: 'width 0.1s linear' }} />\n      </div>\n    )\n  }\n  return (\n    <div ref={ref} onClick={handleClick}\n      style={{ height: 48, display: 'flex', alignItems: 'center', gap: 2, cursor: 'pointer' }}>\n      {peaks.map((p, i) => {\n        const played = i / peaks.length <= progress\n        const h = Math.max(3, p * 44)\n        return <div key={i} style={{ flex: 1, height: h, borderRadius: 2, background: played ? accent : idle, transition: 'background 0.08s' }} />\n      })}\n    </div>\n  )\n}\n\n// `compact` : variante réduite (pas de waveform, juste transport + barre) pour un usage inline éventuel.\nexport default function AudioPlayer({ dark = true, compact = false }) {\n  const p = usePlayer()\n  const [peaks, setPeaks] = useState(null)\n  const wfKeyRef = useRef('')\n\n  const now = p && p.current\n  const isLocal = now && now.source !== 'spotify'\n  const key = trackKey(now)\n\n  // (Re)calcule la waveform quand la piste locale change. Spotify n'expose pas le PCM -> pas de waveform.\n  useEffect(() => {\n    if (!isLocal || !now) { setPeaks(null); return }\n    const url = localUrl(now)\n    if (!url) { setPeaks(null); return }\n    wfKeyRef.current = key\n    let alive = true\n    if (_wfCache.has(key)) { setPeaks(_wfCache.get(key)); return () => { alive = false } }\n    setPeaks(null)\n    computeWaveform(url).then((pk) => {\n      if (pk) { if (_wfCache.size >= 100) _wfCache.delete(_wfCache.keys().next().value); _wfCache.set(key, pk) }\n      if (alive && wfKeyRef.current === key) setPeaks(pk)\n    })\n    return () => { alive = false }\n  }, [key, isLocal]) // eslint-disable-line\n\n  if (!p) return null\n  const accent = PALETTE.primary\n  const text = dark ? '#ECECEA' : '#1F1F1E'\n  const sub = dark ? 'rgba(236,236,234,0.6)' : 'rgba(31,31,30,0.55)'\n  const panel = dark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)'\n  const progress = p.dur ? p.time / p.dur : 0\n\n  const btn = (active) => ({ background: 'transparent', border: 'none', color: active ? accent : text, cursor: 'pointer', fontSize: 18, display: 'grid', placeItems: 'center', padding: 4 })\n  const cycleRate = () => { const i = RATES.indexOf(p.rate); p.setRate(RATES[(i + 1) % RATES.length]) }\n\n  if (!now) {\n    return <div style={{ color: sub, fontFamily: FONTS.sans, padding: 20, textAlign: 'center' }}>Aucune piste en lecture. Choisis un titre.</div>\n  }\n\n  return (\n    <div style={{ background: panel, borderRadius: 14, padding: compact ? '10px 14px' : 16, fontFamily: FONTS.sans, color: text, display: 'flex', flexDirection: 'column', gap: 12 }}>\n      <div style={{ display: 'flex', alignItems: 'center', gap: 12, minWidth: 0 }}>\n        <div style={{ flex: '0 0 48px', width: 48, height: 48, borderRadius: 8, background: dark ? '#333' : '#ddd', overflow: 'hidden', display: 'grid', placeItems: 'center', fontSize: 20 }}>\n          {now.cover ? <img src={now.source === 'spotify' ? now.cover : `/api/img?path=${encodeURIComponent(now.cover)}`} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : '♪'}\n        </div>\n        <div style={{ minWidth: 0, flex: 1 }}>\n          <div style={{ fontSize: 14, fontWeight: 600, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{now.title || (key || '').split('/').pop()}</div>\n          <div style={{ fontSize: 12, color: sub, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{now.artist || '—'}</div>\n        </div>\n        {isLocal && (\n          <button onClick={cycleRate} title=\"Vitesse de lecture\" style={{ background: 'transparent', border: `1px solid ${sub}`, color: text, borderRadius: 99, padding: '3px 10px', fontSize: 12, fontFamily: FONTS.mono, cursor: 'pointer' }}>{p.rate}×</button>\n        )}\n      </div>\n\n      {!compact && isLocal && (\n        <Waveform peaks={peaks} progress={progress} onSeek={(f) => p.seek(f)} accent={accent} dark={dark} />\n      )}\n\n      <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>\n        <span style={{ fontFamily: FONTS.mono, fontSize: 10, color: sub, flex: '0 0 36px', textAlign: 'right' }}>{fmt(p.time)}</span>\n        <input type=\"range\" min={0} max={1000} value={progress * 1000} onChange={(e) => p.seek(e.target.value / 1000)} style={{ flex: 1, accentColor: accent, cursor: 'pointer' }} />\n        <span style={{ fontFamily: FONTS.mono, fontSize: 10, color: sub, flex: '0 0 36px' }}>{fmt(p.dur)}</span>\n      </div>\n\n      <div style={{ display: 'flex', alignItems: 'center', gap: 16, justifyContent: 'center' }}>\n        <button onClick={() => p.setShuffle(!p.shuffle)} title=\"Aléatoire\" style={btn(p.shuffle)}>🔀</button>\n        <button onClick={() => p.prev()} title=\"Précédent\" style={btn(false)}>⏮</button>\n        <button onClick={() => p.toggle()} title={p.playing ? 'Pause' : 'Lecture'} style={{ background: text, color: dark ? '#1F1F1E' : '#FDFDFC', border: 'none', cursor: 'pointer', width: 40, height: 40, borderRadius: 99, fontSize: 16, display: 'grid', placeItems: 'center' }}>{p.playing ? '⏸' : '▶'}</button>\n        <button onClick={() => p.next()} title=\"Suivant\" style={btn(false)}>⏭</button>\n        <button onClick={() => p.setRepeat(p.repeat === 'off' ? 'all' : p.repeat === 'all' ? 'one' : 'off')} title=\"Répéter\" style={btn(p.repeat !== 'off')}>{p.repeat === 'one' ? '🔂' : '🔁'}</button>\n        <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginLeft: 8 }}>\n          <span style={{ color: sub, fontSize: 13 }}>🔊</span>\n          <input type=\"range\" min={0} max={1} step={0.01} value={p.vol} onChange={(e) => p.setVol(parseFloat(e.target.value))} style={{ width: 80, accentColor: accent, cursor: 'pointer' }} />\n        </div>\n      </div>\n    </div>\n  )\n}\n"},"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/components/Audio.jsx":{"type":"delete","content":"import React, { useEffect, useState, useRef, useMemo } from 'react'\nimport { PALETTE, RADII } from '../theme.js'\nimport Icon from './Icon.jsx'\nimport { usePlayer } from '../audio/PlayerContext.jsx'\nimport AudioPlayer from '../audio/AudioPlayer.jsx'\nimport { login, isLoggedIn, logout, hasConfig } from '../audio/spotifyAuth.js'\nimport { me, myPlaylists, search } from '../audio/spotifyApi.js'\nimport { isFav, toggleFav, useFavorites } from '../audio/favorites.js'\nimport { saveJsonWithRetry } from '../lib/saveJson.js'\n\nconst Heart = ({ tr, fav }) => <button onClick={(e) => { e.stopPropagation(); toggleFav(tr) }} title=\"Favori\" style={{ background: 'transparent', border: 'none', cursor: 'pointer', color: fav ? '#1db954' : '#777', fontSize: 14, padding: '0 4px' }}>{fav ? '♥' : '♡'}</button>\n\n// C64/C66 — onglet Audio = Spotify 1:1 + 3 sous-menus. Le lecteur est GLOBAL (PlayerContext) : la musique survit aux changements d'onglet.\nconst FONTS = { sans: \"'AnthropicSans', sans-serif\", serif: \"'AnthropicSerif', Georgia, serif\", mono: \"'AnthropicMono', ui-monospace, monospace\" }\nconst MANIFEST = 'audio/manifest.json'\nconst C = { bg: '#121212', panel: '#181818', panelHi: '#282828', text: '#FFFFFF', sub: '#B3B3B3', accent: PALETTE.primary }\nconst fmt = (s) => { if (!s && s !== 0) return '—'; const m = Math.floor(s / 60); const ss = Math.floor(s % 60); return `${m}:${ss < 10 ? '0' : ''}${ss}` }\nconst src = (p) => `/api/img?path=${encodeURIComponent(p)}`\n// Clé d'identité d'une piste, commune à toutes les vues (streamPath chunké, sinon path plat, sinon uri Spotify).\nconst trackId = (x) => x && (x.streamPath || x.path || x.uri)\nconst SFX_MIME = { mp3: 'audio/mpeg', m4a: 'audio/mp4', wav: 'audio/wav', ogg: 'audio/ogg', oga: 'audio/ogg', opus: 'audio/opus', flac: 'audio/flac' }\n\nexport default function Audio({ t }) {\n  const [tracks, setTracks] = useState(null)\n  const [q, setQ] = useState('')\n  const [sub, setSub] = useState('music') // music | spotify | sfx | fav\n  const player = usePlayer()\n  const favs = useFavorites()\n\n  useEffect(() => { (async () => {\n    const j = await fetch(`/api/page?action=read&path=${MANIFEST}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n    if (j && j.markdown && !j.missing) { try { setTracks((JSON.parse(j.markdown).tracks || []).map((x) => ({ ...x, source: 'local' }))) } catch { setTracks([]) } }\n    else setTracks([])\n  })() }, [])\n\n  const [msort, setMsort] = useState({ key: '', dir: 'asc' })\n  const list = tracks || []\n  // Liste filtrée + triée memoïsée : ne se recalcule que si tracks/recherche/tri changent (pas a chaque render).\n  const filtered = useMemo(() => {\n    const base = tracks || []\n    let f = q.trim() ? base.filter((x) => `${x.title} ${x.artist} ${x.album}`.toLowerCase().includes(q.toLowerCase())) : base\n    if (msort.key) f = [...f].sort((a, b) => { const x = a[msort.key] ?? '', y = b[msort.key] ?? ''; const r = msort.key === 'dur' ? (x - y) : String(x).localeCompare(String(y)); return msort.dir === 'desc' ? -r : r })\n    return f\n  }, [tracks, q, msort.key, msort.dir])\n  const sortCol = (key) => setMsort((s) => s.key === key ? { key, dir: s.dir === 'asc' ? 'desc' : 'asc' } : { key, dir: 'asc' })\n  const arrow = (key) => msort.key === key ? (msort.dir === 'asc' ? ' ↑' : ' ↓') : ''\n  const now = player.current\n  const tk = trackId\n  const isOn = (tr) => !!now && tk(now) === tk(tr)\n  const trName = (tr) => tr.title || ((tr.streamPath || tr.path || '').split('/').pop() || '').replace(/\\.[a-z0-9]+\\.media\\.json$/i, '')\n\n  const SubTab = ({ id, label }) => (\n    <button onClick={() => setSub(id)} style={{ padding: '6px 16px', borderRadius: 99, border: 'none', cursor: 'pointer', background: sub === id ? '#fff' : 'transparent', color: sub === id ? '#000' : C.sub, fontFamily: FONTS.sans, fontSize: 13, fontWeight: 600 }}>{label}</button>\n  )\n\n  return (\n    <div style={{ background: C.bg, color: C.text, borderRadius: RADII.lg, overflow: 'hidden', display: 'flex', flexDirection: 'column', height: 'calc(100vh - 130px)', minHeight: 460, fontFamily: FONTS.sans }}>\n      <div style={{ flex: 1, display: 'flex', minHeight: 0 }}>\n        {/* Bibliothèque (sidebar Spotify) */}\n        <div style={{ flex: '0 0 220px', background: '#000', padding: 16, display: 'flex', flexDirection: 'column', gap: 8, overflowY: 'auto' }}>\n          <div style={{ fontFamily: FONTS.serif, fontSize: 20, fontWeight: 700, marginBottom: 6 }}>Audio</div>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>\n            {[['music', 'Music'], ['spotify', 'Spotify'], ['sfx', 'SFX'], ['fav', '♥ Favoris']].map(([id, lbl]) => (\n              <button key={id} onClick={() => setSub(id)} style={{ textAlign: 'left', color: sub === id ? C.text : C.sub, fontWeight: sub === id ? 700 : 600, fontSize: 14, padding: '6px 8px', borderRadius: 6, background: sub === id ? '#1f1f1f' : 'transparent', border: 'none', cursor: 'pointer', fontFamily: FONTS.sans }}>{lbl}</button>\n            ))}\n          </div>\n          <div style={{ marginTop: 'auto', fontSize: 10, color: C.sub, fontFamily: FONTS.mono }}>cloud GitHub · {list.length} piste(s)</div>\n        </div>\n\n        {/* Centre */}\n        <div style={{ flex: 1, minWidth: 0, background: `linear-gradient(180deg, ${C.panelHi} 0%, ${C.bg} 220px)`, display: 'flex', flexDirection: 'column', minHeight: 0 }}>\n          <div style={{ padding: '16px 24px 6px', display: 'flex', alignItems: 'center', gap: 12, flexWrap: 'wrap' }}>\n            <div style={{ display: 'inline-flex', gap: 4, background: '#0a0a0a', borderRadius: 99, padding: 4 }}>\n              <SubTab id=\"music\" label=\"Music\" /><SubTab id=\"spotify\" label=\"Spotify\" /><SubTab id=\"sfx\" label=\"SFX\" /><SubTab id=\"fav\" label=\"♥\" />\n            </div>\n            {sub === 'music' && <input value={q} onChange={(e) => setQ(e.target.value)} placeholder=\"Rechercher…\" style={{ marginLeft: 'auto', background: '#2a2a2a', color: C.text, border: 'none', borderRadius: 99, padding: '8px 14px', fontSize: 13, outline: 'none', width: 220, maxWidth: '45%' }} />}\n          </div>\n\n          <div style={{ flex: 1, overflowY: 'auto', padding: '6px 16px 18px' }}>\n            {sub === 'music' && (<>\n              {tracks === null && <div style={{ color: C.sub, padding: 20 }}>chargement…</div>}\n              {tracks && filtered.length === 0 && <div style={{ color: C.sub, padding: 24, lineHeight: 1.6 }}><b style={{ color: C.text }}>Bibliothèque vide.</b><br />Les pistes vivent dans <code style={{ fontFamily: FONTS.mono }}>audio/</code> (cloud GitHub), indexées dans <code style={{ fontFamily: FONTS.mono }}>audio/manifest.json</code>.</div>}\n              {filtered.length > 0 && (\n                <div style={{ display: 'grid', gridTemplateColumns: '28px 1fr 1fr 84px', gap: 8, padding: '0 12px 8px', color: C.sub, fontSize: 11, textTransform: 'uppercase', letterSpacing: 1, borderBottom: '1px solid #282828' }}>\n                  <div>#</div><div onClick={() => sortCol('title')} style={{ cursor: 'pointer' }}>Titre{arrow('title')}</div><div onClick={() => sortCol('album')} style={{ cursor: 'pointer' }}>Album{arrow('album')}</div><div onClick={() => sortCol('dur')} style={{ textAlign: 'right', cursor: 'pointer' }}>⏱{arrow('dur')}</div>\n                </div>\n              )}\n              {filtered.map((tr, i) => {\n                const active = isOn(tr)\n                return (\n                  <div key={tk(tr) || i} onClick={() => player.playQueue(filtered, i)} style={{ display: 'grid', gridTemplateColumns: '28px 1fr 1fr 84px', gap: 8, alignItems: 'center', padding: '8px 12px', borderRadius: 6, cursor: 'pointer', color: active ? C.accent : C.text, background: active ? 'rgba(255,255,255,0.06)' : 'transparent' }}\n                    onMouseEnter={(e) => { if (!active) e.currentTarget.style.background = 'rgba(255,255,255,0.04)' }} onMouseLeave={(e) => { if (!active) e.currentTarget.style.background = 'transparent' }}>\n                    <div style={{ color: C.sub, fontFamily: FONTS.mono, fontSize: 12 }}>{active && player.playing ? '▶' : i + 1}</div>\n                    <div style={{ display: 'flex', alignItems: 'center', gap: 10, minWidth: 0 }}>\n                      <div style={{ flex: '0 0 36px', width: 36, height: 36, borderRadius: 4, background: '#333', overflow: 'hidden' }}>{tr.cover && <img src={src(tr.cover)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}</div>\n                      <div style={{ minWidth: 0 }}>\n                        <div style={{ fontSize: 14, fontWeight: 600, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{trName(tr)}</div>\n                        <div style={{ fontSize: 12, color: C.sub, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{tr.artist || '—'}</div>\n                      </div>\n                    </div>\n                    <div style={{ fontSize: 13, color: C.sub, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{tr.album || '—'}</div>\n                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'flex-end', gap: 4, fontFamily: FONTS.mono, fontSize: 12, color: C.sub }}><Heart tr={tr} fav={isFav(tr)} />{fmt(tr.dur)}</div>\n                  </div>\n                )\n              })}\n            </>)}\n\n            {sub === 'fav' && (\n              <div>\n                {favs.length === 0 && <div style={{ color: C.sub, padding: 24 }}>Aucun favori. Clique sur ♡ pour en ajouter (Music ou Spotify).</div>}\n                {favs.map((tr) => (\n                  <div key={tr.uri || tr.path} onClick={() => tr.source === 'spotify' ? player.playSpotify([tr.uri]) : player.playTrack(tr)} style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '8px 12px', borderRadius: 6, cursor: 'pointer', color: C.text }} onMouseEnter={(e) => e.currentTarget.style.background = 'rgba(255,255,255,0.05)'} onMouseLeave={(e) => e.currentTarget.style.background = 'transparent'}>\n                    <div style={{ flex: '0 0 38px', width: 38, height: 38, borderRadius: 4, background: '#333', overflow: 'hidden' }}>{tr.cover && <img src={tr.source === 'spotify' ? tr.cover : src(tr.cover)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}</div>\n                    <div style={{ minWidth: 0, flex: 1 }}><div style={{ fontSize: 14, fontWeight: 600, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{tr.title}</div><div style={{ fontSize: 12, color: C.sub }}>{tr.artist || '—'} · {tr.source}</div></div>\n                    <Heart tr={tr} fav />\n                  </div>\n                ))}\n              </div>\n            )}\n\n            {sub === 'spotify' && <SpotifyView />}\n            {sub === 'sfx' && <SfxView />}\n          </div>\n        </div>\n      </div>\n\n      {/* Barre lecteur réutilisable (waveform + vitesse) — consomme le PlayerContext global */}\n      <div style={{ flex: '0 0 auto', background: C.panel, borderTop: '1px solid #282828', padding: 12 }}>\n        <AudioPlayer dark compact={!now} />\n      </div>\n    </div>\n  )\n}\n\n// C79/C84 — gestionnaire SFX type Soundly : upload audio, tags éditables, recherche, durée, preview instantanée\n// (survol + ESPACE) sans casser la lecture normale (clic = lecteur global). Modèle de stockage inchangé :\n// /api/img (dir:'sfx', dataURL) + index append-compatible dans sfx/manifest.json {path,name,tags,dur}.\nconst SFX_MAX_BYTES = 50 * 1024 * 1024 // garde-fou : le dataURL charge TOUT le fichier en mémoire.\nconst sfxMime = (p) => SFX_MIME[(p || '').split('.').pop().toLowerCase()] || undefined\n\nfunction SfxView() {\n  const player = usePlayer()\n  const [sfx, setSfx] = useState(null)\n  const [sha, setSha] = useState(null)\n  const [tag, setTag] = useState(null)\n  const [over, setOver] = useState(false)\n  const [status, setStatus] = useState('')\n  const [q, setQ] = useState('')                 // recherche par nom\n  const [prog, setProg] = useState(null)          // { name, pct } pendant l'upload\n  const [editing, setEditing] = useState(null)    // path du son en cours de renommage\n  const [draft, setDraft] = useState('')          // valeur du champ de renommage\n  const [tagFor, setTagFor] = useState(null)      // path du son dont on édite les tags\n  const [newTag, setNewTag] = useState('')        // saisie d'un nouveau tag\n  const [preview, setPreview] = useState(null)    // path du son en preview (survol/ESPACE)\n  const prev = useRef(null)                        // <audio> dédié à la preview (n'altère PAS le lecteur global)\n\n  useEffect(() => { fetch('/api/page?action=read&path=sfx/manifest.json', { cache: 'no-store' }).then((r) => r.json()).then((j) => { if (j && j.markdown && !j.missing) { setSha(j.sha); try { setSfx(JSON.parse(j.markdown).sfx || []) } catch { setSfx([]) } } else setSfx([]) }).catch(() => setSfx([])) }, [])\n\n  // Mutation persistée du manifeste, par IDENTITÉ (path). Met à jour l'état local optimiste puis sauvegarde\n  // avec retry anti-conflit (saveJsonWithRetry rejoue `mutate` sur l'état frais du drive). Append-compatible.\n  const persist = async (mutate, okMsg) => {\n    const local = mutate(sfx || [])\n    setSfx(local)\n    const res = await saveJsonWithRetry('sfx/manifest.json', (cur) => ({ ...cur, sfx: mutate(cur.sfx || []) }), { sha, data: { sfx: sfx || [] } })\n    if (res.ok) { setSha(res.sha); setSfx(res.data.sfx || []); if (okMsg) setStatus(okMsg) } else setStatus('conflit — recharge et réessaie')\n  }\n\n  const add = async (files) => {\n    const list = [...files].filter((f) => f.type && f.type.startsWith('audio/'))\n    if (!list.length) return\n    const tooBig = list.find((f) => f.size > SFX_MAX_BYTES)\n    if (tooBig && !window.confirm(`\"${