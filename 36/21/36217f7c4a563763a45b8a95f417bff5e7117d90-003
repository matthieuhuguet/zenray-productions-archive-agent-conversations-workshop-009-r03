er', fontSize: 13, fontWeight: 600 }}>Ouvrir</button>\n    59\t    </div>\n    60\t  )\n    61\t}\n     1\timport React, { useEffect, useState, useRef } from 'react'\n     2\timport '@blocknote/mantine/style.css'\n     3\timport { useCreateBlockNote } from '@blocknote/react'\n     4\timport { BlockNoteView } from '@blocknote/mantine'\n     5\timport { PALETTE, RADII } from '../theme.js'\n     6\timport { fileToWebp } from '../api.js'\n     7\timport { saveJsonWithRetry } from '../lib/saveJson.js'\n     8\timport { PUBLISH, liveUrlFor, slugify as cfgSlugify } from '../config/publish.js'\n     9\t\n    10\t// C91/C92/C93/C95/C99 — éditeur d'articles (Word+InDesign+Notion) + brouillons + publication sur ZenRayWebsite (branche only).\n    11\tconst FONTS = { serif: \"'AnthropicSerif', Georgia, serif\", sans: \"'AnthropicSans', sans-serif\", mono: \"'AnthropicMono', monospace\" }\n    12\tconst INDEX = 'articles/index.json'\n    13\tconst THEMES = { dark: { bg: '#121212', fg: '#fff', sub: '#aaa' }, grey: { bg: '#2b2b2b', fg: '#f0f0f0', sub: '#bbb' }, white: { bg: '#ffffff', fg: '#1a1a1a', sub: '#666' } }\n    14\tconst FONT_OPTS = [['serif', 'Serif'], ['sans', 'Sans'], ['mono', 'Mono']]\n    15\tconst RATIOS = [['free', 'Libre', null], ['1:1', '1:1', '1/1'], ['4:5', '4:5', '4/5'], ['16:9', '16:9', '16/9'], ['9:16', '9:16', '9/16']]\n    16\tconst slugify = cfgSlugify\n    17\tconst rd = (path) => fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n    18\tconst wr = (path, md, sha) => fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path, markdown: md, sha }) }).then((r) => r.json()).catch(() => null)\n    19\t\n    20\texport default function Articles({ t, onPublished }) {\n    21\t  const [index, setIndex] = useState(null)\n    22\t  const idxSha = useRef(null)\n    23\t  const [editId, setEditId] = useState(null)\n    24\t  const loadIndex = () => rd(INDEX).then((j) => { if (j && j.markdown && !j.missing) { idxSha.current = j.sha; try { setIndex(JSON.parse(j.markdown).items || []) } catch { setIndex([]) } } else setIndex([]) })\n    25\t  useEffect(() => { loadIndex() }, [])\n    26\t  // ANTI-PERTE : saveIndex prend une MUTATION sur la liste d'items (par id), ré-appliquée sur l'index FRAIS du\n    27\t  // drive en cas de conflit (retry). Plus d'écrasement de l'index par un onglet concurrent.\n    28\t  const saveIndex = async (mutateItems) => {\n    29\t    const res = await saveJsonWithRetry(INDEX, (cur) => ({ ...cur, items: mutateItems(cur.items || []) }), { sha: idxSha.current, data: { items: index || [] } })\n    30\t    if (res.ok) { idxSha.current = res.sha; setIndex(res.data.items) }\n    31\t  }\n    32\t  const newArticle = () => { const id = 'a' + Date.now().toString(36); const item = { id, title: 'Nouvel article', slug: '', status: 'draft', updatedAt: Date.now() }; setIndex([item, ...(index || [])]); saveIndex((items) => [item, ...items.filter((x) => x.id !== id)]); setEditId(id) }\n    33\t\n    34\t  if (editId) return <ArticleEditor t={t} id={editId} onPublished={onPublished} onBack={() => { setEditId(null); loadIndex() }} onMeta={(meta) => saveIndex((items) => items.some((x) => x.id === meta.id) ? items.map((x) => x.id === meta.id ? { ...x, ...meta } : x) : [{ ...meta }, ...items])} />\n    35\t\n    36\t  return (\n    37\t    <>\n    38\t      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 14 }}>\n    39\t        <span style={{ fontFamily: FONTS.serif, fontSize: 22, fontWeight: 700, color: t.textPrimary }}>Articles</span>\n    40\t        <span style={{ fontFamily: FONTS.mono, fontSize: 10, color: t.textSecondary }}>brouillons · publication sur matthieuhuguet.com/reels</span>\n    41\t        <button onClick={newArticle} style={{ marginLeft: 'auto', background: PALETTE.primary, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '7px 16px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 13, fontWeight: 600 }}>+ Nouvel article</button>\n    42\t      </div>\n    43\t      {index === null && <div style={{ color: t.textSecondary }}>chargement…</div>}\n    44\t      {index && index.length === 0 && <div style={{ color: t.textSecondary, padding: 20 }}>Aucun article. Crée le premier.</div>}\n    45\t      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(220px,1fr))', gap: 12 }}>\n    46\t        {(index || []).map((a) => (\n    47\t          <div key={a.id} onClick={() => setEditId(a.id)} style={{ background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, padding: 14, cursor: 'pointer' }}>\n    48\t            <div style={{ fontFamily: FONTS.serif, fontWeight: 600, fontSize: 15, color: t.textPrimary, marginBottom: 4 }}>{a.title}</div>\n    49\t            <div style={{ fontFamily: FONTS.mono, fontSize: 10.5, color: a.status === 'live' ? PALETTE.green : (a.status && a.status !== 'draft') ? PALETTE.primary : t.textSecondary }}>{statusLabel(a.status, a.slug)}</div>\n    50\t          </div>\n    51\t        ))}\n    52\t      </div>\n    53\t    </>\n    54\t  )\n    55\t}\n    56\t\n    57\tfunction ArticleEditor({ t, id, onBack, onMeta, onPublished }) {\n    58\t  const path = `articles/${id}.article.json`\n    59\t  const sha = useRef(null)\n    60\t  const [meta, setMeta] = useState({ title: '', slug: '', theme: 'white', font: 'serif', size: 17, ratio: 'free', status: 'draft' })\n    61\t  const metaRef = useRef(meta)\n    62\t  const liveRef = useRef(true)\n    63\t  const saveTimer = useRef(null)\n    64\t  const pendingExtra = useRef(null)\n    65\t  const saveChain = useRef(Promise.resolve())\n    66\t  const saveSeq = useRef(0)\n    67\t  const [status, setStatus] = useState('chargement…')\n    68\t  const [ready, setReady] = useState(false)\n    69\t  const editor = useCreateBlockNote({\n    70\t    uploadFile: async (file) => { const webp = await fileToWebp(file, 0.95, Infinity).catch(() => null); const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl: webp }) }).then((r) => r.json()).catch(() => null); return (j && j.url) || webp },\n    71\t  })\n    72\t  useEffect(() => { metaRef.current = meta }, [meta])\n    73\t  useEffect(() => {\n    74\t    let live = true\n    75\t    let readyTimer = null\n    76\t    liveRef.current = true\n    77\t    setReady(false)\n    78\t    setStatus('chargement…')\n    79\t    ;(async () => {\n    80\t    const j = await rd(path)\n    81\t    if (!live) return\n    82\t    if (j && j.markdown && !j.missing) {\n    83\t      sha.current = j.sha\n    84\t      try {\n    85\t        const d = JSON.parse(j.markdown)\n    86\t        if (!live) return\n    87\t        const nextMeta = { ...metaRef.current, ...d, status: d.status || 'draft' }\n    88\t        metaRef.current = nextMeta\n    89\t        setMeta(nextMeta)\n    90\t        if (Array.isArray(d.blocks) && d.blocks.length) editor.replaceBlocks(editor.document, d.blocks)\n    91\t      } catch {}\n    92\t    }\n    93\t    if (!live) return\n    94\t    setStatus('')\n    95\t    readyTimer = setTimeout(() => { if (live) setReady(true) }, 300)\n    96\t    })()\n    97\t    return () => {\n    98\t      live = false\n    99\t      liveRef.current = false\n   100\t      if (readyTimer) clearTimeout(readyTimer)\n   101\t      if (saveTimer.current) {\n   102\t        clearTimeout(saveTimer.current)\n   103\t        saveTimer.current = null\n   104\t        const patch = pendingExtra.current || {}\n   105\t        pendingExtra.current = null\n   106\t        save(patch, { quiet: true })\n   107\t      }\n   108\t    }\n   109\t  }, [id, path, editor])\n   110\t  const save = async (extra = {}, { quiet = false } = {}) => {\n   111\t    const seq = ++saveSeq.current\n   112\t    if (!quiet && liveRef.current) setStatus('enregistrement…')\n   113\t    const data = { ...metaRef.current, ...extra, blocks: editor.document, updatedAt: Date.now() }\n   114\t    // Doc à éditeur unique : on REMPLACE, avec retry sur conflit (sha frais) -> l'enregistrement réussit au lieu\n   115\t    // d'échouer en silence. (Le merge multi-éditeur d'un même article reste un chantier à part.)\n   116\t    const task = saveChain.current.then(() => saveJsonWithRetry(path, () => data, { sha: sha.current, tries: 3 }))\n   117\t    saveChain.current = task.catch(() => null)\n   118\t    const res = await task.catch(() => ({ ok: false }))\n   119\t    if (res.ok) {\n   120\t      sha.current = res.sha\n   121\t      // L'index parent doit rester synchronisé même si l'éditeur vient d'être fermé pendant le POST.\n   122\t      onMeta({ id, title: data.title, slug: data.slug, status: data.status })\n   123\t      if (liveRef.current) {\n   124\t        if (seq === saveSeq.current) setStatus('enregistré ✓')\n   125\t      }\n   126\t    } else if (liveRef.current && seq === saveSeq.current) setStatus('erreur')\n   127\t    return res\n   128\t  }\n   129\t  const scheduleSave = (extra = {}) => {\n   130\t    pendingExtra.current = { ...(pendingExtra.current || {}), ...extra }\n   131\t    if (saveTimer.current) clearTimeout(saveTimer.current)\n   132\t    saveTimer.current = setTimeout(() => {\n   133\t      saveTimer.current = null\n   134\t      const patch = pendingExtra.current || {}\n   135\t      pendingExtra.current = null\n   136\t      save(patch)\n   137\t    }, 750)\n   138\t  }\n   139\t  const flushSave = () => {\n   140\t    if (!saveTimer.current) return Promise.resolve()\n   141\t    clearTimeout(saveTimer.current)\n   142\t    saveTimer.current = null\n   143\t    const patch = pendingExtra.current || {}\n   144\t    pendingExtra.current = null\n   145\t    return save(patch, { quiet: true })\n   146\t  }\n   147\t  const onChange = () => { if (ready) scheduleSave() }\n   148\t  const setM = (patch) => {\n   149\t    setMeta((m) => {\n   150\t      const next = { ...m, ...patch }\n   151\t      metaRef.current = next\n   152\t      return next\n   153\t    })\n   154\t    scheduleSave(patch)\n   155\t  }\n   156\t  const exportJson = () => { const data = { ...meta, blocks: editor.document }; const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = (meta.slug || slugify(meta.title)) + '.article.json'; a.click() }\n   157\t  const publish = async () => {\n   158\t    await flushSave()\n   159\t    const slug = meta.slug || slugify(meta.title)\n   160\t    setStatus('publication…')\n   161\t    // On envoie le brouillon COMPLET (mediaRefs inclus) : le serveur résout/promeut les médias privés.\n   162\t    const article = { ...meta, id, slug, blocks: editor.document }\n   163\t    const j = await fetch('/api/publish', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ article }) }).then((r) => r.json()).catch(() => null)\n   164\t    if (j && j.ok) {\n   165\t      const st = j.status || 'published_to_branch' // statut RÉEL renvoyé par le serveur (branche / preview)\n   166\t      setMeta((m) => { const next = { ...m, slug, status: st }; metaRef.current = next; return next })\n   167\t      save({ slug, status: st })\n   168\t      const warn = (j.warnings && j.warnings.length) ? ` (à vérifier : ${j.warnings.join(', ')})` : ''\n   169\t      setStatus(`${st === 'preview' ? 'PR/preview prête' : 'poussé sur branche'} ${j.branch} · ${j.assets} asset(s)${warn} ✓`)\n   170\t      window.open(j.prUrl || j.compareUrl, '_blank')\n   171\t      onPublished && onPublished({ title: meta.title, slug, url: j.liveUrl, branch: j.branch, status: st })\n   172\t    } else if (j && j.error === 'validation') setStatus('publication refusée : ' + (j.errors || []).join(', '))\n   173\t    else setStatus('erreur publish ' + ((j && (j.error || j.detail)) || ''))\n   174\t  }\n   175\t  // « live » seulement quand le fichier est sur master (confirmé via /api/publish status). Jamais avant merge.\n   176\t  const liveUrl = meta.status === 'live' && meta.slug ? liveUrlFor(meta.slug) : null\n   177\t  const isPublished = meta.status && meta.status !== 'draft'\n   178\t  const share = (net) => { const u = encodeURIComponent(liveUrl); const tx = encodeURIComponent(meta.title || ''); window.open(net === 'tw' ? `https://twitter.com/intent/tweet?text=${tx}&url=${u}` : `https://www.linkedin.com/sharing/share-offsite?url=${u}`, '_blank') }\n   179\t  const th = THEMES[meta.theme]\n   180\t  const ratioVal = (RATIOS.find((r) => r[0] === meta.ratio) || [])[2]\n   181\t  const seg = (val, opts, key) => <div style={{ display: 'inline-flex', gap: 2, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: 2 }}>{opts.map(([v, l]) => <button key={v} onClick={() => setM({ [key]: v })} style={{ padding: '3px 9px', borderRadius: 4, border: 'none', cursor: 'pointer', background: val === v ? PALETTE.primarySoft : 'transparent', color: val === v ? PALETTE.primary : t.textSecondary, fontFamily: FONTS.sans, fontSize: 11.5, fontWeight: val === v ? 600 : 500 }}>{l}</button>)}</div>\n   182\t\n   183\t  return (\n   184\t    <>\n   185\t      <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 12, flexWrap: 'wrap' }}>\n   186\t        <button onClick={() => { flushSave(); onBack() }} style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, color: t.textSecondary, cursor: 'pointer', padding: '3px 10px' }}>‹ Articles</button>\n   187\t        {seg(meta.theme, [['dark', 'Dark'], ['grey', 'Grey'], ['white', 'White']], 'theme')}\n   188\t        {seg(meta.font, FONT_OPTS, 'font')}\n   189\t        <button onClick={() => setM({ size: Math.max(13, meta.size - 1) })} style={{ ...mini(t) }}>A−</button>\n   190\t        <span style={{ fontFamily: FONTS.mono, fontSize: 11