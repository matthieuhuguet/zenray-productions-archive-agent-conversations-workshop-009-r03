out\n  2280\t  }\n  2281\t  // Fil d'Ariane IMPERTURBABLE : chaque segment reste toujours cliquable. Les chemins profonds peuvent saturer\n  2282\t  // la largeur — au lieu de couper (overflow hidden) ce qui rendait « Create »/« References » incliquables, on\n  2283\t  // REPLIE les ancêtres intermédiaires dans un menu « … » et on garde TOUJOURS la racine (Create) + les 2 derniers\n  2284\t  // segments visibles et cliquables. Tous les boutons ont une cible de clic nette (pointerEvents auto, z-index).\n  2285\t  const Crumbs = ({ dir, onPick, maxInline = 4 }) => {\n  2286\t    const cs = crumbs(dir)\n  2287\t    // CIBLE DE DROP (2026-07-06, feature demandée : « drag les médias sur le fil d'ariane pour retour en\n  2288\t    // arrière ») : chaque segment accepte un drag interne (application/zenray-page) et route vers moveMany\n  2289\t    // (déjà optimiste + séquentiel + fiable). Le highlight vit dans l'état PARENT (crumbDropPath) : Crumbs\n  2290\t    // est redéfini à chaque rendu, un useState interne serait réinitialisé en plein drag (piège du remount).\n  2291\t    // Le segment COURANT (last) n'est pas une cible : déposer un item dans le dossier où il est déjà n'a\n  2292\t    // aucun sens (moveMany le filtrerait, autant ne pas suggérer visuellement l'impossible).\n  2293\t    const Btn = ({ c, last }) => (\n  2294\t      <button data-crumb-path={last ? undefined : c.path} onMouseDown={(e) => { e.preventDefault(); e.stopPropagation() }} onClick={(e) => { e.stopPropagation(); onPick(c.path) }} className=\"zr-treeitem\"\n  2295\t        onDragOver={last ? undefined : (ev) => { if ([...ev.dataTransfer.types].includes('application/zenray-page')) { ev.preventDefault(); ev.stopPropagation(); ev.dataTransfer.dropEffect = 'move'; setCrumbDropPath(c.path) } }}\n  2296\t        onDragLeave={last ? undefined : () => setCrumbDropPath((p) => p === c.path ? null : p)}\n  2297\t        onDrop={last ? undefined : (ev) => {\n  2298\t          setCrumbDropPath(null)\n  2299\t          const d = ev.dataTransfer.getData('application/zenray-page'); if (!d) return\n  2300\t          ev.preventDefault(); ev.stopPropagation()\n  2301\t          try { const p = JSON.parse(d); const list = p.items ? p.items.map((it) => it.path) : (p.path ? [p.path] : []); if (list.length) moveMany(list, c.path) } catch {}\n  2302\t        }}\n  2303\t        style={{ position: 'relative', zIndex: 1, pointerEvents: 'auto', background: crumbDropPath === c.path && !last ? PALETTE.primarySoft : (last ? PALETTE.primarySoft : 'transparent'), border: 'none', cursor: 'pointer', color: last ? PALETTE.primary : t.textSecondary, fontFamily: FONTS.sans, fontSize: 13.5, fontWeight: last ? 500 : 400, padding: '3px 9px', borderRadius: 999, whiteSpace: 'nowrap', maxWidth: pageMobile ? 104 : 240, minWidth: last ? 28 : 0, overflow: 'hidden', textOverflow: 'ellipsis', flexShrink: last ? 1 : 0, outline: crumbDropPath === c.path && !last ? `2px solid ${PALETTE.primary}` : 'none', transition: 'outline .12s ease, background .12s ease' }}\n  2304\t        onMouseEnter={(e) => { if (!last) e.currentTarget.style.background = PALETTE.primarySoft }} onMouseLeave={(e) => { if (crumbDropPath !== c.path && !last) e.currentTarget.style.background = 'transparent' }}>{c.label}</button>\n  2305\t    )\n  2306\t    const Sep = () => <span style={{ color: t.textSecondary, margin: '0 2px', fontSize: 12, flexShrink: 0 }}>›</span>\n  2307\t    // Repli si trop de segments : Create … [avant-dernier] [dernier]. Sur mobile (maxInline<=1) on ne garde\n  2308\t    // que LE dernier segment après le … (2026-07-06 : l'ancienne queue fixe de 2 segments débordait sur le\n  2309\t    // titre à 375px). overflow:hidden sur la racine : les segments flexShrink:0 ne peuvent PLUS déborder\n  2310\t    // visuellement sur les éléments voisins (le chevauchement de texte du bug d'origine).\n  2311\t    const collapsed = cs.length > maxInline\n  2312\t    const tailN = maxInline <= 1 ? 1 : 2\n  2313\t    const middle = collapsed ? cs.slice(1, cs.length - tailN) : []\n  2314\t    const tail = collapsed ? cs.slice(cs.length - tailN) : cs.slice(1)\n  2315\t    return (\n  2316\t      <div style={{ position: 'relative', zIndex: 2, display: 'flex', alignItems: 'center', gap: 2, width: '100%', minWidth: 0, flexWrap: 'nowrap', border: `1px solid ${t.border}`, borderRadius: 999, padding: '2px 4px', background: t.cardBg, boxSizing: 'border-box' }}>\n  2317\t        {/* Le chemin et son déclencheur sont deux zones flex distinctes : seul le texte peut être rogné.\n  2318\t            Le chevron reste donc toujours visible/cliquable, même quand la toolbar voisine prend de la place. */}\n  2319\t        <div style={{ display: 'flex', alignItems: 'center', gap: 2, minWidth: 0, overflow: 'hidden', flex: 1 }}>\n  2320\t          <Btn c={cs[0]} last={cs.length === 1} />\n  2321\t          {tail.map((c) => (\n  2322\t            <React.Fragment key={c.path}><Sep /><Btn c={c} last={c.path === cs[cs.length - 1].path} /></React.Fragment>\n  2323\t          ))}\n  2324\t          {collapsed && (\n  2325\t            <>\n  2326\t              <Sep />\n  2327\t              {/* Ellipsis passive : le seul contrôle cliquable est la flèche séparée du navigateur As Columns. */}\n  2328\t              <span title={middle.map((c) => c.label).join(' · ')} aria-hidden=\"true\"\n  2329\t                style={{ display: 'inline-flex', alignItems: 'center', justifyContent: 'center', minWidth: 28, height: 24,\n  2330\t                  padding: '0 8px', borderRadius: 999, color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 15,\n  2331\t                  fontWeight: 600, lineHeight: 1, flexShrink: 0 }}>…</span>\n  2332\t            </>\n  2333\t          )}\n  2334\t        </div>\n  2335\t        {/* Navigation Finder macOS en colonnes (2026-07-14, remplace l'ancien DropMenu plat : rendu DANS la\n  2336\t            pilule overflow:hidden, il était fatalement rogné — le « crop »). Le déclencheur ne fait que\n  2337\t            remonter position + contexte à Pages ; le panneau (FinderPathPanel) est rendu par Pages en\n  2338\t            PORTAL document.body : aucun ancêtre ne peut le couper, aucun re-render ne peut le fermer. */}\n  2339\t        <button data-zr-pathmenu-trigger title=\"Parcourir tous les dossiers\" aria-expanded={!!pathMenu}\n  2340\t          onClick={(ev) => {\n  2341\t            if (pathMenu) { setPathMenu(null); return }\n  2342\t            const r = ev.currentTarget.getBoundingClientRect()\n  2343\t            setPathMenu({ top: r.bottom + 8, triggerTop: r.top, left: r.left, right: Math.max(12, window.innerWidth - r.right), dir, onPick })\n  2344\t          }}\n  2345\t          style={{ display: 'inline-flex', alignItems: 'center', padding: '3px 7px', borderRadius: 999, border: 'none',\n  2346\t            background: pathMenu ? PALETTE.primarySoft : 'transparent', color: pathMenu ? PALETTE.primary : t.textSecondary,\n  2347\t            cursor: 'pointer', flexShrink: 0, transition: 'background .12s ease' }}>\n  2348\t          <Icon name=\"chevron.down\" size={11} weight={2} />\n  2349\t        </button>\n  2350\t      </div>\n  4020\t\n  4021\t/* ───────── Menu du fil d'Ariane façon Finder macOS (2026-07-14, demande Matthieu) ─────────\n  4022\t   Navigation en COLONNES : chaque colonne liste les dossiers d'un niveau ; survoler un dossier ouvre\n  4023\t   ses enfants dans la colonne suivante ; cliquer navigue et ferme. La cascade s'ouvre PRÉ-POSITIONNÉE\n  4024\t   sur le chemin courant (on voit immédiatement où on est, coche incluse).\n  4025\t\n  4026\t   POURQUOI UN PORTAL (le « problème fondamental de crop » des tentatives précédentes) : la pilule du\n  4027\t   fil d'Ariane a `overflow:hidden` (anti-débordement des segments) — tout panneau en position:absolute\n  4028\t   À L'INTÉRIEUR est fatalement rogné par elle. Règle transverse §8 de Design1.md : un panneau flottant\n  4029\t   sous un ancêtre à overflow/backdrop-filter/transform se rend via createPortal(document.body) en\n  4030\t   position:fixed, coordonnées mesurées sur le déclencheur -> AUCUN ancêtre ne peut plus le couper. */\n  4031\t// PANNEAU CONTRÔLÉ (état d'ouverture porté par Pages, comme MoveToDialog) — PIÈGE ÉVITÉ, déjà payé une\n  4032\t// fois sur le sous-menu du clic droit : `Crumbs` est une fonction recréée à CHAQUE render de Pages, donc\n  4033\t// tout composant à état monté dessous est démonté/remonté au moindre re-render (notifications, chargements)\n  4034\t// -> un menu qui porte son propre `open` s'y referme tout seul, instantanément. Ici le déclencheur (dans\n  4035\t// Crumbs) ne fait que remonter {top,right,dir,onPick} à Pages ; le panneau vit à un endroit STABLE.\n  4036\tfunction FinderPathPanel({ t, paths, currentFolder, anchor, onPick, onClose }) {\n  4037\t  // Cascade pré-ouverte sur le chemin courant : pages/A/B/C -> colonnes racine, A, B (C visible et coché).\n  4038\t  const [chain, setChain] = useState(() => {\n  4039\t    const segs = (currentFolder || 'pages').split('/')\n  4040\t    const pre = []\n  4041\t    for (let i = 2; i <= segs.length; i++) pre.push(segs.slice(0, i).join('/'))\n  4042\t    return pre\n  4043\t  })\n  4044\t  const [indexPaths, setIndexPaths] = useState(null)\n  4045\t\n  4046\t  // `action=tree` peut être tronqué par GitHub au-delà de ~100k nœuds. L'index CDN est exhaustif : son union\n  4047\t  // avec `paths` garantit que le menu montre réellement TOUS les dossiers, y compris les ajouts tout récents.\n  4048\t  useEffect(() => {\n  4049\t    let live = true\n  4050\t    loadSearchIndex().then((idx) => { if (live && idx && Array.isArray(idx.paths)) setIndexPaths(idx.paths) }).catch(() => {})\n  4051\t    return () => { live = false }\n  4052\t  }, [])\n  4053\t\n  4054\t  // Parent -> sous-dossiers directs, dérivé de l'arbre global déjà en mémoire (zéro réseau).\n  4055\t  const kidsOf = useMemo(() => {\n  4056\t    const dirSet = new Set(['pages'])\n  4057\t    const source = indexPaths ? [...new Set([...(paths || []), ...indexPaths])] : (paths || [])\n  4058\t    for (const p of source) {\n  4059\t      if (!p.startsWith('pages/')) continue\n  4060\t      const parts = p.split('/')\n  4061\t      for (let i = 2; i < parts.length; i++) dirSet.add(parts.slice(0, i).join('/'))\n  4062\t    }\n  4063\t    const m = new Map()\n  4064\t    for (const d of dirSet) {\n  4065\t      if (d === 'pages') continue\n  4066\t      const parent = d.slice(0, d.lastIndexOf('/'))\n  4067\t      if (!m.has(parent)) m.set(parent, [])\n  4068\t      m.get(parent).push(d)\n  4069\t    }\n  4070\t    for (const list of m.values()) list.sort((a, b) => a.localeCompare(b, 'fr', { numeric: true, sensitivity: 'base' }))\n  4071\t    return m\n  4072\t  }, [paths, indexPaths])\n  4073\t\n  4074\t  const COL_W = 238\n  4075\t  const columns = [['pages', kidsOf.get('pages') || []], ...chain.map((d) => [d, kidsOf.get(d) || []])]\n  4076\t    .filter(([, kids]) => kids.length > 0)\n  4077\t\n  4078\t  // Une ligne de colonne, fidèle au Finder : dossier bleu, nom, chevron \">\" si enfants, coche si dossier\n  4079\t  // COURANT, surlignage bleu système plein (texte blanc) pour le fil de la cascade. Survol = ouvre les\n  4080\t  // enfants dans la colonne suivante ; clic = navigue et ferme.\n  4081\t  const Row = ({ d, colIdx }) => {\n  4082\t    const kids = kidsOf.get(d)\n  4083\t    const inChain = chain[colIdx] === d\n  4084\t    const isCurrent = d === currentFolder\n  4085\t    const selected = inChain || isCurrent\n  4086\t    return (\n  4087\t      <ColumnMenuItem\n  4088\t        t={t}\n  4089\t        onClick={() => {\n  4090\t          // Finder macOS : le hover ne change jamais la navigation. Un clic sur un dossier ouvre sa\n  4091\t          // colonne suivante ; un clic sur une feuille navigue et ferme le panneau.\n  4092\t          if (kids && kids.length) { setChain((c) => { const n = c.slice(0, colIdx); n.push(d); return n }); return }\n  4093\t          onClose(); onPick(d)\n  4094\t        }}\n  4095\t        selected={selected}\n  4096\t        current={isCurrent}\n  4097\t        icon={<FolderIcon s={17} empty={false} />}\n  4098\t        trailing={kids && kids.length > 0 ? <Icon name=\"chevron.right\" size={10} weight={2} /> : null}\n  4099\t      >\n  4100\t        {d.split('/').pop()}\n  4101\t      </ColumnMenuItem>\n  4102\t    )\n  4103\t  }\n  4104\t\n  4105\t  return (\n  4106\t    <ColumnMenuShell\n  4107\t      t={t}\n  4108\t      anchor={anchor}\n  4109\t      onClose={onClose}\n  4110\t      ariaLabel=\"Tous les dossiers\"\n  4111\t      columnWidth={COL_W}\n  4112\t      triggerSelector=\"[data-zr-pathmenu-trigger]\"\n  4113\t      columns={columns.map(([parent, kids], colIdx) => (\n  4114\t        <ColumnMenuColumn key={parent} t={t} width={COL_W} index={colIdx} label={parent.split('/').pop()}>\n  4115\t          {kids.map((d) => <Row key={d} d={d} colIdx={colIdx} />)}\n  4116\t        </ColumnMenuColumn>\n  4117\t      ))}\n  4118\t    />\n  4119\t  )\n  4120\t}\n  4121\t\n  4122\t/* ───────── « Déplacer vers… » : picker d'arborescence (2026-07-12, demande Matthieu) ─────────\n  4123\t   Alternative propre au drag-and-drop pour déplacer une sélection : arbre des dossiers du drive\n  4124\t   (dérivé de `paths`, replié par défaut -> seuls les nœuds visibles sont rendus, fluide même avec\n  4125\t   des dizaines de milliers de chemins), création de dossier à la volée (marqueur .zrfolder.json,\n  4126\t   NOM EXACT, collision -> sélectionne l'existant), checkboxes par élément (tout coché par défaut),\n  4127\t   bouton Valider. Le déplacement réel est fait par le PARENT via moveMany (chemin éprouvé du\n  4128\t   drag-and-drop : retrait optimiste, écritures séquentielles retryées, notifications, resynchro). */\n  4129\tfunction MoveToDialog({ t, items, paths, currentFolder, onClose, onCreateFolder, onConfirm }) {\n  4130\t  const [checked, setChecked] = useState(() => new Set(items.map((i) => i.key)))\n  4131\t  const [dest, setDest] = useState(null)\n  4132\t  const [extraDirs, setExtraDirs] = useState([]) // dossiers créés depuis le dialogue (pas encore revenus par loadPaths)\n  4133\t  const [creating, setCreating] = useState(false)\n  4134\t  const [newName, setNewName] = useState('')\n  4135\t  const [busy, setBusy] = useState(false)\n  4136\t  const [createErr, setCreateErr] = useState(null)\n  4137\t  // 2e source de chemins : l'index de recherche v2 (CDN, ~127k chemins). Nécessaire parce que l'arbre git\n  4138\t  // (`paths`, action=tree) est TRONQUÉ par GitHub sur un gros repo (truncated:true observé en réel) : les\n  4139\t  // chemins en fin d'arbre manquent, donc des dossiers entiers manqueraient au picker. L'union des deux\n  4140\t  // sources couvre : index = exhaustif mais en retard de réindexation ; tree = frais mais tronqué.\n     1\timport React, { useEffect, useMemo, useRef } from 'react'\n     2\timport { createPortal } from 'react-dom'\n     3\timport { liquidGlassNormal, PALETTE, TRANSITIONS } from '../theme.js'\n     4\t\n     5\tconst FONT = \"'AnthropicSans', sans-serif\"\n     6\tconst MARGIN = 12\n     7\t\n     8\t/**\n     9\t * Coque unique des navigateurs en colonnes Create.\n    10\t *\n    11\t * Les colonnes sont pilotées par le parent et ne changent jamais au hover :\n    12\t * seul un clic explicite peut ouvrir/remplacer une colonne. Le portail et le\n    13\t * positionnement fixed empêchent tout crop par overflow/backdrop-filter.\n    14\t */\n    15\texport function ColumnMenuShell({\n    16\t  t,\n    17\t  anchor,\n    18\t  columns,\n    19\t  onClose,\n    20\t  ariaLabel = 'Menu',\n    21\t  columnWidth = 238,\n    22\t  maxHeight = 420,\n    23\t  minHeight = 160,\n    24\t  triggerSelector,\n    25\t  className = '',\n    26\t}) {\n    27\t  const ref = useRef(null)\n    28\t  const count = Math.max(1, React.Children.count(columns))\n    29\t\n    30\t  useEffect(() => {\n    31\t    const onPointer = (event) => {\n    32\t      if (ref.current?.contains(event.target)) return\n    33\t      if (triggerSelector && event.target?.closest?.(triggerSelector)) return\n    34\t      onClose?.()\n    35\t    }\n    36\t    const onKey = (event) => { if (event.key === 'Escape') onClose?.() }\n    37\t    document.addEventListener('pointerdown', onPointer)\n    38\t    document.addEventListener('keydown', onKey)\n    39\t    return () => {\n    40\t      document.removeEventListener('pointerdown', onPointer)\n    41\t      document.removeEventListener('keydown', onKey)\n    42\t    }\n    43\t  }, [onClose, triggerSelector])\n    44\t\n    45\t  const layout = useMemo(() => {\n    46\t    const vw = window.innerWidth\n    47\t    const vh = window.innerHeight\n    48\t    const rawLeft = Number(anchor?.left ?? 0)\n    49\t    const desiredWidth = count * columnWidth\n    50\t    const width = Math.max(columnWidth, Math.min(desiredWidth, vw - MARGIN * 2))\n    51\t    const left = Math.max(MARGIN, Math.min(rawLeft, vw - width - MARGIN))\n    52\t    const belowTop = Number(anchor?.top ?? ((anchor?.bottom ?? MARGIN) + 8))\n    53\t    const triggerTop = Number(anchor?.triggerTop ?? anchor?.top ?? MARGIN)\n    54\t    const below = vh - belowTop - MARGIN\n    55\t    const above = triggerTop - MARGIN * 2\n    56\t    const openAbove = below < minHeight && above > below\n    57\t    const height = Math.max(96, Math.min(maxHeight, openAbove ? above : below))\n    58\t    return { left, width, height, openAbove, belowTop, bottom: Math.max(MARGIN, vh - triggerTop + 8) }\n    59\t  }, [anchor, columnWidth, count, maxHeight, minHeight])\n    60\t\n    61\t  return createPortal(\n    62\t    <div\n    63\t      ref={ref}\n    64\t      role=\"menu\"\n    65\t      aria-label={ariaLabel}\n    66\t      className={`zr-liquid-normal ${className}`.trim()}\n    67\t      style={{\n    68\t        position: 'fixed',\n    69\t        left: layout.left,\n    70\t        ...(layout.openAbove ? { bottom: layout.bottom } : { top: layout.belowTop }),\n    71\t        zIndex: 500,\n    72\t        width: layout.width,\n    73\t        maxWidth: `calc(100vw - ${MARGIN * 2}px)`,\n    74\t        height: layout.height,\n    75\t        maxHeight: layout.height,\n    76\t        boxSizing: 'border-box',\n    77\t        overflow: 'hidden',\n    78\t        borderRadius: 22,\n    79\t        ...liquidGlassNormal(t),\n    80\t      }}\n    81\t    >\n    82\t      <div\n    83\t        data-zr-column-scroll\n    84\t        style={{ display: 'flex', width: '100%', height: '100%', overflowX: 'auto', overflowY: 'hidden', scrollbarWidth: 'none' }}\n    85\t      >\n    86\t        {columns}\n    87\t      </div>\n    88\t    </div>,\n    89\t    document.body,\n    90\t  )\n    91\t}\n    92\t\n    93\texport function ColumnMenuColumn({ t, children, width = 238, label, index = 0 }) {\n    94\t  const dark = t?.textPrimary === PALETTE.textPrimaryDark\n    95\t  const divider = dark ? 'rgba(0,0,0,.54)' : 'rgba(60,60,67,.18)'\n    96\t  return (\n    97\t    <div\n    98\t      role=\"group\"\n    99\t      aria-label={label}\n   100\t      style={{\n   101\t        width,\n   102\t        flex: `0 0 ${width}px`,\n   103\t        height: '100%',\n   104\t        overflowY: 'auto',\n   105\t        padding: '8px 7px',\n   106\t        boxSizing: 'border-box',\n   107\t        background: 'transparent',\n   108\t        borderLeft: index > 0 ? `1px solid ${divider}` : 'none',\n   109\t        boxShadow: index > 0 ? 'inset 1px 0 rgba(255,255,255,.12)' : 'none',\n   110\t        display: 'flex',\n   111\t        flexDirection: 'column',\n   112\t        gap: 1,\n   113\t      }}\n   114\t    >\n   115\t      {children}\n   116\t    </div>\n   117\t  )\n   118\t}\n   119\t\n   120\texport function ColumnMenuItem({\n   121\t  t,\n   122\t  children,\n   123\t  icon,\n   124\t  trailing,\n   125\t  selected = false,\n   126\t  current = false,\n   127\t  danger = false,\n   128\t  disabled = false,\n   129\t  onClick,\n   130\t  title,\n   131\t}) {\n   132\t  const dark = t?.textPrimary === PALETTE.textPrimaryDark\n   133\t  const normalText = dark ? 'rgba(255,255,255,.90)' : 'rgba(24,24,27,.88)'\n   134\t  const muted = dark ? 'rgba(255,255,255,.48)' : 'rgba(60,60,67,.54)'\n   135\t  const color = selected ? '#fff' : danger ? PALETTE.red : normalText\n   136\t  return (\n   137\t    <button\n   138\t      type=\"button\"\n   139\t      role=\"menuitem\"\n   140\t      aria-current={current ? 'page' : undefined}\n   141\t      disabled={disabled}\n   142\t      title={title}\n   143\t      onClick={onClick}\n   144\t      style={{\n   145\t        display: 'flex',\n   146\t        alignItems: 'center',\n   147\t        gap: 8,\n   148\t        width: '100%',\n   149\t        minHeight: 30,\n   150\t        padding: '4px 10px',\n   151\t        border: 'none',\n   152\t        borderRadius: 8,\n   153\t        background: selected ? PALETTE.primaryDark : 'transparent',\n   154\t        color,\n   155\t        cursor: disabled ? 'default' : 'pointer',\n   156\t        opacity: disabled ? .45 : 1,\n   157\t        textAlign: 'left',\n   158\t        fontFamily: FONT,\n   159\t        fontSize: 15,\n   160\t        fontWeight: 400,\n   161\t        transition: TRANSITIONS.micro,\n   162\t      }}\n   163\t      onPointerEnter={(event) => { if (!selected && !disabled) event.currentTarget.style.background = dark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.055)' }}\n   164\t      onPointerLeave={(event) => { if (!selected) event.currentTarget.style.background = 'transparent' }}\n   165\t    >\n   166\t      {icon && <span aria-hidden=\"true\" style={{ width: 18, display: 'inline-flex', justifyContent: 'center', flexShrink: 0 }}>{icon}</span>}\n   167\t      <span style={{ minWidth: 0, flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{children}</span>\n   168\t      {trailing && <span aria-hidden=\"true\" style={{ display: 'inline-flex', color: selected ? '#fff' : muted, flexShrink: 0 }}>{trailing}</span>}\n   169\t    </button>\n   170\t  )\n   171\t}\n     1\t{\n     2\t  \"functions\": {\n     3\t    \"api/**\": { \"maxDuration\": 60, \"includeFiles\": \"dist/index.html\" }\n     4\t  },\n     5\t  \"rewrites\": [\n     6\t    { \"source\": \"/watch\", \"destination\": \"/api/share-og?shareType=watch\" },\n     7\t    { \"source\": \"/view\", \"destination\": \"/api/share-og?shareType=view\" },\n     8\t    { \"source\": \"/folder\", \"destination\": \"/api/share-og?shareType=folder\" },\n     9\t    { \"source\": \"/((?!api/|src/|assets/|@|node_modules/|.*\\\\.).*)\", \"destination\": \"/index.html\" }\n    10\t  ],\n    11\t  \"headers\": [\n    12\t    {\n    13\t      \"source\": \"/index.html\",\n    14\t      \"headers\": [\n    15\t        { \"key\": \"Cache-Control\", \"value\": \"no-cache, no-store, must-revalidate\" }\n    16\t      ]\n    17\t    },\n    18\t    {\n    19\t      \"source\": \"/\",\n    20\t      \"headers\": [\n    21\t        { \"key\": \"Cache-Control\", \"value\": \"no-cache, no-store, must-revalidate\" }\n    22\t      ]\n    23\t    },\n    24\t    {\n    25\t      \"source\": \"/assets/(.*)\",\n    26\t      \"headers\": [\n    27\t        { \"key\": \"Cache-Control\", \"value\": \"public, max-age=31536000, immutable\" }\n    28\t      ]\n    29\t    },\n    30\t    {\n    31\t      \"source\": \"/zr-stream-sw.js\",\n    32\t      \"headers\": [\n    33\t        { \"key\": \"Cache-Control\", \"value\": \"no-cache, no-store, must-revalidate\" }\n    34\t      ]\n    35\t    }\n    36\t  ]\n    37\t}\n     1\t// C202 — Streaming d'un média chunké via HTTP Range : le <video>/<audio> demande un intervalle\n     2\t// d'octets, on calcule les chunks qui le couvrent, on va chercher CES chunks sur GitHub (raw),\n     3\t// on renvoie la tranche demandée en 206. Lecture instantanée + seek, zéro préchargement.\n     4\tconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\n     5\tconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n     6\tconst MAX_WINDOW = 4 * 1024 * 1024 // borne la taille d'une réponse (sous le cap réponse Vercel ~4,5 Mo) — plus large = moins d'allers-retours\n     7\t\n     8\timport { parseShard } from './shard-naming.js'\n     9\timport { createDecipheriv } from 'node:crypto'\n    10\timport { loadMediaKey } from './media-key.js'\n    11\tconst OWNER = (REPO.split('/')[0]) || 'matthieuhuguet'\n    12\t// Le chunk d'un média privé vit sur un shard PRIVÉ : legacy zenray-media-NN OU nouveau zenray-img-private-NN\n    13\t// (après le rename par type). parseShard accepte les deux ; on n'autorise que les shards PRIVÉS ici.\n    14\tconst isPrivateShard = (repo) => { const p = parseShard(repo); return !!p && p.vis === 'private' }\n    15\tconst b64d = (s) => Buffer.from(s || '', 'base64').toString('utf8')\n    16\tfunction gh(token, path, accept) {\n    17\t  return fetch(`https://api.github.com/repos/${REPO}/${path}`, {\n    18\t    headers: { Authorization: `Bearer ${token}`, Accept: accept || 'application/vnd.github+json', 'User-Agent': 'zenray-progress' },\n    19\t  })\n    20\t}\n    21\t// QUOTA : les parts .bin sont adressées par contenu (immuables) -> on les lit via raw.githubusercontent.com\n    22\t// (NE COMPTE PAS dans la limite REST 5000/h). Sans ça, chaque seek vidéo/audio chunké tapait l'API contents\n    23\t// (une fenêtre de 4 Mo = plusieurs GET quota) -> lecture de bout en bout = dizaines de requêtes -> 403, lecteur figé.\n    24\t// Le manifest .media.json (1 lecture par ouverture) reste sur l'API contents.\n    25\tfunction rawBin(token, repo, binPath) {\n    26\t  return fetch(`https://raw.githubusercontent.com/${OWNER}/${repo}/${BRANCH}/${encodeURI(binPath)}`, {\n    27\t    headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' },\n    28\t  })\n    29\t}\n    30\t// CHUNK PUBLIC CHIFFRÉ (modèle \"public + chiffré + jsDelivr\") : le ciphertext vit sur un repo PUBLIC, servi par\n    31\t// jsDelivr (CDN, hors quota). On le récupère par son pin de commit (immuable), puis on le déchiffre côté serveur.\n    32\tfunction cdnBin(repo, commit, binPath) {\n    33\t  return fetch(`https://cdn.jsdelivr.net/gh/${OWNER}/${repo}${commit ? '@' + commit : ''}/${encodeURI(binPath)}`)\n    34\t}\n    35\t// AES-256-GCM : le ciphertext WebCrypto = data || tag(16o). Node sépare le tag (setAuthTag) avant de déchiffrer.\n    36\tfunction decryptChunk(ctBuf, ivB64, key) {\n    37\t  const iv = Buffer.from(ivB64 || '', 'base64')\n    38\t  const tag = ctBuf.subarray(ctBuf.length - 16)\n    39\t  const data = ctBuf.subarray(0, ctBuf.length - 16)\n    40\t  const d = createDecipheriv('aes-256-gcm', key, iv)\n    41\t  d.setAuthTag(tag)\n    42\t  return Buffer.concat([d.update(data), d.final()])\n    43\t}\n    44\t\n    45\texport default async function handler(req, res) {\n    46\t  const token = process.env.GITHUB_TOKEN\n    47\t  if (!token) return res.status(500).end()\n    48\t  const path = (req.query.path || '').toString()\n    49\t  if (!path.startsWith('pages/') || !path.endsWith('.media.json') || path.includes('..')) return res.status(400).end()\n    50\t\n    51\t  try {\n    52\t    // 1) manifest\n    53\t    const mr = await gh(token, `contents/${encodeURI(path)}?ref=${BRANCH}`)\n    54\t    if (!mr.ok) return res.status(404).end()\n    55\t    const m = JSON.parse(b64d((await mr.json()).content))\n    56\t    const size = m.size, chunkSize = m.chunkSize, mime = m.mime || 'application/octet-stream'\n    57\t    if (!Number.isFinite(size) || !Number.isFinite(chunkSize)) return res.status(500).end()\n    58\t    // Les chunks vivent dans le repo indiqué par le manifest : shard privé (capture universelle)\n    59\t    // ou zenray-data (ancien pipeline media.js). Validé pour éviter toute injection de repo.\n    60\t    const chunkRepo = (typeof m.repo === 'string' && isPrivateShard(m.repo)) ? m.repo : null\n    61\t    // MÉDIA PUBLIC CHIFFRÉ (audio/PDF/binaire de la capture universelle généralisée) : chunks ciphertext sur un\n    62\t    // repo PUBLIC (cdnRepo) servis par jsDelivr, déchiffrés ICI avec la clé maître. Sans cette branche, l'audio\n    63\t    // et le PDF chiffrés-publics étaient injouables/non ouvrables (régression). On garde le seek par Range : les\n    64\t    // offsets sont en CLAIR (chunkSize = taille du chunk déchiffré), on déchiffre juste les chunks couvrant l'intervalle.\n    65\t    const objectParts = Array.isArray(m.parts) && m.parts.length > 0 && typeof m.parts[0] === 'object'\n    66\t    const isEnc = m.vis === 'public' && m.alg === 'AES-GCM' && (objectParts || (Array.isArray(m.ivs) && typeof m.cdnRepo === 'string'))\n    67\t    const key = isEnc ? Buffer.from(loadMediaKey(), 'base64') : null\n    68\t\n    69\t    // 2) intervalle demandé (Range: bytes=start-end). Sans Range -> fenêtre depuis 0.\n    70\t    const range = req.headers.range\n    71\t    let start = 0, end = size - 1, isRange = false\n    72\t    if (range) {\n    73\t      const mt = /bytes=(\\d*)-(\\d*)/.exec(range)\n    74\t      if (mt) {\n    75\t        isRange = true\n    76\t        if (mt[1]) start = parseInt(mt[1], 10)\n    77\t        if (mt[2]) end = parseInt(mt[2], 10)\n    78\t      }\n    79\t    }\n    80\t    if (start >= size) { res.setHeader('Content-Range', `bytes */${size}`); return res.status(416).end() }\n    81\t    // borne la fenêtre servie (réponse <= MAX_WINDOW) ; le lecteur redemandera la suite\n    82\t    end = Math.min(end, size - 1, start + MAX_WINDOW - 1)\n    83\t\n    84\t    // 3) chunks couvrant [start, end]\n    85\t    const first = Math.floor(start / chunkSize)\n    86\t    const last = Math.floor(end / chunkSize)\n    87\t    const buffers = []\n    88\t    for (let i = first; i <= last; i++) {\n    89\t      const part = m.parts[i]\n    90\t      const binPath = objectParts ? null : m.dir + '/' + part + '.bin'\n    91\t      if (isEnc) {\n    92\t        // ciphertext public via jsDelivr -> déchiffrement avec l'iv du chunk i (manifest.ivs[i]).\n    93\t        const cr = objectParts ? await fetch(part.url) : await cdnBin(m.cdnRepo, m.cdnCommit, binPath)\n    94\t        if (!cr.ok) return res.status(502).end()\n    95\t        try { buffers.push(decryptChunk(Buffer.from(await cr.arrayBuffer()), objectParts ? part.iv : m.ivs[i], key)) }\n    96\t        catch { return res.status(502).end() } // mauvaise clé / tag invalide\n    97\t      } else {\n    98\t        // raw hors quota ; chunkRepo = shard privé indiqué par le manifest, sinon zenray-data (REPO).\n    99\t        const cr = await rawBin(token, chunkRepo || REPO.split('/')[1], binPath)\n   100\t        if (!cr.ok) return res.status(502).end()\n   101\t        buffers.push(Buffer.from(await cr.arrayBuffer()))\n   102\t      }\n   103\t    }\n   104\t    const joined = Buffer.concat(buffers)\n   105\t    // offset du début de `first` dans `joined`, puis tranche exacte [start, end]\n   106\t    const sliceStart = start - first * chunkSize\n   107\t    const sliceEnd = sliceStart + (end - start + 1)\n   108\t    const out = joined.subarray(sliceStart, sliceEnd)\n   109\t\n   110\t    res.setHeader('Content-Type', mime)\n   111\t    res.setHeader('Accept-Ranges', 'bytes')\n   112\t    // Chunks adressés par contenu (parts hashées) -> immuables. Un cache navigateur fini évite\n   113\t    // de retaper GitHub à chaque seek/retour sur la même piste. (Hors index.html : règle anti-écran-blanc.)\n   114\t    res.setHeader('Cache-Control', 'public, max-age=31536000, s-maxage=31536000, immutable')\n   115\t    res.setHeader('Content-Length', String(out.length))\n   116\t    if (isRange || end < size - 1) {\n   117\t      res.setHeader('Content-Range', `bytes ${start}-${end}/${size}`)\n   118\t      return res.status(206).send(out)\n   119\t    }\n   120\t    return res.status(200).send(out)\n   121\t  } catch (e) {\n   122\t    return res.status(500).end()\n   123\t  }\n   124\t}\n     1\t{\n     2\t  \"name\": \"zenray-progress\",\n     3\t  \"private\": true,\n     4\t  \"version\": \"0.1.0\",\n     5\t  \"type\": \"module\",\n     6\t  \"description\": \"ZenRayProgress — LifeOS de Matthieu Huguet : tableau de bord d'objectifs + agenda hebdomadaire, persistant.\",\n     7\t  \"scripts\": {\n     8\t    \"dev\": \"vite\",\n     9\t    \"build\": \"vite build\",\n    10\t    \"preview\": \"vite preview\",\n    11\t    \"test\": \"vitest run\",\n    12\t    \"test:watch\": \"vitest\",\n    13\t    \"test:music\": \"vitest run src/audio src/create --passWithNoTests\",\n    14\t    \"test:e2e\": \"playwright test\",\n    15\t    \"predev\": \"node scripts/copy-ffmpeg-core.mjs\",\n    16\t    \"prebuild\": \"node scripts/copy-ffmpeg-core.mjs\"\n    17\t  },\n    18\t  \"dependencies\": {\n    19\t    \"@blocknote/core\": \"^0.51.3\",\n    20\t    \"@blocknote/mantine\": \"^0.51.3\",\n    21\t    \"@blocknote/react\": \"^0.51.3\",\n    22\t    \"@ffmpeg/core\": \"^0.12.10\",\n    23\t    \"@ffmpeg/ffmpeg\": \"^0.12.15\",\n    24\t    \"@ffmpeg/util\": \"^0.12.2\",\n    25\t    \"@upstash/redis\": \"^1.34.3\",\n    26\t    \"@vercel/analytics\": \"^1.3.1\",\n    27\t    \"dashjs\": \"^4.7.4\",\n    28\t    \"epubjs\": \"^0.3.93\",\n    29\t    \"fflate\": \"^0.8.3\",\n    30\t    \"heic2any\": \"^0.0.4\",\n    31\t    \"hls.js\": \"^1.6.16\",\n    32\t    \"jassub\": \"^1.8.8\",\n    33\t    \"mammoth\": \"^1.12.0\",\n    34\t    \"marked\": \"^14.1.3\",\n    35\t    \"masonic\": \"^4.1.0\",\n    36\t    \"react\": \"^19.2.0\",\n    37\t    \"react-dom\": \"^19.2.0\",\n    38\t    \"three\": \"^0.185.0\",\n    39\t    \"tldraw\": \"^5.0.1\",\n    40\t    \"utif\": \"^3.1.0\",\n    41\t    \"xlsx\": \"^0.18.5\"\n    42\t  },\n    43\t  \"devDependencies\": {\n    44\t    \"@playwright/test\": \"^1.61.1\",\n    45\t    \"@testing-library/jest-dom\": \"^6.9.1\",\n    46\t    \"@testing-library/react\": \"^16.3.2\",\